<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="Annur.AutomativeEngineer_Controller.MonitorProductionQualityView_Controller"
            prefWidth="1100" prefHeight="700">

    <top>
        <HBox spacing="20" alignment="CENTER_LEFT" style="-fx-background-color:#2c3e50;" prefHeight="80">
            <padding><Insets top="15" right="25" bottom="15" left="20"/></padding>
            <Button text="Back" onAction="#handleBack"/>
            <Label text="User 5 - Goal 5: Monitor Production Quality" style="-fx-font-size:24px; -fx-font-weight:bold; -fx-text-fill:white;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label text="Automotive Engineer" style="-fx-text-fill:white;"/>
        </HBox>
    </top>

    <center>
        <VBox spacing="18">
            <padding><Insets top="25" right="25" bottom="25" left="25"/></padding>

            <GridPane hgap="15" vgap="15">
                <Label text="Production Batch" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                <ComboBox fx:id="qualityBatchComboBox" promptText="Select batch" prefWidth="250" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                <Label text="Inspection Date" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                <DatePicker fx:id="qualityDatePicker" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                <Label text="Quality Standard" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                <ComboBox fx:id="qualityStandardComboBox" promptText="Select standard" prefWidth="250" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
            </GridPane>

            <HBox spacing="20">
                <CheckBox fx:id="engineQualityCheckBox" text="Engine"/>
                <CheckBox fx:id="bodyQualityCheckBox" text="Body"/>
                <CheckBox fx:id="paintQualityCheckBox" text="Paint"/>
                <CheckBox fx:id="brakeQualityCheckBox" text="Brakes"/>
                <CheckBox fx:id="safetyQualityCheckBox" text="Safety"/>
            </HBox>

            <TextArea fx:id="qualityNotesArea" promptText="Enter quality monitoring notes..." prefRowCount="4"/>

            <HBox spacing="12">
                <Button text="Analyze Quality" onAction="#handleAnalyzeQuality"/>
                <Button text="Save Report" onAction="#handleSaveQualityReport"/>
                <Button text="Clear" onAction="#handleClear"/>
            </HBox>

            <TitledPane text="Quality Monitoring Results" expanded="true">
                <content>
                    <TableView fx:id="qualityTable" prefHeight="230">
                        <columns>
                            <TableColumn fx:id="batchIdColumn" text="Batch ID" prefWidth="130"/>
                            <TableColumn fx:id="qualityVehicleColumn" text="Vehicle Model" prefWidth="180"/>
                            <TableColumn fx:id="defectRateColumn" text="Defect %" prefWidth="130"/>
                            <TableColumn fx:id="qualityScoreColumn" text="Quality Score" prefWidth="150"/>
                            <TableColumn fx:id="qualityStatusColumn" text="Status" prefWidth="160"/>
                        </columns>
                    </TableView>
                </content>
            </TitledPane>

            <Label fx:id="qualityStatusLabel" text="Ready"/>
        </VBox>
    </center>
</BorderPane>