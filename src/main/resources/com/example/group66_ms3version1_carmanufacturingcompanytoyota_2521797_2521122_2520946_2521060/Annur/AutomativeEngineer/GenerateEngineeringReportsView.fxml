<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controller.AutomotiveEngineerController"
            prefWidth="1100" prefHeight="700">

    <top>
        <HBox spacing="20" alignment="CENTER_LEFT" style="-fx-background-color:#2c3e50;" prefHeight="80">
            <padding><Insets top="15" right="25" bottom="15" left="20"/></padding>
            <Button text="Back" onAction="#handleBack"/>
            <Label text="User 5 - Goal 8: Generate Engineering Reports" style="-fx-font-size:24px; -fx-font-weight:bold; -fx-text-fill:white;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label text="Automotive Engineer" style="-fx-text-fill:white;"/>
        </HBox>
    </top>

    <center>
        <VBox spacing="18">
            <padding><Insets top="25" right="25" bottom="25" left="25"/></padding>

            <GridPane hgap="15" vgap="15">
                <Label text="Report Type" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                <ComboBox fx:id="engineeringReportTypeComboBox" promptText="Select report type" prefWidth="260" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                <Label text="Reporting Period" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                <ComboBox fx:id="engineeringReportPeriodComboBox" promptText="Select period" prefWidth="260" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                <Label text="Report Date" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                <DatePicker fx:id="engineeringReportDatePicker" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
            </GridPane>

            <TextArea fx:id="engineeringReportNotesArea" promptText="Enter report parameters or technical analysis..." prefRowCount="5"/>

            <HBox spacing="12">
                <Button text="Generate Report" onAction="#handleGenerateEngineeringReport"/>
                <Button text="Export PDF" onAction="#handleExportEngineeringPdf"/>
                <Button text="Export Excel" onAction="#handleExportEngineeringExcel"/>
            </HBox>

            <TitledPane text="Generated Engineering Reports" expanded="true">
                <content>
                    <TableView fx:id="engineeringReportTable" prefHeight="230">
                        <columns>
                            <TableColumn fx:id="reportIdColumn" text="Report ID" prefWidth="130"/>
                            <TableColumn fx:id="reportTypeColumn" text="Report Type" prefWidth="220"/>
                            <TableColumn fx:id="reportPeriodColumn" text="Period" prefWidth="170"/>
                            <TableColumn fx:id="reportStatusColumn" text="Status" prefWidth="150"/>
                            <TableColumn fx:id="reportDateColumn" text="Generated Date" prefWidth="180"/>
                        </columns>
                    </TableView>
                </content>
            </TitledPane>

            <Label fx:id="engineeringReportStatusLabel" text="Ready"/>
        </VBox>
    </center>
</BorderPane>