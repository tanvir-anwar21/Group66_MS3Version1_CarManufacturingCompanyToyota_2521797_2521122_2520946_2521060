<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controller.AutomotiveEngineerController"
            prefWidth="1100" prefHeight="700">

    <top>
        <HBox spacing="20" alignment="CENTER_LEFT" style="-fx-background-color:#2c3e50;" prefHeight="80">
            <padding><Insets top="15" right="25" bottom="15" left="20"/></padding>
            <Button text="Back" onAction="#handleBack"/>
            <Label text="User 5 - Goal 3: Analyze Vehicle Performance" style="-fx-font-size:24px; -fx-font-weight:bold; -fx-text-fill:white;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label text="Automotive Engineer" style="-fx-text-fill:white;"/>
        </HBox>
    </top>

    <center>
        <VBox spacing="18">
            <padding><Insets top="25" right="25" bottom="25" left="25"/></padding>

            <GridPane hgap="15" vgap="15">
                <Label text="Vehicle Model" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                <ComboBox fx:id="performanceVehicleComboBox" promptText="Select vehicle" prefWidth="240" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                <Label text="Test Date" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                <DatePicker fx:id="performanceDatePicker" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                <Label text="Test Type" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                <ComboBox fx:id="performanceTestTypeComboBox" promptText="Select test type" prefWidth="240" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

                <Label text="Test Completed" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                <CheckBox fx:id="testCompletedCheckBox" text="Test data verified" GridPane.rowIndex="3" GridPane.columnIndex="1"/>
            </GridPane>

            <TextArea fx:id="performanceDataArea" promptText="Enter engine, fuel efficiency, braking and emission test data..." prefRowCount="5"/>

            <HBox spacing="12">
                <Button text="Analyze" onAction="#handleAnalyzePerformance"/>
                <Button text="Generate Report" onAction="#handleGeneratePerformanceReport"/>
                <Button text="Clear" onAction="#handleClear"/>
            </HBox>

            <TitledPane text="Performance Analysis Results" expanded="true">
                <content>
                    <TableView fx:id="performanceTable" prefHeight="230">
                        <columns>
                            <TableColumn fx:id="performanceVehicleColumn" text="Vehicle" prefWidth="180"/>
                            <TableColumn fx:id="enginePerformanceColumn" text="Engine Score" prefWidth="150"/>
                            <TableColumn fx:id="fuelPerformanceColumn" text="Fuel Efficiency" prefWidth="170"/>
                            <TableColumn fx:id="brakingColumn" text="Braking Score" prefWidth="150"/>
                            <TableColumn fx:id="overallPerformanceColumn" text="Overall Score" prefWidth="150"/>
                        </columns>
                    </TableView>
                </content>
            </TitledPane>

            <Label fx:id="performanceStatusLabel" text="Ready"/>
        </VBox>
    </center>
</BorderPane>
