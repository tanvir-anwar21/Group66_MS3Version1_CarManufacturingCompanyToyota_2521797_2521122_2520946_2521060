<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TitledPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="650.0" prefWidth="1000.0"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="Annur.AutomativeEngineer_Controller.AnalyzeVehiclePerformanceView_Controller">

    <top>
        <HBox spacing="20.0" alignment="CENTER_LEFT"
              prefHeight="80.0"
              style="-fx-background-color: #2c3e50;">
            <padding>
                <Insets top="15.0" right="25.0" bottom="15.0" left="20.0"/>
            </padding>

            <Button text="Back" onAction="#handleBack"/>

            <Label text="User 5 - Goal 3: Analyze Vehicle Performance"
                   style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: white;"/>

            <Region HBox.hgrow="ALWAYS"/>

            <Label text="Automotive Engineer"
                   style="-fx-text-fill: white;"/>
        </HBox>
    </top>

    <center>
        <VBox spacing="18.0">
            <padding>
                <Insets top="25.0" right="25.0" bottom="25.0" left="25.0"/>
            </padding>

            <GridPane hgap="15.0" vgap="15.0">

                <Label text="Vehicle Model"
                       GridPane.rowIndex="0"
                       GridPane.columnIndex="0"/>

                <ComboBox fx:id="performanceVehicleComboBox"
                          promptText="Select vehicle"
                          prefWidth="240.0"
                          GridPane.rowIndex="0"
                          GridPane.columnIndex="1"/>

                <Label text="Test Date"
                       GridPane.rowIndex="1"
                       GridPane.columnIndex="0"/>

                <DatePicker fx:id="performanceDatePicker"
                            GridPane.rowIndex="1"
                            GridPane.columnIndex="1"/>

                <Label text="Test Type"
                       GridPane.rowIndex="2"
                       GridPane.columnIndex="0"/>

                <ComboBox fx:id="performanceTestTypeComboBox"
                          promptText="Select test type"
                          prefWidth="240.0"
                          GridPane.rowIndex="2"
                          GridPane.columnIndex="1"/>

                <Label text="Test Completed"
                       GridPane.rowIndex="3"
                       GridPane.columnIndex="0"/>

                <CheckBox fx:id="testCompletedCheckBox"
                          text="Test data verified"
                          GridPane.rowIndex="3"
                          GridPane.columnIndex="1"/>

            </GridPane>

            <TextArea fx:id="performanceDataArea"
                      promptText="Enter engine, fuel efficiency, braking and emission test data..."
                      prefRowCount="5"
                      wrapText="true"/>

            <HBox spacing="12.0">

                <Button text="Analyze"
                        onAction="#handleAnalyzePerformance"/>

                <Button text="Generate Report"
                        onAction="#handleGeneratePerformanceReport"/>

                <Button text="Clear"
                        onAction="#handleClear"/>

            </HBox>

            <TitledPane text="Performance Analysis Results"
                        expanded="true">

                <content>
                    <TableView fx:id="performanceTable"
                               prefHeight="230.0">

                        <columns>

                            <TableColumn fx:id="performanceVehicleColumn"
                                         text="Vehicle"
                                         prefWidth="180.0"/>

                            <TableColumn fx:id="enginePerformanceColumn"
                                         text="Engine Score"
                                         prefWidth="150.0"/>

                            <TableColumn fx:id="fuelPerformanceColumn"
                                         text="Fuel Efficiency"
                                         prefWidth="170.0"/>

                            <TableColumn fx:id="brakingColumn"
                                         text="Braking Score"
                                         prefWidth="150.0"/>

                            <TableColumn fx:id="overallPerformanceColumn"
                                         text="Overall Score"
                                         prefWidth="150.0"/>

                        </columns>

                    </TableView>
                </content>

            </TitledPane>

            <Label fx:id="performanceStatusLabel"
                   text="Ready"/>

        </VBox>
    </center>

</BorderPane>