<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controller.AutomotiveEngineerController"
            prefWidth="1100" prefHeight="700">

    <top>
        <HBox spacing="20" alignment="CENTER_LEFT" style="-fx-background-color:#2c3e50;" prefHeight="80">
            <padding><Insets top="15" right="25" bottom="15" left="20"/></padding>
            <Button text="Back" onAction="#handleBack"/>
            <Label text="User 5 - Goal 7: Track Engineering Projects" style="-fx-font-size:24px; -fx-font-weight:bold; -fx-text-fill:white;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label text="Automotive Engineer" style="-fx-text-fill:white;"/>
        </HBox>
    </top>

    <center>
        <VBox spacing="18">
            <padding><Insets top="25" right="25" bottom="25" left="25"/></padding>

            <GridPane hgap="15" vgap="15">
                <Label text="Project" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                <ComboBox fx:id="projectComboBox" promptText="Select project" prefWidth="260" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                <Label text="Project Status" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                <ComboBox fx:id="projectStatusComboBox" promptText="Select status" prefWidth="260" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                <Label text="Completion Percentage" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                <Spinner fx:id="completionSpinner" min="0" max="100" initialValue="50" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
            </GridPane>

            <TextArea fx:id="projectNotesArea" promptText="Enter project progress and milestone information..." prefRowCount="5"/>

            <HBox spacing="12">
                <Button text="Load Project" onAction="#handleLoadProject"/>
                <Button text="Update Progress" onAction="#handleUpdateProject"/>
                <Button text="Save Tracking" onAction="#handleSaveProject"/>
            </HBox>

            <TitledPane text="Engineering Project Status" expanded="true">
                <content>
                    <TableView fx:id="projectTable" prefHeight="230">
                        <columns>
                            <TableColumn fx:id="projectIdColumn" text="Project ID" prefWidth="130"/>
                            <TableColumn fx:id="projectNameColumn" text="Project" prefWidth="230"/>
                            <TableColumn fx:id="milestoneColumn" text="Milestone" prefWidth="200"/>
                            <TableColumn fx:id="completionColumn" text="Completion" prefWidth="150"/>
                            <TableColumn fx:id="projectStatusColumn" text="Status" prefWidth="160"/>
                        </columns>
                    </TableView>
                </content>
            </TitledPane>

            <Label fx:id="projectStatusLabel" text="Ready"/>
        </VBox>
    </center>
</BorderPane>