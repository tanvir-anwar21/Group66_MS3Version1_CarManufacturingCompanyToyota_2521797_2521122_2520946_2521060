<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="650.0" prefWidth="900.0"
            xmlns="http://javafx.com/javafx/26"
            xmlns:fx="http://javafx.com/fxml/1">

    <children>

        <VBox spacing="15"
              AnchorPane.topAnchor="15"
              AnchorPane.leftAnchor="15"
              AnchorPane.rightAnchor="15"
              AnchorPane.bottomAnchor="15">

            <padding>
                <Insets top="20" right="20" bottom="20" left="20"/>
            </padding>

            <Label text="Approve Engineering Changes"
                   style="-fx-font-size:22px; -fx-font-weight:bold;"/>

            <Separator/>

            <GridPane hgap="12" vgap="12">

                <columnConstraints>
                    <ColumnConstraints/>
                    <ColumnConstraints hgrow="ALWAYS"/>
                </columnConstraints>

                <rowConstraints>
                    <RowConstraints/>
                    <RowConstraints/>
                    <RowConstraints/>
                </rowConstraints>

                <Label text="Change Request ID"
                       GridPane.columnIndex="0"
                       GridPane.rowIndex="0"/>

                <ComboBox fx:id="changeRequestComboBox"
                          promptText="Select Change Request"
                          prefWidth="280"
                          GridPane.columnIndex="1"
                          GridPane.rowIndex="0"/>

                <Label text="Current Status"
                       GridPane.columnIndex="0"
                       GridPane.rowIndex="1"/>

                <Label fx:id="statusValueLabel"
                       text="Pending"
                       GridPane.columnIndex="1"
                       GridPane.rowIndex="1"/>

                <Button fx:id="loadButton"
                        text="Load Request"
                        onAction="#loadRequest"
                        GridPane.columnIndex="1"
                        GridPane.rowIndex="2"/>

            </GridPane>

            <Separator/>

            <Label text="Engineering Change Details"
                   style="-fx-font-size:16px; -fx-font-weight:bold;"/>

            <TableView fx:id="changeTable" prefHeight="180">

                <columns>

                    <TableColumn fx:id="componentColumn"
                                 text="Component"
                                 prefWidth="160"/>

                    <TableColumn fx:id="oldValueColumn"
                                 text="Current Design"
                                 prefWidth="170"/>

                    <TableColumn fx:id="newValueColumn"
                                 text="Proposed Design"
                                 prefWidth="170"/>

                    <TableColumn fx:id="impactColumn"
                                 text="Impact"
                                 prefWidth="120"/>

                    <TableColumn fx:id="engineerColumn"
                                 text="Requested By"
                                 prefWidth="170"/>

                </columns>

            </TableView>

            <Label text="Review Comments"
                   style="-fx-font-size:16px; -fx-font-weight:bold;"/>

            <TextArea fx:id="reviewCommentArea"
                      prefHeight="120"
                      promptText="Enter engineering review comments..."/>

            <HBox spacing="15">

                <Button fx:id="approveButton"
                        text="Approve"
                        onAction="#approveChange"/>

                <Button fx:id="rejectButton"
                        text="Reject"
                        onAction="#rejectChange"/>

                <Button fx:id="saveButton"
                        text="Save Review"
                        onAction="#saveReview"/>

                <Button fx:id="clearButton"
                        text="Clear"
                        onAction="#clearFields"/>

                <Button fx:id="backButton"
                        text="Back"
                        onAction="#backToDashboard"/>

            </HBox>

            <Label fx:id="statusLabel"
                   text="Select a change request to review."
                   style="-fx-font-weight:bold; -fx-text-fill:green;"/>

        </VBox>

    </children>

</AnchorPane>