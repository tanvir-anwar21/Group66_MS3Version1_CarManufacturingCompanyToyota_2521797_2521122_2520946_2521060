<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controller.AutomotiveEngineerController"
            prefWidth="1100" prefHeight="700">

    <top>
        <HBox spacing="20" alignment="CENTER_LEFT" style="-fx-background-color:#2c3e50;" prefHeight="80">
            <padding><Insets top="15" right="25" bottom="15" left="20"/></padding>
            <Button text="Back" onAction="#handleBack"/>
            <Label text="User 5 - Goal 4: Approve Engineering Changes" style="-fx-font-size:24px; -fx-font-weight:bold; -fx-text-fill:white;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label text="Automotive Engineer" style="-fx-text-fill:white;"/>
        </HBox>
    </top>

    <center>
        <VBox spacing="18">
            <padding><Insets top="25" right="25" bottom="25" left="25"/></padding>

            <GridPane hgap="15" vgap="15">
                <Label text="Change Request" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                <ComboBox fx:id="changeRequestComboBox" promptText="Select request" prefWidth="260" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                <Label text="Vehicle Model" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                <ComboBox fx:id="changeVehicleComboBox" promptText="Select model" prefWidth="260" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                <Label text="Technical Compliance" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                <CheckBox fx:id="technicalComplianceCheckBox" text="Technically compliant" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
            </GridPane>

            <TextArea fx:id="changeReviewArea" promptText="Enter engineering change review details..." prefRowCount="5"/>

            <HBox spacing="12">
                <Button text="Validate Request" onAction="#handleValidateChange"/>
                <Button text="Approve" onAction="#handleApproveChange"/>
                <Button text="Reject" onAction="#handleRejectChange"/>
            </HBox>

            <TitledPane text="Engineering Change Requests" expanded="true">
                <content>
                    <TableView fx:id="changeRequestTable" prefHeight="230">
                        <columns>
                            <TableColumn fx:id="changeIdColumn" text="Request ID" prefWidth="130"/>
                            <TableColumn fx:id="changeVehicleColumn" text="Vehicle" prefWidth="180"/>
                            <TableColumn fx:id="changeDescriptionColumn" text="Change" prefWidth="260"/>
                            <TableColumn fx:id="changeStatusColumn" text="Status" prefWidth="150"/>
                            <TableColumn fx:id="changeDateColumn" text="Date" prefWidth="150"/>
                        </columns>
                    </TableView>
                </content>
            </TitledPane>

            <Label fx:id="changeStatusLabel" text="Ready"/>
        </VBox>
    </center>
</BorderPane>