<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="Annur.AutomativeEngineer_Controller.
            prefWidth="1100" prefHeight="700">

    <top>
        <HBox spacing="20" alignment="CENTER_LEFT" style="-fx-background-color: #2c3e50;" prefHeight="80">
            <padding><Insets top="15" right="25" bottom="15" left="20"/></padding>
            <Button text="Back" onAction="#handleBack"/>
            <Label text="User 5 - Goal 2: Update Vehicle Specifications" style="-fx-font-size:24px; -fx-font-weight:bold; -fx-text-fill:white;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label text="Automotive Engineer" style="-fx-text-fill:white;"/>
        </HBox>
    </top>

    <center>
        <VBox spacing="18">
            <padding><Insets top="25" right="25" bottom="25" left="25"/></padding>

            <GridPane hgap="15" vgap="15">
                <Label text="Vehicle Model" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                <ComboBox fx:id="specVehicleComboBox" promptText="Select model" prefWidth="240" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                <Label text="Engine Power" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                <TextField fx:id="enginePowerField" promptText="Enter engine power" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                <Label text="Fuel Efficiency" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                <TextField fx:id="fuelEfficiencyField" promptText="Enter km/l" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

                <Label text="Seating Capacity" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                <Spinner fx:id="seatingCapacitySpinner" min="2" max="10" initialValue="5" GridPane.rowIndex="3" GridPane.columnIndex="1"/>
            </GridPane>

            <Label text="Updated Specifications" style="-fx-font-weight:bold;"/>
            <TextArea fx:id="updatedSpecificationsArea" promptText="Enter updated technical specifications..." prefRowCount="5"/>

            <HBox spacing="12">
                <Button text="Validate" onAction="#handleValidateSpecifications"/>
                <Button text="Update Specifications" onAction="#handleUpdateSpecifications"/>
                <Button text="Clear" onAction="#handleClear"/>
            </HBox>

            <TitledPane text="Specification History" expanded="true">
                <content>
                    <TableView fx:id="specificationTable" prefHeight="230">
                        <columns>
                            <TableColumn fx:id="specIdColumn" text="Spec ID" prefWidth="120"/>
                            <TableColumn fx:id="specModelColumn" text="Vehicle Model" prefWidth="180"/>
                            <TableColumn fx:id="engineColumn" text="Engine Power" prefWidth="160"/>
                            <TableColumn fx:id="efficiencyColumn" text="Efficiency" prefWidth="160"/>
                            <TableColumn fx:id="updatedDateColumn" text="Updated Date" prefWidth="170"/>
                        </columns>
                    </TableView>
                </content>
            </TitledPane>

            <Label fx:id="specificationStatusLabel" text="Ready"/>
        </VBox>
    </center>
</BorderPane>