<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="Annur.AutomativeEngineer_Controller.ManagePrototypeTestingView_Controller"
            prefWidth="1100" prefHeight="700">

    <top>
        <HBox spacing="20" alignment="CENTER_LEFT" style="-fx-background-color:#2c3e50;" prefHeight="80">
            <padding><Insets top="15" right="25" bottom="15" left="20"/></padding>
            <Button text="Back" onAction="#handleBack"/>
            <Label text="User 5 - Goal 6: Manage Prototype Testing" style="-fx-font-size:24px; -fx-font-weight:bold; -fx-text-fill:white;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label text="Automotive Engineer" style="-fx-text-fill:white;"/>
        </HBox>
    </top>

    <center>
        <VBox spacing="18">
            <padding><Insets top="25" right="25" bottom="25" left="25"/></padding>

            <GridPane hgap="15" vgap="15">
                <Label text="Prototype" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                <ComboBox fx:id="prototypeComboBox" promptText="Select prototype" prefWidth="250" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                <Label text="Test Date" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                <DatePicker fx:id="prototypeDatePicker" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                <Label text="Test Type" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                <ComboBox fx:id="prototypeTestTypeComboBox" promptText="Select test type" prefWidth="250" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
            </GridPane>

            <TextArea fx:id="prototypeResultsArea" promptText="Enter prototype testing results..." prefRowCount="6"/>

            <HBox spacing="12">
                <Button text="Validate Test" onAction="#handleValidatePrototype"/>
                <Button text="Save Results" onAction="#handleSavePrototype"/>
                <Button text="Generate Report" onAction="#handleGeneratePrototypeReport"/>
            </HBox>

            <TitledPane text="Prototype Testing History" expanded="true">
                <content>
                    <TableView fx:id="prototypeTable" prefHeight="230">
                        <columns>
                            <TableColumn fx:id="prototypeIdColumn" text="Prototype ID" prefWidth="140"/>
                            <TableColumn fx:id="prototypeModelColumn" text="Model" prefWidth="180"/>
                            <TableColumn fx:id="prototypeTestColumn" text="Test Type" prefWidth="180"/>
                            <TableColumn fx:id="prototypeResultColumn" text="Result" prefWidth="180"/>
                            <TableColumn fx:id="prototypeDateColumn" text="Date" prefWidth="150"/>
                        </columns>
                    </TableView>
                </content>
            </TitledPane>

            <Label fx:id="prototypeStatusLabel" text="Ready"/>
        </VBox>
    </center>
</BorderPane>