<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="650.0" prefWidth="900.0"
            xmlns="http://javafx.com/javafx/26"
            xmlns:fx="http://javafx.com/fxml/1">

    <children>

        <VBox spacing="15"
              AnchorPane.topAnchor="15"
              AnchorPane.leftAnchor="15"
              AnchorPane.rightAnchor="15"
              AnchorPane.bottomAnchor="15">

            <padding>
                <Insets top="20" right="20" bottom="20" left="20"/>
            </padding>

            <Label text="Automotive Engineer Dashboard"
                   style="-fx-font-size:24px; -fx-font-weight:bold;"/>

            <Separator/>

            <GridPane hgap="15" vgap="15">

                <columnConstraints>
                    <ColumnConstraints percentWidth="50"/>
                    <ColumnConstraints percentWidth="50"/>
                </columnConstraints>

                <rowConstraints>
                    <RowConstraints/>
                    <RowConstraints/>
                    <RowConstraints/>
                    <RowConstraints/>
                </rowConstraints>

                <Button fx:id="vehicleDesignButton"
                        text="Vehicle Design Review"
                        prefWidth="350"
                        prefHeight="45"
                        onAction="#vehicleDesignReview"
                        GridPane.columnIndex="0"
                        GridPane.rowIndex="0"/>

                <Button fx:id="updateSpecificationButton"
                        text="Update Vehicle Specifications"
                        prefWidth="350"
                        prefHeight="45"
                        onAction="#updateSpecifications"
                        GridPane.columnIndex="1"
                        GridPane.rowIndex="0"/>

                <Button fx:id="performanceAnalysisButton"
                        text="Analyze Vehicle Performance"
                        prefWidth="350"
                        prefHeight="45"
                        onAction="#performanceAnalysis"
                        GridPane.columnIndex="0"
                        GridPane.rowIndex="1"/>

                <Button fx:id="engineeringChangeButton"
                        text="Approve Engineering Changes"
                        prefWidth="350"
                        prefHeight="45"
                        onAction="#engineeringChanges"
                        GridPane.columnIndex="1"
                        GridPane.rowIndex="1"/>

                <Button fx:id="qualityMonitoringButton"
                        text="Monitor Production Quality"
                        prefWidth="350"
                        prefHeight="45"
                        onAction="#qualityMonitoring"
                        GridPane.columnIndex="0"
                        GridPane.rowIndex="2"/>

                <Button fx:id="prototypeTestingButton"
                        text="Manage Prototype Testing"
                        prefWidth="350"
                        prefHeight="45"
                        onAction="#prototypeTesting"
                        GridPane.columnIndex="1"
                        GridPane.rowIndex="2"/>

                <Button fx:id="projectTrackingButton"
                        text="Track Engineering Projects"
                        prefWidth="350"
                        prefHeight="45"
                        onAction="#projectTracking"
                        GridPane.columnIndex="0"
                        GridPane.rowIndex="3"/>

                <Button fx:id="engineeringReportButton"
                        text="Generate Engineering Reports"
                        prefWidth="350"
                        prefHeight="45"
                        onAction="#engineeringReports"
                        GridPane.columnIndex="1"
                        GridPane.rowIndex="3"/>

            </GridPane>

            <Separator/>

            <Label text="Dashboard Summary"
                   style="-fx-font-size:18px; -fx-font-weight:bold;"/>

            <HBox spacing="20">

                <VBox spacing="5">
                    <Label text="Active Projects"/>
                    <Label fx:id="activeProjectsLabel" text="0"/>
                </VBox>

                <VBox spacing="5">
                    <Label text="Pending Reviews"/>
                    <Label fx:id="pendingReviewsLabel" text="0"/>
                </VBox>

                <VBox spacing="5">
                    <Label text="Prototype Tests"/>
                    <Label fx:id="prototypeTestsLabel" text="0"/>
                </VBox>

                <VBox spacing="5">
                    <Label text="Quality Score"/>
                    <Label fx:id="qualityScoreLabel" text="0%"/>
                </VBox>

            </HBox>

            <Separator/>

            <HBox spacing="15">

                <Button fx:id="refreshButton"
                        text="Refresh"
                        onAction="#refreshDashboard"/>

                <Button fx:id="logoutButton"
                        text="Logout"
                        onAction="#logout"/>

            </HBox>

            <Label fx:id="statusLabel"
                   text="Welcome Automotive Engineer"
                   style="-fx-font-weight:bold; -fx-text-fill:green;"/>

        </VBox>

    </children>

</AnchorPane>