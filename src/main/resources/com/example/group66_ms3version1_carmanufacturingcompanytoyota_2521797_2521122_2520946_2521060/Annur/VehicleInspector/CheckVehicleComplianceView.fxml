<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>

<AnchorPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="Annur.VehicleInspector_Controller.CheckVehicleComplianceView_Controller"
            prefWidth="1000.0"
            prefHeight="650.0">

    <children>

        <VBox spacing="15.0"
              AnchorPane.topAnchor="15.0"
              AnchorPane.leftAnchor="15.0"
              AnchorPane.rightAnchor="15.0"
              AnchorPane.bottomAnchor="15.0">

            <padding>
                <Insets top="20.0"
                        right="20.0"
                        bottom="20.0"
                        left="20.0"/>
            </padding>

            <Label text="Vehicle Compliance Check"
                   style="-fx-font-size:22px; -fx-font-weight:bold;"/>

            <Separator/>

            <GridPane hgap="12.0"
                      vgap="12.0">

                <columnConstraints>
                    <ColumnConstraints/>
                    <ColumnConstraints hgrow="ALWAYS"/>
                </columnConstraints>

                <rowConstraints>
                    <RowConstraints/>
                    <RowConstraints/>
                    <RowConstraints/>
                </rowConstraints>

                <Label text="Vehicle ID"
                       GridPane.columnIndex="0"
                       GridPane.rowIndex="0"/>

                <ComboBox fx:id="vehicleIdComboBox"
                          promptText="Select Vehicle"
                          prefWidth="280.0"
                          GridPane.columnIndex="1"
                          GridPane.rowIndex="0"/>

                <Label text="Compliance Standard"
                       GridPane.columnIndex="0"
                       GridPane.rowIndex="1"/>

                <ComboBox fx:id="complianceStandardComboBox"
                          promptText="Select Standard"
                          prefWidth="280.0"
                          GridPane.columnIndex="1"
                          GridPane.rowIndex="1"/>

                <Button fx:id="checkComplianceButton"
                        text="Check Compliance"
                        onAction="#checkCompliance"
                        GridPane.columnIndex="1"
                        GridPane.rowIndex="2"/>

            </GridPane>

            <Separator/>

            <Label text="Compliance Results"
                   style="-fx-font-size:16px; -fx-font-weight:bold;"/>

            <TableView fx:id="complianceTable"
                       prefHeight="260.0">

                <columns>

                    <TableColumn fx:id="requirementColumn"
                                 text="Requirement"
                                 prefWidth="220.0"/>

                    <TableColumn fx:id="vehicleValueColumn"
                                 text="Vehicle Value"
                                 prefWidth="170.0"/>

                    <TableColumn fx:id="requiredValueColumn"
                                 text="Required Value"
                                 prefWidth="170.0"/>

                    <TableColumn fx:id="statusColumn"
                                 text="Status"
                                 prefWidth="120.0"/>

                    <TableColumn fx:id="remarksColumn"
                                 text="Remarks"
                                 prefWidth="180.0"/>

                </columns>

            </TableView>

            <Separator/>

            <HBox spacing="15.0">

                <Button fx:id="verifyButton"
                        text="Verify"
                        onAction="#verifyCompliance"/>

                <Button fx:id="generateReportButton"
                        text="Generate Report"
                        onAction="#generateComplianceReport"/>

                <Button fx:id="exportButton"
                        text="Export"
                        onAction="#exportCompliance"/>

                <Button fx:id="clearButton"
                        text="Clear"
                        onAction="#clearFields"/>

                <Button fx:id="backButton"
                        text="Back"
                        onAction="#backToDashboard"/>

            </HBox>

            <Label fx:id="statusLabel"
                   text="Select a vehicle to perform compliance verification."
                   style="-fx-font-weight:bold; -fx-text-fill:green;"/>

        </VBox>

    </children>

</AnchorPane>