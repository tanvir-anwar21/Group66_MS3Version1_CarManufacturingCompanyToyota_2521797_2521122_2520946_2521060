<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="Annur.VehicleInspector_Controller.ApproveVehicleInspectionView_Controller"
            prefWidth="1100" prefHeight="700">

    <top>
        <HBox spacing="20" alignment="CENTER_LEFT" style="-fx-background-color:#2c3e50;" prefHeight="80">
            <padding><Insets top="15" right="25" bottom="15" left="20"/></padding>
            <Button text="Back" onAction="#handleBack"/>
            <Label text="User 6 - Goal 1: Inspect Vehicle Condition" style="-fx-font-size:24px; -fx-font-weight:bold; -fx-text-fill:white;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label text="Vehicle Inspector" style="-fx-text-fill:white;"/>
        </HBox>
    </top>

    <center>
        <VBox spacing="18">
            <padding><Insets top="25" right="25" bottom="25" left="25"/></padding>

            <GridPane hgap="15" vgap="15">
                <Label text="Vehicle ID" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                <TextField fx:id="inspectionVehicleIdField" promptText="Enter vehicle ID" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                <Label text="VIN" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                <TextField fx:id="inspectionVinField" promptText="Enter VIN" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                <Label text="Inspection Date" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                <DatePicker fx:id="inspectionDatePicker" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

                <Label text="Vehicle Condition" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                <ComboBox fx:id="vehicleConditionComboBox" promptText="Select condition" prefWidth="240" GridPane.rowIndex="3" GridPane.columnIndex="1"/>
            </GridPane>

            <HBox spacing="18">
                <CheckBox fx:id="engineInspectionCheckBox" text="Engine"/>
                <CheckBox fx:id="bodyInspectionCheckBox" text="Body"/>
                <CheckBox fx:id="paintInspectionCheckBox" text="Paint"/>
                <CheckBox fx:id="brakeInspectionCheckBox" text="Brakes"/>
                <CheckBox fx:id="safetyInspectionCheckBox" text="Safety"/>
            </HBox>

            <TextArea fx:id="inspectionFindingsArea" promptText="Enter inspection findings..." prefRowCount="5"/>

            <HBox spacing="12">
                <Button text="Validate Vehicle" onAction="#handleValidateVehicle"/>
                <Button text="Save Inspection" onAction="#handleSaveInspection"/>
                <Button text="Clear" onAction="#handleClear"/>
            </HBox>

            <TitledPane text="Inspection Records" expanded="true">
                <content>
                    <TableView fx:id="inspectionTable" prefHeight="230">
                        <columns>
                            <TableColumn fx:id="inspectionIdColumn" text="Inspection ID" prefWidth="140"/>
                            <TableColumn fx:id="vehicleIdColumn" text="Vehicle ID" prefWidth="150"/>
                            <TableColumn fx:id="inspectionConditionColumn" text="Condition" prefWidth="160"/>
                            <TableColumn fx:id="inspectionResultColumn" text="Result" prefWidth="160"/>
                            <TableColumn fx:id="inspectionDateColumn" text="Date" prefWidth="160"/>
                        </columns>
                    </TableView>
                </content>
            </TitledPane>

            <Label fx:id="inspectionStatusLabel" text="Ready"/>
        </VBox>
    </center>
</BorderPane>