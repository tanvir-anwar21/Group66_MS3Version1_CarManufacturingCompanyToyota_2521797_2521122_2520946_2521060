<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>

<AnchorPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="Annur.VehicleInspector_Controller.InspectVehicleConditionView_Controller"
            prefWidth="1000.0"
            prefHeight="650.0">

    <children>

        <VBox spacing="15.0"
              AnchorPane.topAnchor="15.0"
              AnchorPane.leftAnchor="15.0"
              AnchorPane.rightAnchor="15.0"
              AnchorPane.bottomAnchor="15.0">

            <padding>
                <Insets top="20.0" right="20.0" bottom="20.0" left="20.0"/>
            </padding>

            <Label text="New Vehicle Inspection"
                   style="-fx-font-size:22px; -fx-font-weight:bold;"/>

            <Separator/>

            <GridPane hgap="12.0" vgap="12.0">

                <columnConstraints>
                    <ColumnConstraints/>
                    <ColumnConstraints hgrow="ALWAYS"/>
                </columnConstraints>

                <rowConstraints>
                    <RowConstraints/>
                    <RowConstraints/>
                    <RowConstraints/>
                    <RowConstraints/>
                    <RowConstraints/>
                    <RowConstraints/>
                </rowConstraints>

                <Label text="Inspection ID"
                       GridPane.columnIndex="0"
                       GridPane.rowIndex="0"/>

                <TextField fx:id="inspectionIdField"
                           promptText="Inspection ID"
                           GridPane.columnIndex="1"
                           GridPane.rowIndex="0"/>

                <Label text="Vehicle ID"
                       GridPane.columnIndex="0"
                       GridPane.rowIndex="1"/>

                <ComboBox fx:id="vehicleIdComboBox"
                          promptText="Select Vehicle"
                          prefWidth="280.0"
                          GridPane.columnIndex="1"
                          GridPane.rowIndex="1"/>

                <Label text="Inspector"
                       GridPane.columnIndex="0"
                       GridPane.rowIndex="2"/>

                <ComboBox fx:id="inspectorComboBox"
                          promptText="Select Inspector"
                          prefWidth="280.0"
                          GridPane.columnIndex="1"
                          GridPane.rowIndex="2"/>

                <Label text="Inspection Date"
                       GridPane.columnIndex="0"
                       GridPane.rowIndex="3"/>

                <DatePicker fx:id="inspectionDatePicker"
                            GridPane.columnIndex="1"
                            GridPane.rowIndex="3"/>

                <Label text="Inspection Type"
                       GridPane.columnIndex="0"
                       GridPane.rowIndex="4"/>

                <ComboBox fx:id="inspectionTypeComboBox"
                          promptText="Select Type"
                          prefWidth="280.0"
                          GridPane.columnIndex="1"
                          GridPane.rowIndex="4"/>

                <Button fx:id="loadVehicleButton"
                        text="Load Vehicle"
                        onAction="#loadVehicle"
                        GridPane.columnIndex="1"
                        GridPane.rowIndex="5"/>

            </GridPane>

            <Separator/>

            <Label text="Inspection Checklist"
                   style="-fx-font-size:16px; -fx-font-weight:bold;"/>

            <TableView fx:id="inspectionTable"
                       prefHeight="220.0">

                <columns>

                    <TableColumn fx:id="itemColumn"
                                 text="Inspection Item"
                                 prefWidth="220.0"/>

                    <TableColumn fx:id="conditionColumn"
                                 text="Condition"
                                 prefWidth="130.0"/>

                    <TableColumn fx:id="statusColumn"
                                 text="Status"
                                 prefWidth="120.0"/>

                    <TableColumn fx:id="remarksColumn"
                                 text="Remarks"
                                 prefWidth="280.0"/>

                </columns>

            </TableView>

            <Label text="Inspector Remarks"
                   style="-fx-font-size:16px; -fx-font-weight:bold;"/>

            <TextArea fx:id="remarksTextArea"
                      prefHeight="100.0"
                      promptText="Enter inspection remarks..."/>

            <HBox spacing="15.0">

                <Button fx:id="saveButton"
                        text="Save"
                        onAction="#saveInspection"/>

                <Button fx:id="completeButton"
                        text="Complete"
                        onAction="#completeInspection"/>

                <Button fx:id="clearButton"
                        text="Clear"
                        onAction="#clearFields"/>

                <Button fx:id="backButton"
                        text="Back"
                        onAction="#backToDashboard"/>

            </HBox>

            <Label fx:id="statusLabel"
                   text="Ready to create a new inspection."
                   style="-fx-font-weight:bold; -fx-text-fill:green;"/>

        </VBox>

    </children>

</AnchorPane>