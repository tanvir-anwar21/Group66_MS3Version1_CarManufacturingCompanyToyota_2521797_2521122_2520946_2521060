<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>

<AnchorPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="Annur.VehicleInspector_Controller.GenerateInspectionReportView_Controller"
            prefWidth="1000.0"
            prefHeight="650.0">

    <children>

        <VBox spacing="15.0"
              AnchorPane.topAnchor="15.0"
              AnchorPane.leftAnchor="15.0"
              AnchorPane.rightAnchor="15.0"
              AnchorPane.bottomAnchor="15.0">

            <padding>
                <Insets top="20.0"
                        right="20.0"
                        bottom="20.0"
                        left="20.0"/>
            </padding>

            <Label text="Inspection Reports"
                   style="-fx-font-size:22px; -fx-font-weight:bold;"/>

            <Separator/>

            <GridPane hgap="12.0"
                      vgap="12.0">

                <columnConstraints>
                    <ColumnConstraints/>
                    <ColumnConstraints hgrow="ALWAYS"/>
                </columnConstraints>

                <rowConstraints>
                    <RowConstraints/>
                    <RowConstraints/>
                    <RowConstraints/>
                    <RowConstraints/>
                </rowConstraints>

                <Label text="Report Type"
                       GridPane.columnIndex="0"
                       GridPane.rowIndex="0"/>

                <ComboBox fx:id="reportTypeComboBox"
                          promptText="Select Report Type"
                          prefWidth="280.0"
                          GridPane.columnIndex="1"
                          GridPane.rowIndex="0"/>

                <Label text="From Date"
                       GridPane.columnIndex="0"
                       GridPane.rowIndex="1"/>

                <DatePicker fx:id="fromDatePicker"
                            GridPane.columnIndex="1"
                            GridPane.rowIndex="1"/>

                <Label text="To Date"
                       GridPane.columnIndex="0"
                       GridPane.rowIndex="2"/>

                <DatePicker fx:id="toDatePicker"
                            GridPane.columnIndex="1"
                            GridPane.rowIndex="2"/>

                <Button fx:id="searchButton"
                        text="Search Reports"
                        onAction="#searchReports"
                        GridPane.columnIndex="1"
                        GridPane.rowIndex="3"/>

            </GridPane>

            <Separator/>

            <Label text="Inspection Report List"
                   style="-fx-font-size:16px; -fx-font-weight:bold;"/>

            <TableView fx:id="reportTable"
                       prefHeight="260.0">

                <columns>

                    <TableColumn fx:id="reportIdColumn"
                                 text="Report ID"
                                 prefWidth="100.0"/>

                    <TableColumn fx:id="inspectionIdColumn"
                                 text="Inspection ID"
                                 prefWidth="120.0"/>

                    <TableColumn fx:id="vehicleColumn"
                                 text="Vehicle"
                                 prefWidth="180.0"/>

                    <TableColumn fx:id="inspectorColumn"
                                 text="Inspector"
                                 prefWidth="150.0"/>

                    <TableColumn fx:id="resultColumn"
                                 text="Result"
                                 prefWidth="110.0"/>

                    <TableColumn fx:id="dateColumn"
                                 text="Date"
                                 prefWidth="140.0"/>

                </columns>

            </TableView>

            <Separator/>

            <HBox spacing="15.0">

                <Button fx:id="generateButton"
                        text="Generate"
                        onAction="#generateReport"/>

                <Button fx:id="exportPdfButton"
                        text="Export PDF"
                        onAction="#exportPdf"/>

                <Button fx:id="printButton"
                        text="Print"
                        onAction="#printReport"/>

                <Button fx:id="clearButton"
                        text="Clear"
                        onAction="#clearFields"/>

                <Button fx:id="backButton"
                        text="Back"
                        onAction="#backToDashboard"/>

            </HBox>

            <Label fx:id="statusLabel"
                   text="Select report criteria."
                   style="-fx-font-weight:bold; -fx-text-fill:green;"/>

        </VBox>

    </children>

</AnchorPane>