<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="650.0" prefWidth="900.0"
            xmlns="http://javafx.com/javafx/26"
            xmlns:fx="http://javafx.com/fxml/1">

    <children>

        <VBox spacing="15"
              AnchorPane.topAnchor="15"
              AnchorPane.leftAnchor="15"
              AnchorPane.rightAnchor="15"
              AnchorPane.bottomAnchor="15">

            <padding>
                <Insets top="20" right="20" bottom="20" left="20"/>
            </padding>

            <Label text="Vehicle Safety Inspection"
                   style="-fx-font-size:22px; -fx-font-weight:bold;"/>

            <Separator/>

            <GridPane hgap="12" vgap="12">

                <columnConstraints>
                    <ColumnConstraints/>
                    <ColumnConstraints hgrow="ALWAYS"/>
                </columnConstraints>

                <rowConstraints>
                    <RowConstraints/>
                    <RowConstraints/>
                    <RowConstraints/>
                    <RowConstraints/>
                </rowConstraints>

                <Label text="Vehicle ID"
                       GridPane.columnIndex="0"
                       GridPane.rowIndex="0"/>

                <ComboBox fx:id="vehicleIdComboBox"
                          promptText="Select Vehicle"
                          prefWidth="280"
                          GridPane.columnIndex="1"
                          GridPane.rowIndex="0"/>

                <Label text="Inspection Category"
                       GridPane.columnIndex="0"
                       GridPane.rowIndex="1"/>

                <ComboBox fx:id="inspectionCategoryComboBox"
                          promptText="Safety Inspection"
                          prefWidth="280"
                          GridPane.columnIndex="1"
                          GridPane.rowIndex="1"/>

                <Button fx:id="loadInspectionButton"
                        text="Load Vehicle"
                        onAction="#loadVehicle"
                        GridPane.columnIndex="1"
                        GridPane.rowIndex="2"/>

            </GridPane>

            <Separator/>

            <Label text="Safety Checklist"
                   style="-fx-font-size:16px; -fx-font-weight:bold;"/>

            <GridPane hgap="25" vgap="10">

                <CheckBox fx:id="brakeCheckBox"
                          text="Brake System"
                          GridPane.columnIndex="0"
                          GridPane.rowIndex="0"/>

                <CheckBox fx:id="airbagCheckBox"
                          text="Airbags"
                          GridPane.columnIndex="1"
                          GridPane.rowIndex="0"/>

                <CheckBox fx:id="seatbeltCheckBox"
                          text="Seat Belts"
                          GridPane.columnIndex="0"
                          GridPane.rowIndex="1"/>

                <CheckBox fx:id="headlightCheckBox"
                          text="Headlights"
                          GridPane.columnIndex="1"
                          GridPane.rowIndex="1"/>

                <CheckBox fx:id="indicatorCheckBox"
                          text="Indicators"
                          GridPane.columnIndex="0"
                          GridPane.rowIndex="2"/>

                <CheckBox fx:id="tireCheckBox"
                          text="Tires"
                          GridPane.columnIndex="1"
                          GridPane.rowIndex="2"/>

                <CheckBox fx:id="hornCheckBox"
                          text="Horn"
                          GridPane.columnIndex="0"
                          GridPane.rowIndex="3"/>

                <CheckBox fx:id="mirrorCheckBox"
                          text="Mirrors"
                          GridPane.columnIndex="1"
                          GridPane.rowIndex="3"/>

                <CheckBox fx:id="emergencyBrakeCheckBox"
                          text="Emergency Brake"
                          GridPane.columnIndex="0"
                          GridPane.rowIndex="4"/>

                <CheckBox fx:id="windshieldCheckBox"
                          text="Windshield"
                          GridPane.columnIndex="1"
                          GridPane.rowIndex="4"/>

            </GridPane>

            <Separator/>

            <Label text="Inspector Remarks"
                   style="-fx-font-size:16px; -fx-font-weight:bold;"/>

            <TextArea fx:id="remarksTextArea"
                      prefHeight="140"
                      promptText="Enter safety inspection remarks..."/>

            <HBox spacing="15">

                <Button fx:id="passButton"
                        text="Pass"
                        onAction="#passInspection"/>

                <Button fx:id="failButton"
                        text="Fail"
                        onAction="#failInspection"/>

                <Button fx:id="saveButton"
                        text="Save"
                        onAction="#saveInspection"/>

                <Button fx:id="clearButton"
                        text="Clear"
                        onAction="#clearFields"/>

                <Button fx:id="backButton"
                        text="Back"
                        onAction="#backToDashboard"/>

            </HBox>

            <Label fx:id="statusLabel"
                   text="Complete the safety inspection checklist."
                   style="-fx-font-weight:bold; -fx-text-fill:green;"/>

        </VBox>

    </children>

</AnchorPane>