<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="650.0" prefWidth="900.0"
            xmlns="http://javafx.com/javafx/26"
            xmlns:fx="http://javafx.com/fxml/1">

    <children>

        <VBox spacing="15"
              AnchorPane.topAnchor="15"
              AnchorPane.leftAnchor="15"
              AnchorPane.rightAnchor="15"
              AnchorPane.bottomAnchor="15">

            <padding>
                <Insets top="20" right="20" bottom="20" left="20"/>
            </padding>

            <Label text="Vehicle Inspector Dashboard"
                   style="-fx-font-size:24px; -fx-font-weight:bold;"/>

            <Separator/>

            <GridPane hgap="15" vgap="15">

                <columnConstraints>
                    <ColumnConstraints percentWidth="50"/>
                    <ColumnConstraints percentWidth="50"/>
                </columnConstraints>

                <rowConstraints>
                    <RowConstraints/>
                    <RowConstraints/>
                    <RowConstraints/>
                    <RowConstraints/>
                </rowConstraints>

                <Button fx:id="newInspectionButton"
                        text="New Inspection"
                        prefWidth="340"
                        prefHeight="45"
                        onAction="#openNewInspection"
                        GridPane.columnIndex="0"
                        GridPane.rowIndex="0"/>

                <Button fx:id="safetyInspectionButton"
                        text="Safety Inspection"
                        prefWidth="340"
                        prefHeight="45"
                        onAction="#openSafetyInspection"
                        GridPane.columnIndex="1"
                        GridPane.rowIndex="0"/>

                <Button fx:id="inspectionApprovalButton"
                        text="Inspection Approval"
                        prefWidth="340"
                        prefHeight="45"
                        onAction="#openInspectionApproval"
                        GridPane.columnIndex="0"
                        GridPane.rowIndex="1"/>

                <Button fx:id="inspectionReportButton"
                        text="Inspection Reports"
                        prefWidth="340"
                        prefHeight="45"
                        onAction="#openInspectionReports"
                        GridPane.columnIndex="1"
                        GridPane.rowIndex="1"/>

                <Button fx:id="complianceButton"
                        text="Compliance Check"
                        prefWidth="340"
                        prefHeight="45"
                        onAction="#openComplianceCheck"
                        GridPane.columnIndex="0"
                        GridPane.rowIndex="2"/>

                <Button fx:id="historyButton"
                        text="Inspection History"
                        prefWidth="340"
                        prefHeight="45"
                        onAction="#openInspectionHistory"
                        GridPane.columnIndex="1"
                        GridPane.rowIndex="2"/>

                <Button fx:id="defectButton"
                        text="Defect Reports"
                        prefWidth="340"
                        prefHeight="45"
                        onAction="#openDefectReports"
                        GridPane.columnIndex="0"
                        GridPane.rowIndex="3"/>

                <Button fx:id="reInspectionButton"
                        text="Re-Inspection Schedule"
                        prefWidth="340"
                        prefHeight="45"
                        onAction="#openReInspection"
                        GridPane.columnIndex="1"
                        GridPane.rowIndex="3"/>

            </GridPane>

            <Separator/>

            <Label text="Inspection Summary"
                   style="-fx-font-size:18px; -fx-font-weight:bold;"/>

            <HBox spacing="25">

                <VBox spacing="5">
                    <Label text="Today's Inspections"/>
                    <Label fx:id="todayInspectionLabel" text="0"/>
                </VBox>

                <VBox spacing="5">
                    <Label text="Passed"/>
                    <Label fx:id="passedLabel" text="0"/>
                </VBox>

                <VBox spacing="5">
                    <Label text="Failed"/>
                    <Label fx:id="failedLabel" text="0"/>
                </VBox>

                <VBox spacing="5">
                    <Label text="Pending"/>
                    <Label fx:id="pendingLabel" text="0"/>
                </VBox>

            </HBox>

            <Separator/>

            <HBox spacing="15">

                <Button fx:id="refreshButton"
                        text="Refresh"
                        onAction="#refreshDashboard"/>

                <Button fx:id="logoutButton"
                        text="Logout"
                        onAction="#logout"/>

            </HBox>

            <Label fx:id="statusLabel"
                   text="Welcome Vehicle Inspector"
                   style="-fx-font-weight:bold; -fx-text-fill:green;"/>

        </VBox>

    </children>

</AnchorPane>