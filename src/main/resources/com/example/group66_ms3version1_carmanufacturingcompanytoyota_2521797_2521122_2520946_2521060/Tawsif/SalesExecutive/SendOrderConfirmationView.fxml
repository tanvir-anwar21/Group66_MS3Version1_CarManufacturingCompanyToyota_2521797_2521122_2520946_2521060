<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="Tawsif.SalesExecutiveControllers.SendOrderConfirmation_Controller"
            prefWidth="900.0"
            prefHeight="650.0">

    <children>

        <VBox spacing="15"
              AnchorPane.topAnchor="15"
              AnchorPane.bottomAnchor="15"
              AnchorPane.leftAnchor="15"
              AnchorPane.rightAnchor="15">

            <padding>
                <Insets top="20" right="20" bottom="20" left="20"/>
            </padding>
            <Button mnemonicParsing="false" onAction="#handleBackToSalesExecutiveDashboard" text="Back to Sales Executive Dashboard" />

            <Label text="Send Order Confirmation"
                   style="-fx-font-size:22px; -fx-font-weight:bold;"/>

            <Separator/>

            <HBox spacing="10">

                <Label text="Order ID"/>

                <TextField fx:id="orderIdField"
                           promptText="Enter Order ID"/>

                <Button fx:id="searchButton"
                        text="Search"/>

            </HBox>

            <Separator/>

            <GridPane hgap="12" vgap="12">

                <Label text="Customer Name"
                       GridPane.rowIndex="0"
                       GridPane.columnIndex="0"/>

                <TextField fx:id="customerNameField"
                           editable="false"
                           GridPane.rowIndex="0"
                           GridPane.columnIndex="1"/>

                <Label text="Email"
                       GridPane.rowIndex="1"
                       GridPane.columnIndex="0"/>

                <TextField fx:id="emailField"
                           editable="false"
                           GridPane.rowIndex="1"
                           GridPane.columnIndex="1"/>

                <Label text="Phone Number"
                       GridPane.rowIndex="2"
                       GridPane.columnIndex="0"/>

                <TextField fx:id="phoneField"
                           editable="false"
                           GridPane.rowIndex="2"
                           GridPane.columnIndex="1"/>

            </GridPane>

            <Separator/>

            <Label text="Notification Method"/>

            <HBox spacing="20">

                <RadioButton fx:id="emailRadioButton"
                             text="Email"/>

                <RadioButton fx:id="smsRadioButton"
                             text="SMS"/>

            </HBox>

            <Label text="Message Preview"/>

            <TextArea fx:id="messageTextArea"
                      prefHeight="180"
                      promptText="Confirmation message will appear here."/>

            <HBox spacing="15">

                <Button fx:id="previewButton"
                        text="Preview"/>

                <Button fx:id="sendButton"
                        text="Send"/>

                <Button fx:id="clearButton"
                        text="Clear"/>

            </HBox>

            <Label fx:id="statusLabel"
                   text="Search an order to send confirmation."
                   style="-fx-text-fill:green; -fx-font-weight:bold;"/>

        </VBox>

    </children>

</AnchorPane>