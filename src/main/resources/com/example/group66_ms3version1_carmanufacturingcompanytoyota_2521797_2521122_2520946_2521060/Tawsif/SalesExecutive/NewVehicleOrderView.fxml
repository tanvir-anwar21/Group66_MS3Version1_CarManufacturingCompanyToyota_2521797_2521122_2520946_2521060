<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane prefHeight="700.0"
            prefWidth="1000.0"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="Tawsif.SalesExecutiveControllers.NewVehicleOrder_Controller">

    <children>

        <VBox spacing="15.0"
              AnchorPane.topAnchor="15.0"
              AnchorPane.bottomAnchor="15.0"
              AnchorPane.leftAnchor="15.0"
              AnchorPane.rightAnchor="15.0">

            <padding>
                <Insets top="20" right="20" bottom="20" left="20"/>
            </padding>

            <Label text="New Vehicle Order"
                   style="-fx-font-size:22px; -fx-font-weight:bold;"/>

            <Separator/>

            <Label text="Customer Information"
                   style="-fx-font-size:16px; -fx-font-weight:bold;"/>

            <GridPane hgap="10" vgap="10">

                <columnConstraints>
                    <ColumnConstraints/>
                    <ColumnConstraints/>
                </columnConstraints>

                <rowConstraints>
                    <RowConstraints/>
                    <RowConstraints/>
                    <RowConstraints/>
                    <RowConstraints/>
                    <RowConstraints/>
                </rowConstraints>

                <Label text="Customer ID"
                       GridPane.rowIndex="0"
                       GridPane.columnIndex="0"/>

                <TextField fx:id="customerIdField"
                           promptText="Customer ID"
                           GridPane.rowIndex="0"
                           GridPane.columnIndex="1"/>

                <Label text="Customer Name"
                       GridPane.rowIndex="1"
                       GridPane.columnIndex="0"/>

                <TextField fx:id="customerNameField"
                           promptText="Customer Name"
                           GridPane.rowIndex="1"
                           GridPane.columnIndex="1"/>

                <Label text="Phone"
                       GridPane.rowIndex="2"
                       GridPane.columnIndex="0"/>

                <TextField fx:id="phoneField"
                           promptText="Phone Number"
                           GridPane.rowIndex="2"
                           GridPane.columnIndex="1"/>

                <Label text="Email"
                       GridPane.rowIndex="3"
                       GridPane.columnIndex="0"/>

                <TextField fx:id="emailField"
                           promptText="Email"
                           GridPane.rowIndex="3"
                           GridPane.columnIndex="1"/>

                <Label text="Address"
                       GridPane.rowIndex="4"
                       GridPane.columnIndex="0"/>

                <TextField fx:id="addressField"
                           promptText="Address"
                           GridPane.rowIndex="4"
                           GridPane.columnIndex="1"/>

            </GridPane>

            <Separator/>

            <Label text="Vehicle Information"
                   style="-fx-font-size:16px; -fx-font-weight:bold;"/>

            <GridPane hgap="10" vgap="10">

                <columnConstraints>
                    <ColumnConstraints/>
                    <ColumnConstraints/>
                </columnConstraints>

                <rowConstraints>
                    <RowConstraints/>
                    <RowConstraints/>
                    <RowConstraints/>
                    <RowConstraints/>
                    <RowConstraints/>
                </rowConstraints>

                <Label text="Vehicle Model"
                       GridPane.rowIndex="0"
                       GridPane.columnIndex="0"/>

                <ComboBox fx:id="vehicleModelComboBox"
                          prefWidth="200"
                          GridPane.rowIndex="0"
                          GridPane.columnIndex="1"/>

                <Label text="Color"
                       GridPane.rowIndex="1"
                       GridPane.columnIndex="0"/>

                <ComboBox fx:id="colorComboBox"
                          prefWidth="200"
                          GridPane.rowIndex="1"
                          GridPane.columnIndex="1"/>

                <Label text="Transmission"
                       GridPane.rowIndex="2"
                       GridPane.columnIndex="0"/>

                <ComboBox fx:id="transmissionComboBox"
                          prefWidth="200"
                          GridPane.rowIndex="2"
                          GridPane.columnIndex="1"/>

                <Label text="Quantity"
                       GridPane.rowIndex="3"
                       GridPane.columnIndex="0"/>

                <Spinner fx:id="quantitySpinner"
                         prefWidth="120"
                         GridPane.rowIndex="3"
                         GridPane.columnIndex="1"/>

                <Label text="Delivery Date"
                       GridPane.rowIndex="4"
                       GridPane.columnIndex="0"/>

                <DatePicker fx:id="deliveryDatePicker"
                            GridPane.rowIndex="4"
                            GridPane.columnIndex="1"/>

            </GridPane>

            <Separator/>

            <HBox spacing="15">

                <Button fx:id="calculatePriceButton"
                        text="Calculate Price"
                        onAction="#handleCalculatePrice"/>

                <Label text="Total Price:"/>

                <Label fx:id="totalPriceLabel"
                       text="0.00"/>

            </HBox>

            <HBox spacing="15">

                <Button fx:id="confirmOrderButton"
                        text="Confirm Order"
                        onAction="#handleConfirmOrder"/>

                <Button fx:id="clearButton"
                        text="Clear"
                        onAction="#handleClear"/>

            </HBox>

            <TableView fx:id="orderTableView"
                       prefHeight="220"
                       prefWidth="850">

                <columns>

                    <TableColumn fx:id="orderIdColumn"
                                 text="Order ID"
                                 prefWidth="90"/>

                    <TableColumn fx:id="customerColumn"
                                 text="Customer"
                                 prefWidth="170"/>

                    <TableColumn fx:id="vehicleColumn"
                                 text="Vehicle"
                                 prefWidth="150"/>

                    <TableColumn fx:id="colorColumn"
                                 text="Color"
                                 prefWidth="90"/>

                    <TableColumn fx:id="quantityColumn"
                                 text="Quantity"
                                 prefWidth="90"/>

                    <TableColumn fx:id="priceColumn"
                                 text="Price"
                                 prefWidth="120"/>

                    <TableColumn fx:id="deliveryColumn"
                                 text="Delivery Date"
                                 prefWidth="140"/>

                </columns>

            </TableView>

            <Label fx:id="statusLabel"
                   text="Ready"
                   style="-fx-text-fill: green; -fx-font-weight: bold;"/>

        </VBox>

    </children>

</AnchorPane>