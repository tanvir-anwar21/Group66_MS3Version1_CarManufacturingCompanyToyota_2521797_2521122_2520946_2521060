<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            prefWidth="1000.0"
            prefHeight="700.0">

    <children>

        <VBox spacing="15"
              AnchorPane.topAnchor="15"
              AnchorPane.bottomAnchor="15"
              AnchorPane.leftAnchor="15"
              AnchorPane.rightAnchor="15">

            <padding>
                <Insets top="20" right="20" bottom="20" left="20"/>
            </padding>

            <Label text="Customer Management"
                   style="-fx-font-size:22px; -fx-font-weight:bold;"/>

            <Separator/>

            <GridPane hgap="10" vgap="10">

                <Label text="Customer ID"
                       GridPane.rowIndex="0"
                       GridPane.columnIndex="0"/>

                <TextField fx:id="customerIdField"
                           promptText="Enter Customer ID"
                           GridPane.rowIndex="0"
                           GridPane.columnIndex="1"/>

                <Label text="Customer Name"
                       GridPane.rowIndex="0"
                       GridPane.columnIndex="2"/>

                <TextField fx:id="customerNameField"
                           promptText="Enter Customer Name"
                           GridPane.rowIndex="0"
                           GridPane.columnIndex="3"/>

            </GridPane>

            <HBox spacing="15">

                <Button fx:id="searchButton"
                        text="Search"/>

                <Button fx:id="viewButton"
                        text="View Details"/>

                <Button fx:id="clearButton"
                        text="Clear"/>

            </HBox>

            <Separator/>

            <TableView fx:id="customerTableView" prefHeight="320">

                <columns>

                    <TableColumn fx:id="customerIdColumn"
                                 text="Customer ID"
                                 prefWidth="100"/>

                    <TableColumn fx:id="nameColumn"
                                 text="Name"
                                 prefWidth="180"/>

                    <TableColumn fx:id="phoneColumn"
                                 text="Phone"
                                 prefWidth="140"/>

                    <TableColumn fx:id="emailColumn"
                                 text="Email"
                                 prefWidth="200"/>

                    <TableColumn fx:id="ordersColumn"
                                 text="Orders"
                                 prefWidth="90"/>

                    <TableColumn fx:id="statusColumn"
                                 text="Status"
                                 prefWidth="120"/>

                </columns>

            </TableView>

            <Separator/>

            <Label text="Customer Details"
                   style="-fx-font-size:16px; -fx-font-weight:bold;"/>

            <GridPane hgap="10" vgap="10">

                <Label text="Address"
                       GridPane.rowIndex="0"
                       GridPane.columnIndex="0"/>

                <TextField fx:id="addressField"
                           editable="false"
                           GridPane.rowIndex="0"
                           GridPane.columnIndex="1"/>

                <Label text="Last Purchase"
                       GridPane.rowIndex="1"
                       GridPane.columnIndex="0"/>

                <TextField fx:id="lastPurchaseField"
                           editable="false"
                           GridPane.rowIndex="1"
                           GridPane.columnIndex="1"/>

            </GridPane>

            <Label fx:id="statusLabel"
                   text="Search for a customer."
                   style="-fx-text-fill:green; -fx-font-weight:bold;"/>

        </VBox>

    </children>

</AnchorPane>