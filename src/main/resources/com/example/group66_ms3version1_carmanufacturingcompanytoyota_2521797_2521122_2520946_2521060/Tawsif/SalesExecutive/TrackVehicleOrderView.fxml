<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="Tawsif.SalesExecutiveControllers.TrackVehicleOrder_Controller"
            prefWidth="900.0"
            prefHeight="650.0">

    <children>

        <VBox spacing="15"
              AnchorPane.topAnchor="15"
              AnchorPane.bottomAnchor="15"
              AnchorPane.leftAnchor="15"
              AnchorPane.rightAnchor="15">

            <padding>
                <Insets top="20" right="20" bottom="20" left="20"/>
            </padding>

            <Label text="Track Vehicle Order"
                   style="-fx-font-size:22px; -fx-font-weight:bold;"/>

            <Separator/>

            <HBox spacing="10">

                <Label text="Order ID"/>

                <TextField fx:id="orderIdField"
                           promptText="Enter Order ID"/>

                <Button fx:id="searchButton"
                        text="Track Order"/>

            </HBox>

            <Separator/>

            <GridPane hgap="12" vgap="12">

                <Label text="Customer Name"
                       GridPane.rowIndex="0"
                       GridPane.columnIndex="0"/>

                <TextField fx:id="customerField"
                           editable="false"
                           GridPane.rowIndex="0"
                           GridPane.columnIndex="1"/>

                <Label text="Vehicle Model"
                       GridPane.rowIndex="1"
                       GridPane.columnIndex="0"/>

                <TextField fx:id="vehicleField"
                           editable="false"
                           GridPane.rowIndex="1"
                           GridPane.columnIndex="1"/>

                <Label text="Current Status"
                       GridPane.rowIndex="2"
                       GridPane.columnIndex="0"/>

                <TextField fx:id="statusField"
                           editable="false"
                           GridPane.rowIndex="2"
                           GridPane.columnIndex="1"/>

                <Label text="Estimated Delivery"
                       GridPane.rowIndex="3"
                       GridPane.columnIndex="0"/>

                <DatePicker fx:id="deliveryDatePicker"
                            disable="true"
                            GridPane.rowIndex="3"
                            GridPane.columnIndex="1"/>

            </GridPane>

            <Separator/>

            <Label text="Order Progress"/>

            <ProgressBar fx:id="orderProgressBar"
                         prefWidth="500"
                         progress="0.0"/>

            <Separator/>

            <TableView fx:id="trackingTableView" prefHeight="220">

                <columns>

                    <TableColumn fx:id="dateColumn"
                                 text="Date"
                                 prefWidth="150"/>

                    <TableColumn fx:id="eventColumn"
                                 text="Event"
                                 prefWidth="300"/>

                    <TableColumn fx:id="remarksColumn"
                                 text="Remarks"
                                 prefWidth="250"/>

                </columns>

            </TableView>

            <HBox spacing="15">

                <Button fx:id="refreshButton"
                        text="Refresh"/>

                <Button fx:id="closeButton"
                        text="Close"/>

            </HBox>

            <Label fx:id="statusLabel"
                   text="Enter an Order ID to track."
                   style="-fx-text-fill:green; -fx-font-weight:bold;"/>

        </VBox>

    </children>

</AnchorPane>