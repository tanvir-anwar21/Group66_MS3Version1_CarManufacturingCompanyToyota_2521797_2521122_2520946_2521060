<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="Tawsif.SalesExecutiveControllers.GenerateInvoice_Controller"
            prefHeight="700.0"
            prefWidth="1000.0">

    <children>

        <VBox spacing="15"
              AnchorPane.topAnchor="15"
              AnchorPane.bottomAnchor="15"
              AnchorPane.leftAnchor="15"
              AnchorPane.rightAnchor="15">

            <padding>
                <Insets top="20" right="20" bottom="20" left="20"/>
            </padding>

            <Label text="Generate Invoice"
                   style="-fx-font-size:22px; -fx-font-weight:bold;"/>

            <Separator/>

            <GridPane hgap="10" vgap="10">

                <columnConstraints>
                    <ColumnConstraints hgrow="NEVER"/>
                    <ColumnConstraints hgrow="ALWAYS"/>
                    <ColumnConstraints hgrow="NEVER"/>
                </columnConstraints>

                <rowConstraints>
                    <RowConstraints/>
                </rowConstraints>

                <Label text="Order ID"
                       GridPane.columnIndex="0"
                       GridPane.rowIndex="0"/>

                <TextField fx:id="orderIdField"
                           promptText="Enter Order ID"
                           GridPane.columnIndex="1"
                           GridPane.rowIndex="0"/>

                <Button fx:id="searchButton"
                        text="Search"
                        onAction="#handleSearch"
                        GridPane.columnIndex="2"
                        GridPane.rowIndex="0"/>

            </GridPane>

            <Separator/>

            <GridPane hgap="10" vgap="10">

                <columnConstraints>
                    <ColumnConstraints minWidth="150"/>
                    <ColumnConstraints hgrow="ALWAYS"/>
                </columnConstraints>

                <rowConstraints>
                    <RowConstraints/>
                    <RowConstraints/>
                    <RowConstraints/>
                    <RowConstraints/>
                    <RowConstraints/>
                </rowConstraints>

                <Label text="Customer Name"
                       GridPane.columnIndex="0"
                       GridPane.rowIndex="0"/>

                <TextField fx:id="customerNameField"
                           editable="false"
                           GridPane.columnIndex="1"
                           GridPane.rowIndex="0"/>

                <Label text="Vehicle Model"
                       GridPane.columnIndex="0"
                       GridPane.rowIndex="1"/>

                <TextField fx:id="vehicleField"
                           editable="false"
                           GridPane.columnIndex="1"
                           GridPane.rowIndex="1"/>

                <Label text="Quantity"
                       GridPane.columnIndex="0"
                       GridPane.rowIndex="2"/>

                <TextField fx:id="quantityField"
                           editable="false"
                           alignment="CENTER"
                           GridPane.columnIndex="1"
                           GridPane.rowIndex="2"/>

                <Label text="Unit Price"
                       GridPane.columnIndex="0"
                       GridPane.rowIndex="3"/>

                <TextField fx:id="unitPriceField"
                           editable="false"
                           alignment="CENTER_RIGHT"
                           GridPane.columnIndex="1"
                           GridPane.rowIndex="3"/>

                <Label text="Total Price"
                       GridPane.columnIndex="0"
                       GridPane.rowIndex="4"/>

                <TextField fx:id="totalPriceField"
                           editable="false"
                           alignment="CENTER_RIGHT"
                           GridPane.columnIndex="1"
                           GridPane.rowIndex="4"/>

            </GridPane>

            <Separator/>

            <Label text="Invoice Preview"
                   style="-fx-font-size:16px; -fx-font-weight:bold;"/>

            <TextArea fx:id="invoiceTextArea"
                      editable="false"
                      wrapText="true"
                      prefHeight="250"/>

            <HBox spacing="15">

                <Button fx:id="generateButton"
                        text="Generate Invoice"
                        onAction="#handleGenerate"/>

                <Button fx:id="printButton"
                        text="Print"
                        onAction="#handlePrint"/>

                <Button fx:id="saveButton"
                        text="Save"
                        onAction="#handleSave"/>

                <Button fx:id="clearButton"
                        text="Clear"
                        onAction="#handleClear"/>

            </HBox>

            <Label fx:id="statusLabel"
                   text="Waiting for Order ID"
                   style="-fx-text-fill:green; -fx-font-weight:bold;"/>

        </VBox>

    </children>

</AnchorPane>