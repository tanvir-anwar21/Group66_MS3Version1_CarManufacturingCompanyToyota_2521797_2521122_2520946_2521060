<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="Tawsif.SalesExecutiveControllers.VehicleInventory_Controller"
            prefWidth="1000.0"
            prefHeight="700.0">

    <children>

        <VBox spacing="15"
              AnchorPane.topAnchor="15"
              AnchorPane.bottomAnchor="15"
              AnchorPane.leftAnchor="15"
              AnchorPane.rightAnchor="15">

            <padding>
                <Insets top="20" right="20" bottom="20" left="20"/>
            </padding>
            <Button mnemonicParsing="false" onAction="#handleBackToSalesExecutiveDashboard" text="Back to Sales Executive Dashboard" />
            <Label text="Vehicle Inventory"
                   style="-fx-font-size:22px; -fx-font-weight:bold;"/>

            <Separator/>

            <GridPane hgap="10" vgap="10">

                <Label text="Vehicle Model"
                       GridPane.rowIndex="0"
                       GridPane.columnIndex="0"/>

                <ComboBox fx:id="modelComboBox"
                          prefWidth="180"
                          GridPane.rowIndex="0"
                          GridPane.columnIndex="1"/>

                <Label text="Color"
                       GridPane.rowIndex="0"
                       GridPane.columnIndex="2"/>

                <ComboBox fx:id="colorComboBox"
                          prefWidth="150"
                          GridPane.rowIndex="0"
                          GridPane.columnIndex="3"/>

                <Label text="Status"
                       GridPane.rowIndex="1"
                       GridPane.columnIndex="0"/>

                <ComboBox fx:id="statusComboBox"
                          prefWidth="180"
                          GridPane.rowIndex="1"
                          GridPane.columnIndex="1"/>

                <Label text="Warehouse"
                       GridPane.rowIndex="1"
                       GridPane.columnIndex="2"/>

                <ComboBox fx:id="warehouseComboBox"
                          prefWidth="150"
                          GridPane.rowIndex="1"
                          GridPane.columnIndex="3"/>

            </GridPane>

            <HBox spacing="15">

                <Button fx:id="searchButton"
                        text="Search"/>

                <Button fx:id="refreshButton"
                        text="Refresh"/>

                <Button fx:id="clearButton"
                        text="Clear"/>

            </HBox>

            <Separator/>

            <TableView fx:id="inventoryTableView" prefHeight="380">

                <columns>

                    <TableColumn fx:id="vehicleIdColumn"
                                 text="Vehicle ID"
                                 prefWidth="100"/>

                    <TableColumn fx:id="modelColumn"
                                 text="Model"
                                 prefWidth="140"/>

                    <TableColumn fx:id="colorColumn"
                                 text="Color"
                                 prefWidth="100"/>

                    <TableColumn fx:id="engineColumn"
                                 text="Engine"
                                 prefWidth="120"/>

                    <TableColumn fx:id="transmissionColumn"
                                 text="Transmission"
                                 prefWidth="130"/>
                    <TableColumn fx:id="priceColumn" text="Price"/>

                    <TableColumn fx:id="quantityColumn"
                                 text="Quantity"
                                 prefWidth="90"/>

                    <TableColumn fx:id="warehouseColumn"
                                 text="Warehouse"
                                 prefWidth="120"/>

                    <TableColumn fx:id="statusColumn"
                                 text="Status"
                                 prefWidth="120"/>

                </columns>

            </TableView>

            <HBox spacing="20">

                <Label text="Available Vehicles:"/>

                <Label fx:id="availableVehiclesLabel"
                       text="0"/>

            </HBox>

            <Label fx:id="statusLabel"
                   text="Select search criteria."
                   style="-fx-text-fill:green; -fx-font-weight:bold;"/>

        </VBox>

    </children>

</AnchorPane>