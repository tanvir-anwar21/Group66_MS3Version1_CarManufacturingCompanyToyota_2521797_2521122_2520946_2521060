<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="Tawsif.SalesExecutiveControllers.SalesReport_Controller"
            prefWidth="1000.0"
            prefHeight="700.0">

    <children>

        <VBox spacing="15"
              AnchorPane.topAnchor="15"
              AnchorPane.bottomAnchor="15"
              AnchorPane.leftAnchor="15"
              AnchorPane.rightAnchor="15">

            <padding>
                <Insets top="20" right="20" bottom="20" left="20"/>
            </padding>

            <Label text="Sales Report"
                   style="-fx-font-size:22px; -fx-font-weight:bold;"/>

            <Separator/>

            <GridPane hgap="12" vgap="12">

                <Label text="From Date"
                       GridPane.rowIndex="0"
                       GridPane.columnIndex="0"/>

                <DatePicker fx:id="fromDatePicker"
                            GridPane.rowIndex="0"
                            GridPane.columnIndex="1"/>

                <Label text="To Date"
                       GridPane.rowIndex="0"
                       GridPane.columnIndex="2"/>

                <DatePicker fx:id="toDatePicker"
                            GridPane.rowIndex="0"
                            GridPane.columnIndex="3"/>

                <Label text="Vehicle Model"
                       GridPane.rowIndex="1"
                       GridPane.columnIndex="0"/>

                <ComboBox fx:id="vehicleModelComboBox"
                          prefWidth="180"
                          GridPane.rowIndex="1"
                          GridPane.columnIndex="1"/>

                <Label text="Sales Region"
                       GridPane.rowIndex="1"
                       GridPane.columnIndex="2"/>

                <ComboBox fx:id="regionComboBox"
                          prefWidth="180"
                          GridPane.rowIndex="1"
                          GridPane.columnIndex="3"/>

            </GridPane>

            <HBox spacing="15">

                <Button fx:id="generateReportButton"
                        text="Generate Report"/>

                <Button fx:id="exportButton"
                        text="Export"/>

                <Button fx:id="refreshButton"
                        text="Refresh"/>

                <Button fx:id="clearButton"
                        text="Clear"/>

            </HBox>

            <Separator/>

            <TableView fx:id="salesReportTableView" prefHeight="320">

                <columns>

                    <TableColumn fx:id="orderIdColumn"
                                 text="Order ID"
                                 prefWidth="90"/>

                    <TableColumn fx:id="customerColumn"
                                 text="Customer"
                                 prefWidth="170"/>

                    <TableColumn fx:id="vehicleColumn"
                                 text="Vehicle"
                                 prefWidth="140"/>

                    <TableColumn fx:id="quantityColumn"
                                 text="Quantity"
                                 prefWidth="90"/>

                    <TableColumn fx:id="amountColumn"
                                 text="Amount"
                                 prefWidth="120"/>

                    <TableColumn fx:id="dateColumn"
                                 text="Sale Date"
                                 prefWidth="140"/>

                    <TableColumn fx:id="regionColumn"
                                 text="Region"
                                 prefWidth="120"/>

                </columns>

            </TableView>

            <Separator/>

            <GridPane hgap="20" vgap="10">

                <Label text="Total Orders"
                       GridPane.rowIndex="0"
                       GridPane.columnIndex="0"/>

                <Label fx:id="totalOrdersLabel"
                       text="0"
                       GridPane.rowIndex="0"
                       GridPane.columnIndex="1"/>

                <Label text="Total Revenue"
                       GridPane.rowIndex="0"
                       GridPane.columnIndex="2"/>

                <Label fx:id="totalRevenueLabel"
                       text="0.00"
                       GridPane.rowIndex="0"
                       GridPane.columnIndex="3"/>

            </GridPane>

            <Label fx:id="statusLabel"
                   text="Select filters and generate the report."
                   style="-fx-text-fill:green; -fx-font-weight:bold;"/>

        </VBox>

    </children>

</AnchorPane>