<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="User4.HRManagerControllers.EmployeeRegistration_Controller"
            prefWidth="1000"
            prefHeight="650">

    <top>
        <HBox alignment="CENTER_LEFT"
              spacing="15"
              style="-fx-padding:15 20; -fx-background-color:#2c3e50;">

            <Button text="← Back to Dashboard"
                    onAction="#handleBack"
                    style="-fx-background-color:#34495e; -fx-text-fill:white;"/>

            <Label text="👤 Employee Registration"
                   style="-fx-font-size:20px; -fx-font-weight:bold; -fx-text-fill:white;"/>

            <Region HBox.hgrow="ALWAYS"/>

            <Label fx:id="userLabel"
                   text="HR Manager"
                   style="-fx-text-fill:#ecf0f1;"/>

        </HBox>
    </top>

    <center>

        <VBox spacing="15"
              style="-fx-padding:20;">

            <GridPane hgap="15"
                      vgap="12"
                      style="-fx-padding:20; -fx-background-color:#ecf0f1; -fx-border-color:#bdc3c7; -fx-border-radius:5;">

                <Label text="Employee ID"
                       GridPane.rowIndex="0"
                       GridPane.columnIndex="0"/>

                <TextField fx:id="employeeIdField"
                           promptText="Employee ID"
                           GridPane.rowIndex="0"
                           GridPane.columnIndex="1"/>

                <Label text="Employee Name"
                       GridPane.rowIndex="1"
                       GridPane.columnIndex="0"/>

                <TextField fx:id="employeeNameField"
                           promptText="Employee Name"
                           GridPane.rowIndex="1"
                           GridPane.columnIndex="1"/>

                <Label text="Department"
                       GridPane.rowIndex="2"
                       GridPane.columnIndex="0"/>

                <ComboBox fx:id="departmentComboBox"
                          prefWidth="220"
                          GridPane.rowIndex="2"
                          GridPane.columnIndex="1"/>

                <Label text="Designation"
                       GridPane.rowIndex="3"
                       GridPane.columnIndex="0"/>

                <ComboBox fx:id="designationComboBox"
                          prefWidth="220"
                          GridPane.rowIndex="3"
                          GridPane.columnIndex="1"/>

                <Label text="Salary"
                       GridPane.rowIndex="0"
                       GridPane.columnIndex="2"/>

                <TextField fx:id="salaryField"
                           promptText="Salary"
                           GridPane.rowIndex="0"
                           GridPane.columnIndex="3"/>

                <Label text="Phone"
                       GridPane.rowIndex="1"
                       GridPane.columnIndex="2"/>

                <TextField fx:id="phoneField"
                           promptText="Phone Number"
                           GridPane.rowIndex="1"
                           GridPane.columnIndex="3"/>

                <Label text="Email"
                       GridPane.rowIndex="2"
                       GridPane.columnIndex="2"/>

                <TextField fx:id="emailField"
                           promptText="Email"
                           GridPane.rowIndex="2"
                           GridPane.columnIndex="3"/>

                <Label text="Joining Date"
                       GridPane.rowIndex="3"
                       GridPane.columnIndex="2"/>

                <DatePicker fx:id="joiningDatePicker"
                            GridPane.rowIndex="3"
                            GridPane.columnIndex="3"/>

            </GridPane>

            <HBox spacing="15"
                  alignment="CENTER">

                <Button text="➕ Register"
                        fx:id="registerButton"
                        onAction="#handleRegister"
                        style="-fx-background-color:#27ae60; -fx-text-fill:white; -fx-padding:10 25;"/>

                <Button text="🔍 Search"
                        fx:id="searchButton"
                        onAction="#handleSearch"
                        style="-fx-background-color:#3498db; -fx-text-fill:white; -fx-padding:10 25;"/>

                <Button text="🧹 Clear"
                        fx:id="clearButton"
                        onAction="#handleClear"
                        style="-fx-background-color:#f39c12; -fx-text-fill:white; -fx-padding:10 25;"/>

                <Button text="❌ Delete"
                        fx:id="deleteButton"
                        onAction="#handleDelete"
                        style="-fx-background-color:#e74c3c; -fx-text-fill:white; -fx-padding:10 25;"/>

            </HBox>

            <TitledPane text="Registered Employees"
                        expanded="true">

                <VBox spacing="10"
                      style="-fx-padding:10;">

                    <TableView fx:id="employeeTableView"
                               prefHeight="250">

                        <columns>

                            <TableColumn fx:id="idColumn"
                                         text="Employee ID"
                                         prefWidth="120"/>

                            <TableColumn fx:id="nameColumn"
                                         text="Name"
                                         prefWidth="180"/>

                            <TableColumn fx:id="departmentColumn"
                                         text="Department"
                                         prefWidth="150"/>

                            <TableColumn fx:id="designationColumn"
                                         text="Designation"
                                         prefWidth="150"/>

                            <TableColumn fx:id="salaryColumn"
                                         text="Salary"
                                         prefWidth="120"/>

                            <TableColumn fx:id="phoneColumn"
                                         text="Phone"
                                         prefWidth="150"/>

                        </columns>

                    </TableView>

                </VBox>

            </TitledPane>

            <Label fx:id="statusLabel"
                   text="Fill the employee information and click Register."
                   style="-fx-font-weight:bold; -fx-text-fill:#2c3e50;"/>

        </VBox>

    </center>

</BorderPane>