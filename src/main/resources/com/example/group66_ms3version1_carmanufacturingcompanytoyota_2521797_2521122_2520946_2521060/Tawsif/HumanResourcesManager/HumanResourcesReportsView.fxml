<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="Tawsif.HumanResourcesManagerControllers.HumanResourcesReports_Controller"
            prefWidth="1000"
            prefHeight="650">

    <top>
        <HBox alignment="CENTER_LEFT"
              spacing="15"
              style="-fx-padding:15 20; -fx-background-color:#2c3e50;">

            <Button text="← Back"
                    onAction="#handleBack"
                    style="-fx-background-color:#34495e; -fx-text-fill:white;"/>

            <Label text="📊 Human Resources Reports"
                   style="-fx-text-fill:white; -fx-font-size:20px; -fx-font-weight:bold;"/>

            <Region HBox.hgrow="ALWAYS"/>

            <Label fx:id="userLabel"
                   text="HR Manager"
                   style="-fx-text-fill:white;"/>

        </HBox>
    </top>

    <center>

        <VBox spacing="18"
              style="-fx-padding:20;">

            <GridPane hgap="15"
                      vgap="12"
                      style="-fx-padding:20; -fx-background-color:#ecf0f1; -fx-border-color:#bdc3c7; -fx-border-radius:5;">

                <Label text="Report Type"
                       GridPane.columnIndex="0"
                       GridPane.rowIndex="0"/>

                <ComboBox fx:id="reportTypeComboBox"
                          prefWidth="220"
                          GridPane.columnIndex="1"
                          GridPane.rowIndex="0"/>

                <Label text="Report Date"
                       GridPane.columnIndex="2"
                       GridPane.rowIndex="0"/>

                <DatePicker fx:id="reportDatePicker"
                            GridPane.columnIndex="3"
                            GridPane.rowIndex="0"/>

                <Label text="Generated By"
                       GridPane.columnIndex="0"
                       GridPane.rowIndex="1"/>

                <TextField fx:id="generatedByField"
                           promptText="Employee Name"
                           prefWidth="220"
                           GridPane.columnIndex="1"
                           GridPane.rowIndex="1"/>

            </GridPane>

            <HBox spacing="15"
                  alignment="CENTER">

                <Button text="📄 Generate Report"
                        onAction="#handleGenerateReport"
                        style="-fx-background-color:#27ae60; -fx-text-fill:white;"/>

                <Button text="🔍 Search"
                        onAction="#handleSearch"
                        style="-fx-background-color:#3498db; -fx-text-fill:white;"/>

                <Button text="🔄 Refresh"
                        onAction="#handleRefresh"
                        style="-fx-background-color:#9b59b6; -fx-text-fill:white;"/>

                <Button text="🧹 Clear"
                        onAction="#handleClear"
                        style="-fx-background-color:#f39c12; -fx-text-fill:white;"/>

            </HBox>

            <TableView fx:id="reportTableView"
                       prefHeight="320">

                <columns>

                    <TableColumn fx:id="reportIdColumn"
                                 text="Report ID"
                                 prefWidth="180"/>

                    <TableColumn fx:id="reportTypeColumn"
                                 text="Report Type"
                                 prefWidth="250"/>

                    <TableColumn fx:id="reportDateColumn"
                                 text="Report Date"
                                 prefWidth="220"/>

                    <TableColumn fx:id="generatedByColumn"
                                 text="Generated By"
                                 prefWidth="330"/>

                </columns>

            </TableView>

            <HBox spacing="20">

                <Label text="Total Reports:"
                       style="-fx-font-weight:bold;"/>

                <Label fx:id="totalReportsLabel"
                       text="0"/>

            </HBox>

            <Label fx:id="statusLabel"
                   text="Ready"
                   style="-fx-font-weight:bold; -fx-text-fill:#2c3e50;"/>

        </VBox>

    </center>

</BorderPane>