<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="User4.HRManagerControllers.HRManagerDashboard_Controller"
            prefWidth="1000"
            prefHeight="650">

    <top>
        <HBox alignment="CENTER_LEFT"
              spacing="15"
              style="-fx-padding:15 20; -fx-background-color:#2c3e50;">

            <Label text="🏢 Toyota Manufacturing System"
                   style="-fx-text-fill:white; -fx-font-size:22px; -fx-font-weight:bold;"/>

            <Region HBox.hgrow="ALWAYS"/>

            <Label fx:id="userLabel"
                   text="HR Manager"
                   style="-fx-text-fill:white;"/>

        </HBox>
    </top>

    <center>

        <VBox alignment="TOP_CENTER"
              spacing="25"
              style="-fx-padding:30;">

            <Label text="HR Manager Dashboard"
                   style="-fx-font-size:26px; -fx-font-weight:bold;"/>

            <GridPane hgap="25"
                      vgap="25"
                      alignment="CENTER">

                <Button text="👤&#10;Employee Registration"
                        prefWidth="220"
                        prefHeight="90"
                        onAction="#handleEmployeeRegistration"
                        GridPane.columnIndex="0"
                        GridPane.rowIndex="0"/>

                <Button text="📝&#10;Leave Management"
                        prefWidth="220"
                        prefHeight="90"
                        onAction="#handleLeaveManagement"
                        GridPane.columnIndex="1"
                        GridPane.rowIndex="0"/>

                <Button text="📅&#10;Attendance"
                        prefWidth="220"
                        prefHeight="90"
                        onAction="#handleAttendance"
                        GridPane.columnIndex="2"
                        GridPane.rowIndex="0"/>

                <Button text="💰&#10;Payroll"
                        prefWidth="220"
                        prefHeight="90"
                        onAction="#handlePayroll"
                        GridPane.columnIndex="0"
                        GridPane.rowIndex="1"/>

                <Button text="✏️&#10;Update Employee"
                        prefWidth="220"
                        prefHeight="90"
                        onAction="#handleUpdateEmployee"
                        GridPane.columnIndex="1"
                        GridPane.rowIndex="1"/>

                <Button text="🚪&#10;Employee Separation"
                        prefWidth="220"
                        prefHeight="90"
                        onAction="#handleEmployeeSeparation"
                        GridPane.columnIndex="2"
                        GridPane.rowIndex="1"/>

                <Button text="📋&#10;Employee Directory"
                        prefWidth="220"
                        prefHeight="90"
                        onAction="#handleEmployeeDirectory"
                        GridPane.columnIndex="0"
                        GridPane.rowIndex="2"/>

                <Button text="📊&#10;HR Reports"
                        prefWidth="220"
                        prefHeight="90"
                        onAction="#handleHRReports"
                        GridPane.columnIndex="1"
                        GridPane.rowIndex="2"/>

                <Button text="🚪&#10;Logout"
                        prefWidth="220"
                        prefHeight="90"
                        onAction="#handleLogout"
                        style="-fx-background-color:#e74c3c; -fx-text-fill:white;"
                        GridPane.columnIndex="2"
                        GridPane.rowIndex="2"/>

            </GridPane>

        </VBox>

    </center>

</BorderPane>