<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="User4.HRManagerControllers.AttendanceManagement_Controller"
            prefWidth="1000"
            prefHeight="650">

    <top>
        <HBox alignment="CENTER_LEFT"
              spacing="15"
              style="-fx-padding:15 20; -fx-background-color:#2c3e50;">

            <Button text="← Back to Dashboard"
                    onAction="#handleBack"
                    style="-fx-background-color:#34495e; -fx-text-fill:white;"/>

            <Label text="📅 Attendance Management"
                   style="-fx-text-fill:white; -fx-font-size:20px; -fx-font-weight:bold;"/>

            <Region HBox.hgrow="ALWAYS"/>

            <Label fx:id="userLabel"
                   text="HR Manager"
                   style="-fx-text-fill:#ecf0f1;"/>

        </HBox>
    </top>

    <center>

        <VBox spacing="15" style="-fx-padding:20;">

            <GridPane hgap="15"
                      vgap="10"
                      style="-fx-padding:20; -fx-background-color:#ecf0f1; -fx-border-color:#bdc3c7; -fx-border-radius:5;">

                <Label text="Attendance Date"
                       GridPane.columnIndex="0"
                       GridPane.rowIndex="0"/>

                <DatePicker fx:id="attendanceDatePicker"
                            GridPane.columnIndex="1"
                            GridPane.rowIndex="0"/>

                <Label text="Department"
                       GridPane.columnIndex="2"
                       GridPane.rowIndex="0"/>

                <ComboBox fx:id="departmentComboBox"
                          prefWidth="180"
                          GridPane.columnIndex="3"
                          GridPane.rowIndex="0"/>

                <Label text="Employee ID"
                       GridPane.columnIndex="0"
                       GridPane.rowIndex="1"/>

                <TextField fx:id="employeeIdField"
                           promptText="Employee ID"
                           GridPane.columnIndex="1"
                           GridPane.rowIndex="1"/>

                <Label text="Status"
                       GridPane.columnIndex="2"
                       GridPane.rowIndex="1"/>

                <ComboBox fx:id="attendanceStatusComboBox"
                          prefWidth="180"
                          GridPane.columnIndex="3"
                          GridPane.rowIndex="1"/>

            </GridPane>

            <HBox alignment="CENTER" spacing="15">

                <Button text="🔍 Search"
                        onAction="#handleSearch"
                        style="-fx-background-color:#3498db; -fx-text-fill:white;"/>

                <Button text="✅ Mark Attendance"
                        onAction="#handleMarkAttendance"
                        style="-fx-background-color:#27ae60; -fx-text-fill:white;"/>

                <Button text="🔄 Update"
                        onAction="#handleUpdate"
                        style="-fx-background-color:#9b59b6; -fx-text-fill:white;"/>

                <Button text="🧹 Clear"
                        onAction="#handleClear"
                        style="-fx-background-color:#f39c12; -fx-text-fill:white;"/>

            </HBox>

            <TitledPane text="Attendance Records" expanded="true">

                <VBox spacing="10" style="-fx-padding:10;">

                    <TableView fx:id="attendanceTableView" prefHeight="260">

                        <columns>

                            <TableColumn fx:id="employeeIdColumn"
                                         text="Employee ID"
                                         prefWidth="100"/>

                            <TableColumn fx:id="employeeNameColumn"
                                         text="Employee Name"
                                         prefWidth="170"/>

                            <TableColumn fx:id="departmentColumn"
                                         text="Department"
                                         prefWidth="140"/>

                            <TableColumn fx:id="dateColumn"
                                         text="Date"
                                         prefWidth="110"/>

                            <TableColumn fx:id="checkInColumn"
                                         text="Check In"
                                         prefWidth="90"/>

                            <TableColumn fx:id="checkOutColumn"
                                         text="Check Out"
                                         prefWidth="90"/>

                            <TableColumn fx:id="statusColumn"
                                         text="Status"
                                         prefWidth="100"/>

                            <TableColumn fx:id="hoursWorkedColumn"
                                         text="Hours"
                                         prefWidth="80"/>

                        </columns>

                    </TableView>

                </VBox>

            </TitledPane>

            <HBox spacing="25" alignment="CENTER_LEFT">

                <Label text="Present:" style="-fx-font-weight:bold;"/>
                <Label fx:id="presentCountLabel" text="0"/>

                <Label text="Absent:" style="-fx-font-weight:bold;"/>
                <Label fx:id="absentCountLabel" text="0"/>

                <Label text="Late:" style="-fx-font-weight:bold;"/>
                <Label fx:id="lateCountLabel" text="0"/>

            </HBox>

            <Label fx:id="statusLabel"
                   text="Select a date to manage attendance."
                   style="-fx-font-weight:bold; -fx-text-fill:#2c3e50;"/>

        </VBox>

    </center>

</BorderPane>