<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="User4.HRManagerControllers.EmployeeSeparation_Controller"
            prefWidth="1000"
            prefHeight="650">

    <top>
        <HBox alignment="CENTER_LEFT"
              spacing="15"
              style="-fx-padding:15 20; -fx-background-color:#2c3e50;">

            <Button text="← Back to Dashboard"
                    onAction="#handleBack"
                    style="-fx-background-color:#34495e; -fx-text-fill:white;"/>

            <Label text="🚪 Employee Separation"
                   style="-fx-text-fill:white; -fx-font-size:20px; -fx-font-weight:bold;"/>

            <Region HBox.hgrow="ALWAYS"/>

            <Label fx:id="userLabel"
                   text="HR Manager"
                   style="-fx-text-fill:#ecf0f1;"/>

        </HBox>
    </top>

    <center>

        <VBox spacing="15"
              style="-fx-padding:20;">

            <GridPane hgap="15"
                      vgap="12"
                      style="-fx-padding:20; -fx-background-color:#ecf0f1; -fx-border-color:#bdc3c7; -fx-border-radius:5;">

                <Label text="Employee ID"
                       GridPane.columnIndex="0"
                       GridPane.rowIndex="0"/>

                <TextField fx:id="employeeIdField"
                           promptText="Employee ID"
                           GridPane.columnIndex="1"
                           GridPane.rowIndex="0"/>

                <Button text="🔍 Search"
                        onAction="#handleSearch"
                        GridPane.columnIndex="2"
                        GridPane.rowIndex="0"
                        style="-fx-background-color:#3498db; -fx-text-fill:white;"/>

                <Label text="Employee Name"
                       GridPane.columnIndex="0"
                       GridPane.rowIndex="1"/>

                <TextField fx:id="employeeNameField"
                           editable="false"
                           GridPane.columnIndex="1"
                           GridPane.rowIndex="1"/>

                <Label text="Department"
                       GridPane.columnIndex="2"
                       GridPane.rowIndex="1"/>

                <TextField fx:id="departmentField"
                           editable="false"
                           GridPane.columnIndex="3"
                           GridPane.rowIndex="1"/>

                <Label text="Separation Type"
                       GridPane.columnIndex="0"
                       GridPane.rowIndex="2"/>

                <ComboBox fx:id="separationTypeComboBox"
                          prefWidth="180"
                          GridPane.columnIndex="1"
                          GridPane.rowIndex="2"/>

                <Label text="Last Working Day"
                       GridPane.columnIndex="2"
                       GridPane.rowIndex="2"/>

                <DatePicker fx:id="lastWorkingDayPicker"
                            GridPane.columnIndex="3"
                            GridPane.rowIndex="2"/>

                <Label text="Reason"
                       GridPane.columnIndex="0"
                       GridPane.rowIndex="3"/>

                <TextArea fx:id="reasonTextArea"
                          prefRowCount="3"
                          GridPane.columnIndex="1"
                          GridPane.columnSpan="3"
                          GridPane.rowIndex="3"/>

            </GridPane>

            <HBox alignment="CENTER" spacing="15">

                <Button text="💾 Save"
                        onAction="#handleSave"
                        style="-fx-background-color:#27ae60; -fx-text-fill:white;"/>

                <Button text="📄 Generate Clearance"
                        onAction="#handleGenerateClearance"
                        style="-fx-background-color:#9b59b6; -fx-text-fill:white;"/>

                <Button text="🗑 Remove"
                        onAction="#handleRemove"
                        style="-fx-background-color:#e74c3c; -fx-text-fill:white;"/>

                <Button text="🧹 Clear"
                        onAction="#handleClear"
                        style="-fx-background-color:#f39c12; -fx-text-fill:white;"/>

            </HBox>

            <TitledPane text="Separated Employees" expanded="true">

                <VBox spacing="10" style="-fx-padding:10;">

                    <TableView fx:id="separationTableView" prefHeight="250">

                        <columns>

                            <TableColumn fx:id="employeeIdColumn"
                                         text="Employee ID"
                                         prefWidth="100"/>

                            <TableColumn fx:id="employeeNameColumn"
                                         text="Employee Name"
                                         prefWidth="170"/>

                            <TableColumn fx:id="departmentColumn"
                                         text="Department"
                                         prefWidth="130"/>

                            <TableColumn fx:id="typeColumn"
                                         text="Type"
                                         prefWidth="120"/>

                            <TableColumn fx:id="lastDayColumn"
                                         text="Last Day"
                                         prefWidth="120"/>

                            <TableColumn fx:id="reasonColumn"
                                         text="Reason"
                                         prefWidth="220"/>

                            <TableColumn fx:id="statusColumn"
                                         text="Status"
                                         prefWidth="120"/>

                        </columns>

                    </TableView>

                </VBox>

            </TitledPane>

            <Label fx:id="statusLabel"
                   text="Search an employee to process separation."
                   style="-fx-font-weight:bold; -fx-text-fill:#2c3e50;"/>

        </VBox>

    </center>

</BorderPane>