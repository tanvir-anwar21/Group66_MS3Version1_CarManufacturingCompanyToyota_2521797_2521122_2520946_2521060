<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane prefHeight="650.0" prefWidth="950.0"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1">

    <children>

        <VBox spacing="15"
              AnchorPane.topAnchor="15"
              AnchorPane.leftAnchor="15"
              AnchorPane.rightAnchor="15"
              AnchorPane.bottomAnchor="15">

            <padding>
                <Insets top="20" right="20" bottom="20" left="20"/>
            </padding>


            <!-- Title -->

            <Label text="Production Report"
                   style="-fx-font-size:24px; -fx-font-weight:bold;"/>

            <Separator/>


            <!-- Report Summary -->


            <GridPane hgap="15" vgap="15">

                <columnConstraints>
                    <ColumnConstraints percentWidth="25"/>
                    <ColumnConstraints percentWidth="25"/>
                    <ColumnConstraints percentWidth="25"/>
                    <ColumnConstraints percentWidth="25"/>
                </columnConstraints>


                <VBox spacing="5"
                      style="-fx-border-color:#BDBDBD; -fx-padding:10;">
                    <Label text="Total Production"/>
                    <TextField fx:id="totalProductionField"
                               editable="false"/>
                </VBox>


                <VBox GridPane.columnIndex="1"
                      spacing="5"
                      style="-fx-border-color:#BDBDBD; -fx-padding:10;">
                    <Label text="Completed Orders"/>
                    <TextField fx:id="completedField"
                               editable="false"/>
                </VBox>


                <VBox GridPane.columnIndex="2"
                      spacing="5"
                      style="-fx-border-color:#BDBDBD; -fx-padding:10;">
                    <Label text="Rejected Units"/>
                    <TextField fx:id="rejectedField"
                               editable="false"/>
                </VBox>


                <VBox GridPane.columnIndex="3"
                      spacing="5"
                      style="-fx-border-color:#BDBDBD; -fx-padding:10;">
                    <Label text="Efficiency"/>
                    <TextField fx:id="efficiencyField"
                               editable="false"/>
                </VBox>


            </GridPane>


            <Separator/>


            <!-- Report Table -->


            <Label text="Production Report Records"
                   style="-fx-font-size:18px; -fx-font-weight:bold;"/>


            <TableView fx:id="reportTable"
                       prefHeight="270">


                <columns>


                    <TableColumn fx:id="dateColumn"
                                 text="Date"
                                 prefWidth="130"/>


                    <TableColumn fx:id="productColumn"
                                 text="Product"
                                 prefWidth="180"/>


                    <TableColumn fx:id="quantityColumn"
                                 text="Quantity Produced"
                                 prefWidth="160"/>


                    <TableColumn fx:id="qualityColumn"
                                 text="Quality Rate"
                                 prefWidth="140"/>


                    <TableColumn fx:id="statusColumn"
                                 text="Status"
                                 prefWidth="140"/>


                </columns>


            </TableView>


            <Separator/>


            <!-- Generate Report -->


            <Label text="Generate Production Report"
                   style="-fx-font-size:18px; -fx-font-weight:bold;"/>


            <HBox spacing="15">


                <DatePicker fx:id="fromDatePicker"/>


                <DatePicker fx:id="toDatePicker"/>


                <ComboBox fx:id="reportTypeComboBox"
                          promptText="Report Type"/>


            </HBox>


            <TextArea fx:id="summaryArea"
                      prefHeight="90"
                      wrapText="true"
                      promptText="Report summary..."/>


            <HBox spacing="15">


                <Button fx:id="generateButton"
                        text="Generate"
                        prefWidth="130"/>


                <Button fx:id="exportButton"
                        text="Export Report"
                        prefWidth="150"/>


                <Button fx:id="refreshButton"
                        text="Refresh"
                        prefWidth="120"/>


                <Button fx:id="backButton"
                        text="Back"
                        prefWidth="100"/>


            </HBox>


            <Label fx:id="statusLabel"
                   text="Ready"
                   style="-fx-text-fill:green; -fx-font-weight:bold;"/>


        </VBox>


    </children>


</AnchorPane>