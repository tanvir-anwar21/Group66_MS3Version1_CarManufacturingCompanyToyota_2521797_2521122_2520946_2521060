<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane prefHeight="650.0" prefWidth="950.0"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1">

    <children>

        <VBox spacing="15"
              AnchorPane.topAnchor="15"
              AnchorPane.leftAnchor="15"
              AnchorPane.rightAnchor="15"
              AnchorPane.bottomAnchor="15">

            <padding>
                <Insets top="20" right="20" bottom="20" left="20"/>
            </padding>

            <!-- Title -->
            <Label text="Production Planning"
                   style="-fx-font-size:24px; -fx-font-weight:bold;"/>

            <Separator/>

            <!-- Planning Summary -->
            <GridPane hgap="15" vgap="15">

                <columnConstraints>
                    <ColumnConstraints percentWidth="25"/>
                    <ColumnConstraints percentWidth="25"/>
                    <ColumnConstraints percentWidth="25"/>
                    <ColumnConstraints percentWidth="25"/>
                </columnConstraints>

                <VBox spacing="5"
                      style="-fx-border-color:#BDBDBD; -fx-padding:10;">
                    <Label text="Today's Plan"/>
                    <TextField fx:id="todayPlanField" editable="false"/>
                </VBox>

                <VBox GridPane.columnIndex="1"
                      spacing="5"
                      style="-fx-border-color:#BDBDBD; -fx-padding:10;">
                    <Label text="Monthly Target"/>
                    <TextField fx:id="monthlyTargetField" editable="false"/>
                </VBox>

                <VBox GridPane.columnIndex="2"
                      spacing="5"
                      style="-fx-border-color:#BDBDBD; -fx-padding:10;">
                    <Label text="Completed Orders"/>
                    <TextField fx:id="completedOrdersField" editable="false"/>
                </VBox>

                <VBox GridPane.columnIndex="3"
                      spacing="5"
                      style="-fx-border-color:#BDBDBD; -fx-padding:10;">
                    <Label text="Pending Orders"/>
                    <TextField fx:id="pendingOrdersField" editable="false"/>
                </VBox>

            </GridPane>

            <Separator/>

            <!-- Production Schedule -->
            <Label text="Production Schedule"
                   style="-fx-font-size:18px; -fx-font-weight:bold;"/>

            <TableView fx:id="planningTable"
                       prefHeight="270">

                <columns>

                    <TableColumn fx:id="productColumn"
                                 text="Product"
                                 prefWidth="180"/>

                    <TableColumn fx:id="quantityColumn"
                                 text="Quantity"
                                 prefWidth="140"/>

                    <TableColumn fx:id="startDateColumn"
                                 text="Start Date"
                                 prefWidth="150"/>

                    <TableColumn fx:id="endDateColumn"
                                 text="End Date"
                                 prefWidth="150"/>

                    <TableColumn fx:id="statusColumn"
                                 text="Status"
                                 prefWidth="140"/>

                </columns>

            </TableView>

            <Separator/>

            <!-- Add Production Plan -->

            <Label text="Create Production Plan"
                   style="-fx-font-size:18px; -fx-font-weight:bold;"/>

            <GridPane hgap="10" vgap="10">

                <TextField fx:id="productField"
                           promptText="Product Name"/>

                <TextField fx:id="quantityField"
                           GridPane.columnIndex="1"
                           promptText="Quantity"/>

                <DatePicker fx:id="startDatePicker"
                            GridPane.columnIndex="2"/>

                <DatePicker fx:id="endDatePicker"
                            GridPane.columnIndex="3"/>

            </GridPane>

            <HBox spacing="15">

                <Button fx:id="addButton"
                        text="Add Plan"
                        prefWidth="120"/>

                <Button fx:id="updateButton"
                        text="Update"
                        prefWidth="120"/>

                <Button fx:id="deleteButton"
                        text="Delete"
                        prefWidth="120"/>

                <Button fx:id="refreshButton"
                        text="Refresh"
                        prefWidth="120"/>

                <Button fx:id="backButton"
                        text="Back"
                        prefWidth="100"/>

            </HBox>

            <Label fx:id="statusLabel"
                   text="Ready"
                   style="-fx-text-fill:green; -fx-font-weight:bold;"/>

        </VBox>

    </children>

</AnchorPane>