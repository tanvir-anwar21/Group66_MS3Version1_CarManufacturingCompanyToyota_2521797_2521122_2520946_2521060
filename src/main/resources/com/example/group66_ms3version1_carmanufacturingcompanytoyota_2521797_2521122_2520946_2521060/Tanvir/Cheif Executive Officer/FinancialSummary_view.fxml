<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane prefHeight="650.0" prefWidth="950.0"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1">

    <children>

        <VBox spacing="15"
              AnchorPane.topAnchor="15"
              AnchorPane.leftAnchor="15"
              AnchorPane.rightAnchor="15"
              AnchorPane.bottomAnchor="15">

            <padding>
                <Insets top="20" right="20" bottom="20" left="20"/>
            </padding>

            <!-- Title -->
            <Label text="Financial Summary"
                   style="-fx-font-size:24px; -fx-font-weight:bold;"/>

            <Separator/>

            <!-- Financial Summary Cards -->
            <GridPane hgap="15" vgap="15">

                <columnConstraints>
                    <ColumnConstraints percentWidth="25"/>
                    <ColumnConstraints percentWidth="25"/>
                    <ColumnConstraints percentWidth="25"/>
                    <ColumnConstraints percentWidth="25"/>
                </columnConstraints>

                <VBox spacing="5"
                      style="-fx-border-color:#BDBDBD; -fx-padding:10;">
                    <Label text="Total Revenue"/>
                    <TextField fx:id="revenueField" editable="false"/>
                </VBox>

                <VBox GridPane.columnIndex="1"
                      spacing="5"
                      style="-fx-border-color:#BDBDBD; -fx-padding:10;">
                    <Label text="Total Expenses"/>
                    <TextField fx:id="expensesField" editable="false"/>
                </VBox>

                <VBox GridPane.columnIndex="2"
                      spacing="5"
                      style="-fx-border-color:#BDBDBD; -fx-padding:10;">
                    <Label text="Net Profit"/>
                    <TextField fx:id="profitField" editable="false"/>
                </VBox>

                <VBox GridPane.columnIndex="3"
                      spacing="5"
                      style="-fx-border-color:#BDBDBD; -fx-padding:10;">
                    <Label text="Profit Margin"/>
                    <TextField fx:id="marginField" editable="false"/>
                </VBox>

            </GridPane>

            <Separator/>

            <!-- Financial Records -->
            <Label text="Financial Records"
                   style="-fx-font-size:18px; -fx-font-weight:bold;"/>

            <TableView fx:id="financialTable" prefHeight="270">

                <columns>

                    <TableColumn fx:id="categoryColumn"
                                 text="Category"
                                 prefWidth="180"/>

                    <TableColumn fx:id="incomeColumn"
                                 text="Income"
                                 prefWidth="170"/>

                    <TableColumn fx:id="expenseColumn"
                                 text="Expense"
                                 prefWidth="170"/>

                    <TableColumn fx:id="balanceColumn"
                                 text="Balance"
                                 prefWidth="170"/>

                    <TableColumn fx:id="remarksColumn"
                                 text="Remarks"
                                 prefWidth="220"/>

                </columns>

            </TableView>

            <Separator/>

            <!-- CEO Financial Notes -->
            <Label text="CEO Financial Notes"
                   style="-fx-font-size:18px; -fx-font-weight:bold;"/>

            <TextArea fx:id="notesArea"
                      prefHeight="100"
                      wrapText="true"
                      promptText="Enter financial observations or recommendations..."/>

            <HBox spacing="15">

                <Button fx:id="loadButton"
                        text="Load Summary"
                        prefWidth="140"/>

                <Button fx:id="refreshButton"
                        text="Refresh"
                        prefWidth="120"/>

                <Button fx:id="exportButton"
                        text="Export Report"
                        prefWidth="150"/>

               <Button fx:id="backButton"
                        text="Back"
                        prefWidth="100"/>

            </HBox>

            <Label fx:id="statusLabel"
                   text="Ready"
                   style="-fx-text-fill:green; -fx-font-weight:bold;"/>

        </VBox>

    </children>

</AnchorPane>