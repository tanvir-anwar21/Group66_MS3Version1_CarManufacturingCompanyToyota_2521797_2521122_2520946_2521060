<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane prefHeight="600.0" prefWidth="900.0"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1">

    <children>

        <VBox spacing="15"
              AnchorPane.topAnchor="15"
              AnchorPane.leftAnchor="15"
              AnchorPane.rightAnchor="15"
              AnchorPane.bottomAnchor="15">

            <padding>
                <Insets top="20" right="20" bottom="20" left="20"/>
            </padding>

            <!-- Title -->
            <Label text="Production Performance Dashboard"
                   style="-fx-font-size:24px; -fx-font-weight:bold;"/>

            <Separator/>

            <!-- Production Summary -->
            <GridPane hgap="15" vgap="15">

                <columnConstraints>
                    <ColumnConstraints percentWidth="25"/>
                    <ColumnConstraints percentWidth="25"/>
                    <ColumnConstraints percentWidth="25"/>
                    <ColumnConstraints percentWidth="25"/>
                </columnConstraints>

                <VBox spacing="5"
                      style="-fx-border-color:#BDBDBD; -fx-padding:10;">
                    <Label text="Total Units Produced"/>
                    <TextField fx:id="totalUnitsField" editable="false"/>
                </VBox>

                <VBox GridPane.columnIndex="1"
                      spacing="5"
                      style="-fx-border-color:#BDBDBD; -fx-padding:10;">
                    <Label text="Production Target"/>
                    <TextField fx:id="targetField" editable="false"/>
                </VBox>

                <VBox GridPane.columnIndex="2"
                      spacing="5"
                      style="-fx-border-color:#BDBDBD; -fx-padding:10;">
                    <Label text="Efficiency"/>
                    <TextField fx:id="efficiencyField" editable="false"/>
                </VBox>

                <VBox GridPane.columnIndex="3"
                      spacing="5"
                      style="-fx-border-color:#BDBDBD; -fx-padding:10;">
                    <Label text="Defect Rate"/>
                    <TextField fx:id="defectRateField" editable="false"/>
                </VBox>

            </GridPane>

            <Separator/>

            <!-- Production Records -->
            <Label text="Production Records"
                   style="-fx-font-size:18px; -fx-font-weight:bold;"/>

            <TableView fx:id="productionTable" prefHeight="250">

                <columns>

                    <TableColumn fx:id="productColumn"
                                 text="Product"
                                 prefWidth="180"/>

                    <TableColumn fx:id="plannedColumn"
                                 text="Planned Units"
                                 prefWidth="150"/>

                    <TableColumn fx:id="actualColumn"
                                 text="Actual Units"
                                 prefWidth="150"/>

                    <TableColumn fx:id="efficiencyColumn"
                                 text="Efficiency (%)"
                                 prefWidth="150"/>

                    <TableColumn fx:id="statusColumn"
                                 text="Status"
                                 prefWidth="140"/>

                </columns>

            </TableView>

            <Separator/>

            <!-- CEO Remarks -->
            <Label text="CEO Remarks"
                   style="-fx-font-size:18px; -fx-font-weight:bold;"/>

            <TextArea fx:id="remarksArea"
                      prefHeight="100"
                      wrapText="true"
                      promptText="Enter production observations or recommendations..."/>

            <HBox spacing="15">

                <Button fx:id="loadButton"
                        text="Load Data"
                        prefWidth="120"/>

                <Button fx:id="refreshButton"
                        text="Refresh"
                        prefWidth="120"/>

                <Button fx:id="exportButton"
                        text="Export Report"
                        prefWidth="150"/>

                <Button fx:id="backButton"
                        text="Back"
                        prefWidth="100"/>

            </HBox>

            <Label fx:id="statusLabel"
                   text="Ready"
                   style="-fx-text-fill:green; -fx-font-weight:bold;"/>

        </VBox>

    </children>

</AnchorPane>