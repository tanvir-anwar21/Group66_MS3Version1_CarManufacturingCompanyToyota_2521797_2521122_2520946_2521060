<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane prefHeight="650.0" prefWidth="1000.0"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1">

    <children>

        <VBox spacing="15"
              AnchorPane.topAnchor="15"
              AnchorPane.leftAnchor="15"
              AnchorPane.rightAnchor="15"
              AnchorPane.bottomAnchor="15">

            <padding>
                <Insets top="20" right="20" bottom="20" left="20"/>
            </padding>

            <!-- Title -->

            <Label text="Chief Executive Officer Dashboard"
                   style="-fx-font-size:24px;
                          -fx-font-weight:bold;" />

            <Separator/>

            <!-- Company Overview -->

            <GridPane hgap="15" vgap="15">

                <columnConstraints>
                    <ColumnConstraints percentWidth="25"/>
                    <ColumnConstraints percentWidth="25"/>
                    <ColumnConstraints percentWidth="25"/>
                    <ColumnConstraints percentWidth="25"/>
                </columnConstraints>

                <VBox spacing="5"
                      style="-fx-border-color:black;-fx-padding:10;">
                    <Label text="Production"/>
                    <TextField fx:id="productionField" editable="false"/>
                </VBox>

                <VBox GridPane.columnIndex="1"
                      spacing="5"
                      style="-fx-border-color:black;-fx-padding:10;">
                    <Label text="Sales"/>
                    <TextField fx:id="salesField" editable="false"/>
                </VBox>

                <VBox GridPane.columnIndex="2"
                      spacing="5"
                      style="-fx-border-color:black;-fx-padding:10;">
                    <Label text="Revenue"/>
                    <TextField fx:id="revenueField" editable="false"/>
                </VBox>

                <VBox GridPane.columnIndex="3"
                      spacing="5"
                      style="-fx-border-color:black;-fx-padding:10;">
                    <Label text="Employees"/>
                    <TextField fx:id="employeeField" editable="false"/>
                </VBox>

            </GridPane>

            <Separator/>

            <Label text="CEO Functions"
                   style="-fx-font-size:18px;
                          -fx-font-weight:bold;"/>

            <GridPane hgap="15" vgap="15">

                <columnConstraints>
                    <ColumnConstraints percentWidth="25"/>
                    <ColumnConstraints percentWidth="25"/>
                    <ColumnConstraints percentWidth="25"/>
                    <ColumnConstraints percentWidth="25"/>
                </columnConstraints>

                <Button fx:id="companyPerformanceButton"
                        prefHeight="45"
                        text="Company Performance"/>

                <Button fx:id="salesPerformanceButton"
                        GridPane.columnIndex="1"
                        prefHeight="45"
                        text="Sales Performance"/>

                <Button fx:id="productionPerformanceButton"
                        GridPane.columnIndex="2"
                        prefHeight="45"
                        text="Production Performance"/>

                <Button fx:id="budgetApprovalButton"
                        GridPane.columnIndex="3"
                        prefHeight="45"
                        text="Budget Approval"/>

                <Button fx:id="employeeStatisticsButton"
                        GridPane.rowIndex="1"
                        prefHeight="45"
                        text="Employee Statistics"/>

                <Button fx:id="customerFeedbackButton"
                        GridPane.columnIndex="1"
                        GridPane.rowIndex="1"
                        prefHeight="45"
                        text="Customer Feedback"/>

                <Button fx:id="financialSummaryButton"
                        GridPane.columnIndex="2"
                        GridPane.rowIndex="1"
                        prefHeight="45"
                        text="Financial Summary"/>

                <Button fx:id="executiveReportButton"
                        GridPane.columnIndex="3"
                        GridPane.rowIndex="1"
                        prefHeight="45"
                        text="Executive Report"/>

            </GridPane>

            <Separator/>

            <HBox spacing="20">

                <VBox spacing="10">

                    <Label text="Pending Budget Requests"
                           style="-fx-font-size:16px;-fx-font-weight:bold;"/>

                    <TextArea fx:id="budgetArea"
                              editable="false"
                              prefHeight="180"
                              prefWidth="300"/>

                </VBox>

                <VBox spacing="10">

                    <Label text="Recent Company Activities"
                           style="-fx-font-size:16px;-fx-font-weight:bold;"/>

                    <TextArea fx:id="activityArea"
                              editable="false"
                              prefHeight="180"
                              prefWidth="550"/>

                </VBox>

            </HBox>

            <Separator/>

            <HBox spacing="20">

                <Button fx:id="refreshButton"
                        text="Refresh Dashboard"
                        prefWidth="170"/>

                <Button fx:id="logoutButton"
                        text="Logout"
                        prefWidth="120"/>

            </HBox>

            <Label fx:id="statusLabel"
                   text="Dashboard Loaded Successfully"
                   style="-fx-text-fill:green;
                          -fx-font-weight:bold;"/>

        </VBox>

    </children>

</AnchorPane>