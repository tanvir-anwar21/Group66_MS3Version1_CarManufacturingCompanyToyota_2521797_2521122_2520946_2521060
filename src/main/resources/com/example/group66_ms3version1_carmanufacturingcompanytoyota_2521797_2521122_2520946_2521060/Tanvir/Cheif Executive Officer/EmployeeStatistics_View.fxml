<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane prefHeight="650.0" prefWidth="950.0"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1">

    <children>

        <VBox spacing="15"
              AnchorPane.topAnchor="15"
              AnchorPane.leftAnchor="15"
              AnchorPane.rightAnchor="15"
              AnchorPane.bottomAnchor="15">

            <padding>
                <Insets top="20" right="20" bottom="20" left="20"/>
            </padding>

            <!-- Title -->
            <Label text="Employee Statistics"
                   style="-fx-font-size:24px; -fx-font-weight:bold;"/>

            <Separator/>

            <!-- Employee Summary -->
            <GridPane hgap="15" vgap="15">

                <columnConstraints>
                    <ColumnConstraints percentWidth="25"/>
                    <ColumnConstraints percentWidth="25"/>
                    <ColumnConstraints percentWidth="25"/>
                    <ColumnConstraints percentWidth="25"/>
                </columnConstraints>

                <VBox spacing="5"
                      style="-fx-border-color:#BDBDBD; -fx-padding:10;">
                    <Label text="Total Employees"/>
                    <TextField fx:id="totalEmployeesField" editable="false"/>
                </VBox>

                <VBox GridPane.columnIndex="1"
                      spacing="5"
                      style="-fx-border-color:#BDBDBD; -fx-padding:10;">
                    <Label text="Departments"/>
                    <TextField fx:id="departmentCountField" editable="false"/>
                </VBox>

                <VBox GridPane.columnIndex="2"
                      spacing="5"
                      style="-fx-border-color:#BDBDBD; -fx-padding:10;">
                    <Label text="Average Attendance"/>
                    <TextField fx:id="attendanceField" editable="false"/>
                </VBox>

                <VBox GridPane.columnIndex="3"
                      spacing="5"
                      style="-fx-border-color:#BDBDBD; -fx-padding:10;">
                    <Label text="Average Performance"/>
                    <TextField fx:id="performanceField" editable="false"/>
                </VBox>

            </GridPane>

            <Separator/>

            <!-- Employee Statistics Table -->
            <Label text="Department-wise Employee Statistics"
                   style="-fx-font-size:18px; -fx-font-weight:bold;"/>

            <TableView fx:id="employeeTable" prefHeight="270">

                <columns>

                    <TableColumn fx:id="departmentColumn"
                                 text="Department"
                                 prefWidth="180"/>

                    <TableColumn fx:id="employeeCountColumn"
                                 text="Employees"
                                 prefWidth="140"/>

                    <TableColumn fx:id="attendanceColumn"
                                 text="Attendance %"
                                 prefWidth="150"/>

                    <TableColumn fx:id="performanceColumn"
                                 text="Performance"
                                 prefWidth="170"/>

                    <TableColumn fx:id="remarksColumn"
                                 text="Remarks"
                                 prefWidth="220"/>

                </columns>

            </TableView>

            <Separator/>

            <!-- CEO Notes -->
            <Label text="CEO Notes"
                   style="-fx-font-size:18px; -fx-font-weight:bold;"/>

            <TextArea fx:id="notesArea"
                      prefHeight="100"
                      wrapText="true"
                      promptText="Enter observations regarding employee performance..."/>

            <HBox spacing="15">

                <Button fx:id="loadButton"
                        text="Load Statistics"
                        prefWidth="140"/>

                <Button fx:id="refreshButton"
                        text="Refresh"
                        prefWidth="120"/>

                <Button fx:id="exportButton"
                        text="Export Report"
                        prefWidth="150"/>

                <Button fx:id="backButton"
                        text="Back"
                        prefWidth="100"/>

            </HBox>

            <Label fx:id="statusLabel"
                   text="Ready"
                   style="-fx-text-fill:green; -fx-font-weight:bold;"/>

        </VBox>

    </children>

</AnchorPane>