<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane style="-fx-background-color: linear-gradient(to bottom right, #1a237e, #0d47a1);" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Utility.LogInView_Controller">

    <children>

        <VBox spacing="18.0" style="-fx-background-color: white; -fx-background-radius: 15; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.3), 20, 0.5, 0, 5);" AnchorPane.bottomAnchor="25.0" AnchorPane.leftAnchor="35.0" AnchorPane.rightAnchor="35.0" AnchorPane.topAnchor="25.0">

            <padding>
                <Insets bottom="25.0" left="30.0" right="30.0" top="25.0" />
            </padding>

            <!-- Header with Icon Text -->
            <VBox alignment="CENTER" spacing="5.0">
                <Label style="-fx-font-size:22px; -fx-font-weight:bold; -fx-text-fill: #1a237e;" text="🏭 Toyota Manufacturing" />
                <Label style="-fx-font-size:13px; -fx-text-fill: #666666; -fx-font-weight:normal;" text="Car Production Management System" />
            </VBox>

            <Separator style="-fx-background-color: #e0e0e0;" />

            <Label style="-fx-font-size:17px; -fx-font-weight:bold; -fx-text-fill: #0d47a1;" text="🔐 System Login" />

            <GridPane hgap="15.0" style="-fx-padding: 5 0 5 0;" vgap="12.0">

                <columnConstraints>
                    <ColumnConstraints minWidth="100.0" prefWidth="120.0" />
                    <ColumnConstraints minWidth="200.0" prefWidth="280.0" />
                </columnConstraints>

                <rowConstraints>
                    <RowConstraints prefHeight="38.0" />
                    <RowConstraints prefHeight="38.0" />
                    <RowConstraints prefHeight="38.0" />
                    <RowConstraints prefHeight="38.0" />
                </rowConstraints>

                <Label style="-fx-font-weight:bold; -fx-text-fill: #333333;" text="👤 Employee ID" GridPane.columnIndex="0" GridPane.rowIndex="0" />

                <TextField fx:id="employeeIdField" prefWidth="280.0" promptText="Enter Employee ID" style="-fx-background-radius: 5; -fx-border-color: #bbdefb; -fx-border-radius: 5; -fx-padding: 8;" GridPane.columnIndex="1" GridPane.rowIndex="0" />

                <Label style="-fx-font-weight:bold; -fx-text-fill: #333333;" text="🔑 Password" GridPane.columnIndex="0" GridPane.rowIndex="1" />

                <PasswordField fx:id="passwordField" prefWidth="280.0" promptText="Enter Password" style="-fx-background-radius: 5; -fx-border-color: #bbdefb; -fx-border-radius: 5; -fx-padding: 8;" GridPane.columnIndex="1" GridPane.rowIndex="1" />

                <Label style="-fx-font-weight:bold; -fx-text-fill: #333333;" text="👔 User Role" GridPane.columnIndex="0" GridPane.rowIndex="2" />

                <ComboBox fx:id="roleComboBox" prefWidth="280.0" promptText="Select User Role" style="-fx-background-radius: 5; -fx-border-color: #bbdefb; -fx-border-radius: 5;" GridPane.columnIndex="1" GridPane.rowIndex="2" />

                <CheckBox fx:id="showPasswordCheckBox" style="-fx-text-fill: #555555;" text="👁 Show Password" GridPane.columnIndex="1" GridPane.rowIndex="3" />

            </GridPane>

            <Separator style="-fx-background-color: #e0e0e0;" />

            <HBox alignment="CENTER" spacing="20.0">

                <Button fx:id="loginButton" defaultButton="true" onAction="#handleLogin" prefHeight="38.0" prefWidth="130.0" style="-fx-background-color: #0d47a1; -fx-text-fill: white; -fx-font-weight:bold; -fx-font-size:14px; -fx-background-radius: 8;" text="Login" />

                <Button fx:id="clearButton" onAction="#handleClear" prefHeight="38.0" prefWidth="120.0" style="-fx-background-color: #e0e0e0; -fx-text-fill: #333333; -fx-font-weight:bold; -fx-font-size:14px; -fx-background-radius: 8;" text="Clear" />

            </HBox>

            <Separator style="-fx-background-color: #e0e0e0;" />

            <!-- Available Roles Section - All 8 User Headings -->
            <VBox spacing="8.0">
                <Label style="-fx-font-size:14px; -fx-font-weight:bold; -fx-text-fill: #0d47a1;" text="📋 Available User Roles" />

                <TextArea fx:id="availableUsersTextArea" editable="false" prefHeight="146.0" prefWidth="579.0" style="-fx-background-color: #f5f5f5; -fx-background-radius: 8; -fx-border-color: #e0e0e0; -fx-border-radius: 8; -fx-font-size:13px; -fx-font-family: 'Segoe UI', Arial, sans-serif;" text="👔 User-1: Chief Executive Officer (CEO)&#10;📋 User-2: Production Manager&#10;💰 User-3: Sales Executive&#10;👤 User-4: Human Resources Manager&#10;🔧 User-5: Automotive Engineer&#10;🔍 User-6: Vehicle Inspector&#10;🟣 User-7: Quality Control Manager&#10;🟢 User-8: Procurement Officer" wrapText="true" />
            </VBox>

            <!-- Status Label -->
            <Label fx:id="statusLabel" style="-fx-font-weight:bold; -fx-text-fill: #0d47a1; -fx-font-size:13px; -fx-padding: 5 0 0 0;" text="Please enter your login credentials." />

        </VBox>

    </children>

</AnchorPane>
