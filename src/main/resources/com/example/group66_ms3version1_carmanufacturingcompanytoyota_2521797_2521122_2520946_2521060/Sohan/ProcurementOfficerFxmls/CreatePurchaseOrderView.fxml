<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.collections.FXCollections?>

<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="Sohan.ProcurementOfficerControllers.CreatePurchaseOrderView_Controller"
            prefWidth="900"
            prefHeight="600">

    <top>
        <HBox alignment="CENTER_LEFT"
              spacing="15"
              style="-fx-padding:15 20; -fx-background-color:#1B5E20;">

            <Label text="📦 Create Purchase Order"
                   style="-fx-text-fill:white; -fx-font-size:22px; -fx-font-weight:bold;"/>

            <Region HBox.hgrow="ALWAYS"/>

            <Button text="⬅ Back to Dashboard"
                    onAction="#handleBackToDashboard"
                    style="-fx-background-color:#e74c3c; -fx-text-fill:white;"/>

        </HBox>
    </top>

    <center>
        <VBox alignment="TOP_CENTER"
              spacing="20"
              style="-fx-padding:30;">

            <Label text="Create New Purchase Order"
                   style="-fx-font-size:24px; -fx-font-weight:bold;"/>

            <GridPane hgap="20"
                      vgap="15"
                      alignment="CENTER">

                <Label text="Supplier:"
                       GridPane.columnIndex="0"
                       GridPane.rowIndex="0"
                       style="-fx-font-weight:bold;"/>

                <ComboBox fx:id="supplierCombo"
                          prefWidth="250"
                          promptText="Select Supplier"
                          GridPane.columnIndex="1"
                          GridPane.rowIndex="0"/>

                <Label text="Material:"
                       GridPane.columnIndex="0"
                       GridPane.rowIndex="1"
                       style="-fx-font-weight:bold;"/>

                <ComboBox fx:id="materialCombo"
                          prefWidth="250"
                          promptText="Select Material"
                          GridPane.columnIndex="1"
                          GridPane.rowIndex="1"/>

                <Label text="Quantity:"
                       GridPane.columnIndex="0"
                       GridPane.rowIndex="2"
                       style="-fx-font-weight:bold;"/>

                <TextField fx:id="quantityField"
                           prefWidth="250"
                           promptText="Enter Quantity"
                           GridPane.columnIndex="1"
                           GridPane.rowIndex="2"/>

                <Label text="Delivery Date:"
                       GridPane.columnIndex="0"
                       GridPane.rowIndex="3"
                       style="-fx-font-weight:bold;"/>

                <DatePicker fx:id="deliveryDatePicker"
                            prefWidth="250"
                            promptText="Select Delivery Date"
                            GridPane.columnIndex="1"
                            GridPane.rowIndex="3"/>

                <Label text="Order Reference:"
                       GridPane.columnIndex="0"
                       GridPane.rowIndex="4"
                       style="-fx-font-weight:bold;"/>

                <TextField fx:id="orderRefField"
                           prefWidth="250"
                           promptText="Enter Reference (Optional)"
                           GridPane.columnIndex="1"
                           GridPane.rowIndex="4"/>

                <Label text="Priority:"
                       GridPane.columnIndex="0"
                       GridPane.rowIndex="5"
                       style="-fx-font-weight:bold;"/>

                <HBox spacing="15"
                      GridPane.columnIndex="1"
                      GridPane.rowIndex="5">
                    <RadioButton fx:id="normalPriorityRadio"
                                 text="Normal"
                                 selected="true">
                        <toggleGroup>
                            <ToggleGroup fx:id="priorityGroup"/>
                        </toggleGroup>
                    </RadioButton>
                    <RadioButton fx:id="urgentPriorityRadio"
                                 text="Urgent"
                                 toggleGroup="$priorityGroup"/>
                    <RadioButton fx:id="criticalPriorityRadio"
                                 text="Critical"
                                 toggleGroup="$priorityGroup"/>
                </HBox>

                <HBox spacing="10"
                      GridPane.columnIndex="1"
                      GridPane.rowIndex="6">
                    <CheckBox fx:id="insuranceCheckBox"
                              text="Include Insurance"/>
                    <CheckBox fx:id="expressDeliveryCheckBox"
                              text="Express Delivery"/>
                </HBox>

            </GridPane>

            <HBox spacing="20"
                  alignment="CENTER">
                <Button text="📝 Create Purchase Order"
                        onAction="#handleCreatePurchaseOrder"
                        prefWidth="250"
                        prefHeight="50"
                        style="-fx-background-color:#388E3C; -fx-text-fill:white; -fx-font-size:14px; -fx-font-weight:bold;"/>

                <Button text="🔄 Clear All"
                        onAction="#handleClear"
                        prefWidth="150"
                        prefHeight="50"
                        style="-fx-background-color:#F57C00; -fx-text-fill:white; -fx-font-size:14px;"/>
            </HBox>

            <Label fx:id="statusLabel"
                   style="-fx-font-size:14px; -fx-font-weight:bold;"
                   text="Ready to create order"/>

        </VBox>
    </center>

</BorderPane>