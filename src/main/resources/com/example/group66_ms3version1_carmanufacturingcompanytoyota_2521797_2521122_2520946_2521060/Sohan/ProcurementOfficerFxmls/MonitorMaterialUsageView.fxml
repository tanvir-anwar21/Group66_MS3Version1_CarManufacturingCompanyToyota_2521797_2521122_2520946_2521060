<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.control.cell.PropertyValueFactory?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.collections.FXCollections?>

<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="Sohan.ProcurementOfficerControllers.MonitorMaterialUsageView_Controller"
            prefWidth="1000"
            prefHeight="700">

    <top>
        <HBox alignment="CENTER_LEFT"
              spacing="15"
              style="-fx-padding:15 20; -fx-background-color:#1B5E20;">

            <Label text="📊 Monitor Material Usage"
                   style="-fx-text-fill:white; -fx-font-size:22px; -fx-font-weight:bold;"/>

            <Region HBox.hgrow="ALWAYS"/>

            <Button text="⬅ Back to Dashboard"
                    onAction="#handleBackToDashboard"
                    style="-fx-background-color:#e74c3c; -fx-text-fill:white;"/>

        </HBox>
    </top>

    <center>
        <VBox alignment="TOP_CENTER"
              spacing="15"
              style="-fx-padding:20;">

            <Label text="Monitor Raw Material Consumption and Inventory"
                   style="-fx-font-size:18px;"/>

            <!-- Filter Section -->
            <GridPane hgap="15"
                      vgap="10"
                      style="-fx-padding:10; -fx-background-color:#f5f5f5; -fx-border-color:#ddd;">

                <Label text="Material Type:"
                       GridPane.columnIndex="0"
                       GridPane.rowIndex="0"
                       style="-fx-font-weight:bold;"/>

                <ComboBox fx:id="materialTypeCombo"
                          prefWidth="200"
                          promptText="All Materials"
                          GridPane.columnIndex="1"
                          GridPane.rowIndex="0"/>

                <Label text="Date Range:"
                       GridPane.columnIndex="2"
                       GridPane.rowIndex="0"
                       style="-fx-font-weight:bold;"/>

                <DatePicker fx:id="startDatePicker"
                            prefWidth="150"
                            promptText="Start Date"
                            GridPane.columnIndex="3"
                            GridPane.rowIndex="0"/>

                <DatePicker fx:id="endDatePicker"
                            prefWidth="150"
                            promptText="End Date"
                            GridPane.columnIndex="4"
                            GridPane.rowIndex="0"/>

                <Label text="Category:"
                       GridPane.columnIndex="0"
                       GridPane.rowIndex="1"
                       style="-fx-font-weight:bold;"/>

                <ComboBox fx:id="categoryCombo"
                          prefWidth="200"
                          promptText="All Categories"
                          GridPane.columnIndex="1"
                          GridPane.rowIndex="1"/>

                <Button text="🔍 Apply Filters"
                        onAction="#handleApplyFilters"
                        prefWidth="120"
                        GridPane.columnIndex="3"
                        GridPane.rowIndex="1"
                        style="-fx-background-color:#1976D2; -fx-text-fill:white;"/>

                <Button text="🔄 Reset"
                        onAction="#handleReset"
                        prefWidth="100"
                        GridPane.columnIndex="4"
                        GridPane.rowIndex="1"
                        style="-fx-background-color:#F57C00; -fx-text-fill:white;"/>

            </GridPane>

            <!-- Material Usage Table -->
            <TableView fx:id="materialUsageTableView"
                       prefHeight="300"
                       prefWidth="960">

                <columns>
                    <TableColumn text="Material ID"
                                 prefWidth="100">
                        <cellValueFactory>
                            <PropertyValueFactory property="materialID"/>
                        </cellValueFactory>
                    </TableColumn>
                    <TableColumn text="Material Type"
                                 prefWidth="130">
                        <cellValueFactory>
                            <PropertyValueFactory property="materialType"/>
                        </cellValueFactory>
                    </TableColumn>
                    <TableColumn text="Category"
                                 prefWidth="120">
                        <cellValueFactory>
                            <PropertyValueFactory property="category"/>
                        </cellValueFactory>
                    </TableColumn>
                    <TableColumn text="Quantity Used"
                                 prefWidth="120">
                        <cellValueFactory>
                            <PropertyValueFactory property="quantityUsed"/>
                        </cellValueFactory>
                    </TableColumn>
                    <TableColumn text="Remaining Stock"
                                 prefWidth="130">
                        <cellValueFactory>
                            <PropertyValueFactory property="remainingStock"/>
                        </cellValueFactory>
                    </TableColumn>
                    <TableColumn text="Usage Date"
                                 prefWidth="130">
                        <cellValueFactory>
                            <PropertyValueFactory property="usageDate"/>
                        </cellValueFactory>
                    </TableColumn>
                    <TableColumn text="Department"
                                 prefWidth="120">
                        <cellValueFactory>
                            <PropertyValueFactory property="department"/>
                        </cellValueFactory>
                    </TableColumn>
                    <TableColumn text="Status"
                                 prefWidth="110">
                        <cellValueFactory>
                            <PropertyValueFactory property="status"/>
                        </cellValueFactory>
                    </TableColumn>
                </columns>

            </TableView>

            <!-- Summary Statistics -->
            <GridPane hgap="20"
                      vgap="5"
                      style="-fx-padding:10; -fx-background-color:#e8f5e9; -fx-border-color:#a5d6a7;">

                <Label text="Summary Statistics"
                       GridPane.columnIndex="0"
                       GridPane.rowIndex="0"
                       GridPane.columnSpan="4"
                       style="-fx-font-size:14px; -fx-font-weight:bold;"/>

                <Label text="Total Materials Used:"
                       GridPane.columnIndex="0"
                       GridPane.rowIndex="1"
                       style="-fx-font-weight:bold;"/>

                <Label fx:id="totalUsedLabel"
                       text="0"
                       GridPane.columnIndex="1"
                       GridPane.rowIndex="1"
                       style="-fx-text-fill:#1B5E20; -fx-font-weight:bold;"/>

                <Label text="Average Consumption:"
                       GridPane.columnIndex="2"
                       GridPane.rowIndex="1"
                       style="-fx-font-weight:bold;"/>

                <Label fx:id="avgConsumptionLabel"
                       text="0"
                       GridPane.columnIndex="3"
                       GridPane.rowIndex="1"
                       style="-fx-text-fill:#1B5E20; -fx-font-weight:bold;"/>

                <Label text="Low Stock Items:"
                       GridPane.columnIndex="0"
                       GridPane.rowIndex="2"
                       style="-fx-font-weight:bold;"/>

                <Label fx:id="lowStockLabel"
                       text="0"
                       GridPane.columnIndex="1"
                       GridPane.rowIndex="2"
                       style="-fx-text-fill:#D32F2F; -fx-font-weight:bold;"/>

                <Label text="Projected Shortage:"
                       GridPane.columnIndex="2"
                       GridPane.rowIndex="2"
                       style="-fx-font-weight:bold;"/>

                <Label fx:id="shortageLabel"
                       text="None"
                       GridPane.columnIndex="3"
                       GridPane.rowIndex="2"
                       style="-fx-text-fill:#FF9800; -fx-font-weight:bold;"/>

            </GridPane>

            <!-- Action Buttons -->
            <HBox spacing="20"
                  alignment="CENTER">
                <Button text="📊 Generate Usage Report"
                        onAction="#handleGenerateReport"
                        prefWidth="200"
                        prefHeight="40"
                        style="-fx-background-color:#388E3C; -fx-text-fill:white; -fx-font-size:14px; -fx-font-weight:bold;"/>

                <Button text="📈 Export to Excel"
                        onAction="#handleExportExcel"
                        prefWidth="200"
                        prefHeight="40"
                        style="-fx-background-color:#1976D2; -fx-text-fill:white; -fx-font-size:14px;"/>

                <Button text="🔄 Refresh Data"
                        onAction="#handleRefresh"
                        prefWidth="150"
                        prefHeight="40"
                        style="-fx-background-color:#F57C00; -fx-text-fill:white; -fx-font-size:14px;"/>
            </HBox>

            <Label fx:id="statusLabel"
                   style="-fx-font-size:14px; -fx-font-weight:bold;"
                   text="Select filters and click Apply to view material usage"/>

        </VBox>
    </center>

</BorderPane>