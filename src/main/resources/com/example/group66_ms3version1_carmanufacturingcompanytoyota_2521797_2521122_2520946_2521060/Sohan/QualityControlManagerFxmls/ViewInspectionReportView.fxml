<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.control.cell.PropertyValueFactory?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="Sohan.QualityControlManagerControllers.ViewInspectionReportView_Controller"
            prefWidth="1000"
            prefHeight="650">

    <top>
        <HBox alignment="CENTER_LEFT"
              spacing="15"
              style="-fx-padding:15 20; -fx-background-color:#4A148C;">

            <Label text="📄 View Inspection Report"
                   style="-fx-text-fill:white; -fx-font-size:22px; -fx-font-weight:bold;"/>

            <Region HBox.hgrow="ALWAYS"/>

            <Button text="⬅ Back to Dashboard"
                    onAction="#handleBackToDashboard"
                    style="-fx-background-color:#e74c3c; -fx-text-fill:white;"/>

        </HBox>
    </top>

    <center>
        <VBox alignment="TOP_CENTER"
              spacing="15"
              style="-fx-padding:20;">

            <Label text="Inspection Report Viewer"
                   style="-fx-font-size:24px; -fx-font-weight:bold;"/>

            <HBox spacing="15"
                  alignment="CENTER_LEFT"
                  style="-fx-padding:10; -fx-background-color:#f5f5f5; -fx-border-color:#ddd;">

                <Label text="Report Date:"
                       style="-fx-font-weight:bold;"/>

                <DatePicker fx:id="reportDatePicker"
                            prefWidth="150"
                            promptText="Select Date"/>

                <Label text="Vehicle Model:"
                       style="-fx-font-weight:bold;"/>

                <ComboBox fx:id="modelCombo"
                          prefWidth="150"
                          promptText="All Models"/>

                <Label text="Status:"
                       style="-fx-font-weight:bold;"/>

                <ComboBox fx:id="statusFilterCombo"
                          prefWidth="150"
                          promptText="All Status"/>

                <Button text="🔍 View Report"
                        onAction="#handleViewReport"
                        style="-fx-background-color:#1976D2; -fx-text-fill:white;"/>

                <Button text="🔄 Refresh"
                        onAction="#handleRefresh"
                        style="-fx-background-color:#F57C00; -fx-text-fill:white;"/>

            </HBox>

            <TableView fx:id="inspectionReportTableView"
                       prefHeight="350"
                       prefWidth="960">

                <columns>
                    <TableColumn text="Report ID"
                                 prefWidth="100">
                        <cellValueFactory>
                            <PropertyValueFactory property="reportID"/>
                        </cellValueFactory>
                    </TableColumn>
                    <TableColumn text="Vehicle ID"
                                 prefWidth="120">
                        <cellValueFactory>
                            <PropertyValueFactory property="vehicleID"/>
                        </cellValueFactory>
                    </TableColumn>
                    <TableColumn text="Model"
                                 prefWidth="120">
                        <cellValueFactory>
                            <PropertyValueFactory property="model"/>
                        </cellValueFactory>
                    </TableColumn>
                    <TableColumn text="Inspector"
                                 prefWidth="140">
                        <cellValueFactory>
                            <PropertyValueFactory property="inspector"/>
                        </cellValueFactory>
                    </TableColumn>
                    <TableColumn text="Date"
                                 prefWidth="130">
                        <cellValueFactory>
                            <PropertyValueFactory property="date"/>
                        </cellValueFactory>
                    </TableColumn>
                    <TableColumn text="Engine"
                                 prefWidth="80">
                        <cellValueFactory>
                            <PropertyValueFactory property="engineStatus"/>
                        </cellValueFactory>
                    </TableColumn>
                    <TableColumn text="Body"
                                 prefWidth="80">
                        <cellValueFactory>
                            <PropertyValueFactory property="bodyStatus"/>
                        </cellValueFactory>
                    </TableColumn>
                    <TableColumn text="Paint"
                                 prefWidth="80">
                        <cellValueFactory>
                            <PropertyValueFactory property="paintStatus"/>
                        </cellValueFactory>
                    </TableColumn>
                    <TableColumn text="Overall"
                                 prefWidth="100">
                        <cellValueFactory>
                            <PropertyValueFactory property="overallStatus"/>
                        </cellValueFactory>
                    </TableColumn>
                </columns>

            </TableView>

            <GridPane hgap="15"
                      vgap="10"
                      style="-fx-padding:10; -fx-background-color:#f3e5f5; -fx-border-color:#ce93d8;">

                <Label text="Selected Report Details:"
                       GridPane.columnIndex="0"
                       GridPane.rowIndex="0"
                       style="-fx-font-weight:bold;"/>

                <Label fx:id="selectedReportLabel"
                       text="No report selected"
                       GridPane.columnIndex="0"
                       GridPane.rowIndex="1"
                       GridPane.columnSpan="4"/>

                <Button text="📄 View Full Report"
                        onAction="#handleViewFullReport"
                        GridPane.columnIndex="4"
                        GridPane.rowIndex="1"
                        style="-fx-background-color:#1976D2; -fx-text-fill:white;"/>

                <Button text="🖨️ Print Report"
                        onAction="#handlePrintReport"
                        GridPane.columnIndex="4"
                        GridPane.rowIndex="2"
                        style="-fx-background-color:#388E3C; -fx-text-fill:white;"/>

                <Button text="📊 Export PDF"
                        onAction="#handleExportPDF"
                        GridPane.columnIndex="4"
                        GridPane.rowIndex="3"
                        style="-fx-background-color:#F57C00; -fx-text-fill:white;"/>

            </GridPane>

            <HBox spacing="15"
                  alignment="CENTER_LEFT"
                  style="-fx-padding:5 10;">

                <Label fx:id="recordCountLabel"
                       text="Total Reports: 0"/>

                <Region HBox.hgrow="ALWAYS"/>

                <Label fx:id="statusLabel"
                       text="Ready"/>

            </HBox>

        </VBox>
    </center>

</BorderPane>