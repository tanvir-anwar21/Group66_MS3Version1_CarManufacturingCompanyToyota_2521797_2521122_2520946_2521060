<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="Sohan.QualityControlManagerControllers.QualityControlManagerView_Controller"
            prefWidth="1000"
            prefHeight="650">

    <top>
        <HBox alignment="CENTER_LEFT"
              spacing="15"
              style="-fx-padding:15 20; -fx-background-color:#4A148C;">

            <Label text="🏢 Toyota Manufacturing System"
                   style="-fx-text-fill:white; -fx-font-size:22px; -fx-font-weight:bold;"/>

            <Region HBox.hgrow="ALWAYS"/>

            <Label fx:id="userLabel"
                   text="Quality Control Manager"
                   style="-fx-text-fill:white;"/>

        </HBox>
    </top>

    <center>

        <VBox alignment="TOP_CENTER"
              spacing="25"
              style="-fx-padding:30;">

            <Label text="Quality Control Manager Dashboard"
                   style="-fx-font-size:26px; -fx-font-weight:bold;"/>

            <GridPane hgap="25"
                      vgap="25"
                      alignment="CENTER">

                <!-- Goal 1: Check Car Quality -->
                <Button text="🔍&#10;Check Car Quality"
                        prefWidth="220"
                        prefHeight="90"
                        onAction="#handleCheckCarQuality"
                        GridPane.columnIndex="0"
                        GridPane.rowIndex="0"/>

                <!-- Goal 2: Add Defect Information -->
                <Button text="⚠️&#10;Add Defect Information"
                        prefWidth="220"
                        prefHeight="90"
                        onAction="#handleAddDefectInformation"
                        GridPane.columnIndex="1"
                        GridPane.rowIndex="0"/>

                <!-- Goal 3: View Inspection Report -->
                <Button text="📄&#10;View Inspection Report"
                        prefWidth="220"
                        prefHeight="90"
                        onAction="#handleViewInspectionReport"
                        GridPane.columnIndex="2"
                        GridPane.rowIndex="0"/>

                <!-- Goal 4: Approve Cars for Delivery -->
                <Button text="✅&#10;Approve Cars for Delivery"
                        prefWidth="220"
                        prefHeight="90"
                        onAction="#handleApproveCarsForDelivery"
                        GridPane.columnIndex="0"
                        GridPane.rowIndex="1"/>

                <!-- Goal 5: Monitor Quality Statistics -->
                <Button text="📊&#10;Monitor Quality Statistics"
                        prefWidth="220"
                        prefHeight="90"
                        onAction="#handleMonitorQualityStatistics"
                        GridPane.columnIndex="1"
                        GridPane.rowIndex="1"/>

                <!-- Goal 6: Schedule Re-Inspection -->
                <Button text="🔄&#10;Schedule Re-Inspection"
                        prefWidth="220"
                        prefHeight="90"
                        onAction="#handleScheduleReInspection"
                        GridPane.columnIndex="2"
                        GridPane.rowIndex="1"/>

                <!-- Goal 7: Print Quality Report -->
                <Button text="🖨️&#10;Print Quality Report"
                        prefWidth="220"
                        prefHeight="90"
                        onAction="#handlePrintQualityReport"
                        GridPane.columnIndex="0"
                        GridPane.rowIndex="2"/>

                <!-- Goal 8: Review Worker Performance -->
                <Button text="👷&#10;Review Worker Performance"
                        prefWidth="220"
                        prefHeight="90"
                        onAction="#handleReviewWorkerPerformance"
                        GridPane.columnIndex="1"
                        GridPane.rowIndex="2"/>

                <!-- Logout Button -->
                <Button text="🚪&#10;Logout"
                        prefWidth="220"
                        prefHeight="90"
                        onAction="#handleLogout"
                        style="-fx-background-color:#e74c3c; -fx-text-fill:white;"
                        GridPane.columnIndex="2"
                        GridPane.rowIndex="2"/>

            </GridPane>

        </VBox>

    </center>

</BorderPane>