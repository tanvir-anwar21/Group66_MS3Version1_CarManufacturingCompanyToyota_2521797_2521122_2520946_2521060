<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="Sohan.QualityControlManagerControllers.ScheduleReInspectionView_Controller"
            prefWidth="1000" prefHeight="650">

    <top>
        <HBox alignment="CENTER_LEFT" spacing="15" style="-fx-padding: 15 20; -fx-background-color: #2c3e50;">
            <Button text="← Back to Dashboard" onAction="#handleBack" style="-fx-background-color: #34495e; -fx-text-fill: white;"/>
            <Label text="🔄 Schedule Re-Inspection" style="-fx-text-fill: white; -fx-font-size: 20px; -fx-font-weight: bold;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="userLabel" text="QC Manager: " style="-fx-text-fill: #bdc3c7;"/>
        </HBox>
    </top>

    <center>
        <VBox spacing="15" style="-fx-padding: 20;">

            <GridPane hgap="15" vgap="10" style="-fx-padding: 15; -fx-background-color: #ecf0f1; -fx-border-color: #bdc3c7; -fx-border-radius: 5;">
                <Label text="Vehicle ID:" GridPane.columnIndex="0" GridPane.rowIndex="0" style="-fx-font-weight: bold;"/>
                <TextField fx:id="vehicleIdField" GridPane.columnIndex="1" GridPane.rowIndex="0" promptText="Enter Vehicle ID"/>
                <Button text="🔍 Search" onAction="#handleSearch" GridPane.columnIndex="2" GridPane.rowIndex="0" style="-fx-background-color: #3498db; -fx-text-fill: white;"/>

                <Label text="OR Select Failed Vehicle:" GridPane.columnIndex="3" GridPane.rowIndex="0" style="-fx-font-weight: bold;"/>
                <ComboBox fx:id="failedVehiclesCombo" GridPane.columnIndex="4" GridPane.rowIndex="0" promptText="Select vehicle" prefWidth="200"/>
                <Button text="Load" onAction="#handleLoadFailed" GridPane.columnIndex="5" GridPane.rowIndex="0" style="-fx-background-color: #2ecc71; -fx-text-fill: white;"/>
            </GridPane>

            <TitledPane text="Vehicle Information" expanded="true">
                <GridPane hgap="15" vgap="10" style="-fx-padding: 15;">
                    <Label text="Vehicle ID:" GridPane.columnIndex="0" GridPane.rowIndex="0" style="-fx-font-weight: bold;"/>
                    <Label fx:id="vehicleIdDisplay" text="-" GridPane.columnIndex="1" GridPane.rowIndex="0"/>

                    <Label text="Model:" GridPane.columnIndex="0" GridPane.rowIndex="1" style="-fx-font-weight: bold;"/>
                    <Label fx:id="modelDisplay" text="-" GridPane.columnIndex="1" GridPane.rowIndex="1"/>

                    <Label text="VIN:" GridPane.columnIndex="2" GridPane.rowIndex="0" style="-fx-font-weight: bold;"/>
                    <Label fx:id="vinDisplay" text="-" GridPane.columnIndex="3" GridPane.rowIndex="0"/>

                    <Label text="Previous Inspection Date:" GridPane.columnIndex="2" GridPane.rowIndex="1" style="-fx-font-weight: bold;"/>
                    <Label fx:id="prevInspectionDateDisplay" text="-" GridPane.columnIndex="3" GridPane.rowIndex="1"/>

                    <Label text="Previous Result:" GridPane.columnIndex="0" GridPane.rowIndex="2" style="-fx-font-weight: bold;"/>
                    <Label fx:id="prevResultDisplay" text="-" GridPane.columnIndex="1" GridPane.rowIndex="2" style="-fx-text-fill: #e74c3c;"/>

                    <Label text="Failure Reason:" GridPane.columnIndex="0" GridPane.rowIndex="3" style="-fx-font-weight: bold;"/>
                    <Label fx:id="failureReasonDisplay" text="-" GridPane.columnIndex="1" GridPane.rowIndex="3" GridPane.columnSpan="3"/>
                </GridPane>
            </TitledPane>

            <TitledPane text="Re-Inspection Schedule" expanded="true">
                <GridPane hgap="15" vgap="10" style="-fx-padding: 15;">
                    <Label text="Scheduled Date:" GridPane.columnIndex="0" GridPane.rowIndex="0" style="-fx-font-weight: bold;"/>
                    <DatePicker fx:id="scheduledDatePicker" GridPane.columnIndex="1" GridPane.rowIndex="0"/>

                    <Label text="Scheduled Time:" GridPane.columnIndex="0" GridPane.rowIndex="1" style="-fx-font-weight: bold;"/>
                    <ComboBox fx:id="timeCombo" GridPane.columnIndex="1" GridPane.rowIndex="1" promptText="Select time">
                    </ComboBox>

                    <Label text="Assigned Inspector:" GridPane.columnIndex="0" GridPane.rowIndex="2" style="-fx-font-weight: bold;"/>
                    <ComboBox fx:id="inspectorCombo" GridPane.columnIndex="1" GridPane.rowIndex="2" promptText="Select inspector">
                    </ComboBox>

                    <Label text="Priority:" GridPane.columnIndex="0" GridPane.rowIndex="3" style="-fx-font-weight: bold;"/>
                    <RadioButton fx:id="highPriorityRadio" text="🔴 High" GridPane.columnIndex="1" GridPane.rowIndex="3">
                        <toggleGroup><ToggleGroup fx:id="priorityGroup"/></toggleGroup>
                    </RadioButton>
                    <RadioButton fx:id="mediumPriorityRadio" text="🟠 Medium" GridPane.columnIndex="2" GridPane.rowIndex="3" selected="true">
                        <toggleGroup><ToggleGroup fx:id="priorityGroup"/></toggleGroup>
                    </RadioButton>
                    <RadioButton fx:id="lowPriorityRadio" text="🟢 Low" GridPane.columnIndex="3" GridPane.rowIndex="3">
                        <toggleGroup><ToggleGroup fx:id="priorityGroup"/></toggleGroup>
                    </RadioButton>
                </GridPane>
            </TitledPane>

            <HBox spacing="15" alignment="CENTER">
                <Button text="✅ Schedule Re-Inspection" onAction="#handleSchedule" style="-fx-background-color: #2ecc71; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 10 30;"/>
                <Button text="❌ Cancel" onAction="#handleCancel" style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-padding: 10 30;"/>
                <Button text="📋 View Scheduled" onAction="#handleViewScheduled" style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-padding: 10 30;"/>
            </HBox>

            <Label fx:id="statusMessage" text="" style="-fx-text-fill: #2c3e50; -fx-font-weight: bold;"/>
        </VBox>
    </center>
</BorderPane>