<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="Sohan.QualityControlManagerControllers.AddDefectInformationView_Controller"
            prefWidth="900"
            prefHeight="650">

    <top>
        <HBox alignment="CENTER_LEFT"
              spacing="15"
              style="-fx-padding:15 20; -fx-background-color:#4A148C;">

            <Label text="⚠️ Add Defect Information"
                   style="-fx-text-fill:white; -fx-font-size:22px; -fx-font-weight:bold;"/>

            <Region HBox.hgrow="ALWAYS"/>

            <Button text="⬅ Back to Dashboard"
                    onAction="#handleBackToDashboard"
                    style="-fx-background-color:#e74c3c; -fx-text-fill:white;"/>

        </HBox>
    </top>

    <center>
        <VBox alignment="TOP_CENTER"
              spacing="20"
              style="-fx-padding:30;">

            <Label text="Report Vehicle Defect"
                   style="-fx-font-size:24px; -fx-font-weight:bold;"/>

            <GridPane hgap="20"
                      vgap="15"
                      alignment="CENTER">

                <Label text="Vehicle ID: *"
                       GridPane.columnIndex="0"
                       GridPane.rowIndex="0"
                       style="-fx-font-weight:bold;"/>

                <TextField fx:id="vehicleIdField"
                           prefWidth="300"
                           promptText="Enter Vehicle ID"
                           GridPane.columnIndex="1"
                           GridPane.rowIndex="0"/>

                <Label text="Defect Category: *"
                       GridPane.columnIndex="0"
                       GridPane.rowIndex="1"
                       style="-fx-font-weight:bold;"/>

                <ComboBox fx:id="defectCategoryCombo"
                          prefWidth="300"
                          promptText="Select Defect Category"
                          GridPane.columnIndex="1"
                          GridPane.rowIndex="1"/>

                <Label text="Part Information: *"
                       GridPane.columnIndex="0"
                       GridPane.rowIndex="2"
                       style="-fx-font-weight:bold;"/>

                <TextField fx:id="partInfoField"
                           prefWidth="300"
                           promptText="Enter Part Name or Number"
                           GridPane.columnIndex="1"
                           GridPane.rowIndex="2"/>

                <Label text="Defect Description: *"
                       GridPane.columnIndex="0"
                       GridPane.rowIndex="3"
                       style="-fx-font-weight:bold;"/>

                <TextArea fx:id="defectDescriptionArea"
                          prefWidth="300"
                          prefHeight="80"
                          promptText="Describe the defect in detail..."
                          GridPane.columnIndex="1"
                          GridPane.rowIndex="3"/>

                <Label text="Severity:"
                       GridPane.columnIndex="0"
                       GridPane.rowIndex="4"
                       style="-fx-font-weight:bold;"/>

                <HBox spacing="15"
                      GridPane.columnIndex="1"
                      GridPane.rowIndex="4">
                    <RadioButton fx:id="lowSeverityRadio"
                                 text="Low">
                        <toggleGroup>
                            <ToggleGroup fx:id="severityGroup"/>
                        </toggleGroup>
                    </RadioButton>
                    <RadioButton fx:id="mediumSeverityRadio"
                                 text="Medium"
                                 selected="true"
                                 toggleGroup="$severityGroup"/>
                    <RadioButton fx:id="highSeverityRadio"
                                 text="High"
                                 toggleGroup="$severityGroup"/>
                    <RadioButton fx:id="criticalSeverityRadio"
                                 text="Critical"
                                 toggleGroup="$severityGroup"/>
                </HBox>

                <Label text="Detected By:"
                       GridPane.columnIndex="0"
                       GridPane.rowIndex="5"
                       style="-fx-font-weight:bold;"/>

                <TextField fx:id="detectedByField"
                           prefWidth="300"
                           promptText="Enter Inspector Name"
                           GridPane.columnIndex="1"
                           GridPane.rowIndex="5"/>

                <Label text="Detection Date:"
                       GridPane.columnIndex="0"
                       GridPane.rowIndex="6"
                       style="-fx-font-weight:bold;"/>

                <DatePicker fx:id="detectionDatePicker"
                            prefWidth="300"
                            promptText="Select Detection Date"
                            GridPane.columnIndex="1"
                            GridPane.rowIndex="6"/>

                <Label text="Status:"
                       GridPane.columnIndex="0"
                       GridPane.rowIndex="7"
                       style="-fx-font-weight:bold;"/>

                <ComboBox fx:id="statusCombo"
                          prefWidth="300"
                          promptText="Select Status"
                          GridPane.columnIndex="1"
                          GridPane.rowIndex="7"/>

                <CheckBox fx:id="urgentCheckBox"
                          text="⚠ Mark as Urgent"
                          GridPane.columnIndex="1"
                          GridPane.rowIndex="8"/>

            </GridPane>

            <HBox spacing="20"
                  alignment="CENTER">
                <Button text="➕ Add Defect"
                        onAction="#handleAddDefect"
                        prefWidth="200"
                        prefHeight="50"
                        style="-fx-background-color:#388E3C; -fx-text-fill:white; -fx-font-size:14px; -fx-font-weight:bold;"/>

                <Button text="🔄 Clear Form"
                        onAction="#handleClear"
                        prefWidth="150"
                        prefHeight="50"
                        style="-fx-background-color:#F57C00; -fx-text-fill:white; -fx-font-size:14px;"/>
            </HBox>

            <Label fx:id="statusLabel"
                   style="-fx-font-size:14px; -fx-font-weight:bold;"
                   text="Fill in the defect details and click Add Defect"/>

        </VBox>
    </center>

</BorderPane>