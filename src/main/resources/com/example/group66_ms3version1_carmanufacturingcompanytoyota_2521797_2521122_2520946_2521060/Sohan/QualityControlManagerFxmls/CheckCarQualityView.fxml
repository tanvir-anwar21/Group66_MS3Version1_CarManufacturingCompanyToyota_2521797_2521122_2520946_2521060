<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="Sohan.QualityControlManagerControllers.CheckCarQualityView_Controller"
            prefWidth="900"
            prefHeight="650">

    <top>
        <HBox alignment="CENTER_LEFT"
              spacing="15"
              style="-fx-padding:15 20; -fx-background-color:#4A148C;">

            <Label text="🔍 Check Car Quality"
                   style="-fx-text-fill:white; -fx-font-size:22px; -fx-font-weight:bold;"/>

            <Region HBox.hgrow="ALWAYS"/>

            <Button text="⬅ Back to Dashboard"
                    onAction="#handleBackToDashboard"
                    style="-fx-background-color:#e74c3c; -fx-text-fill:white;"/>

        </HBox>
    </top>

    <center>
        <VBox alignment="TOP_CENTER"
              spacing="20"
              style="-fx-padding:30;">

            <Label text="Vehicle Quality Inspection"
                   style="-fx-font-size:24px; -fx-font-weight:bold;"/>

            <HBox spacing="15"
                  alignment="CENTER"
                  style="-fx-padding:10; -fx-background-color:#f5f5f5; -fx-border-color:#ddd;">

                <Label text="Car ID:"
                       style="-fx-font-weight:bold;"/>

                <TextField fx:id="carIdField"
                           prefWidth="200"
                           promptText="Enter Car ID"/>

                <Button text="🔍 Search"
                        onAction="#handleSearchCar"
                        style="-fx-background-color:#1976D2; -fx-text-fill:white;"/>

                <Button text="🔄 Clear"
                        onAction="#handleClear"
                        style="-fx-background-color:#F57C00; -fx-text-fill:white;"/>

            </HBox>

            <GridPane hgap="20"
                      vgap="12"
                      alignment="CENTER"
                      style="-fx-padding:15; -fx-background-color:#f3e5f5; -fx-border-color:#ce93d8;">

                <Label text="Vehicle Details"
                       GridPane.columnIndex="0"
                       GridPane.rowIndex="0"
                       GridPane.columnSpan="4"
                       style="-fx-font-size:16px; -fx-font-weight:bold;"/>

                <Label text="Car ID:"
                       GridPane.columnIndex="0"
                       GridPane.rowIndex="1"
                       style="-fx-font-weight:bold;"/>

                <Label fx:id="carIdDisplay"
                       text="N/A"
                       GridPane.columnIndex="1"
                       GridPane.rowIndex="1"/>

                <Label text="Model:"
                       GridPane.columnIndex="2"
                       GridPane.rowIndex="1"
                       style="-fx-font-weight:bold;"/>

                <Label fx:id="modelDisplay"
                       text="N/A"
                       GridPane.columnIndex="3"
                       GridPane.rowIndex="1"/>

                <Label text="VIN:"
                       GridPane.columnIndex="0"
                       GridPane.rowIndex="2"
                       style="-fx-font-weight:bold;"/>

                <Label fx:id="vinDisplay"
                       text="N/A"
                       GridPane.columnIndex="1"
                       GridPane.rowIndex="2"/>

                <Label text="Production Date:"
                       GridPane.columnIndex="2"
                       GridPane.rowIndex="2"
                       style="-fx-font-weight:bold;"/>

                <Label fx:id="productionDateDisplay"
                       text="N/A"
                       GridPane.columnIndex="3"
                       GridPane.rowIndex="2"/>

            </GridPane>

            <Label text="Quality Inspection Checklist"
                   style="-fx-font-size:16px; -fx-font-weight:bold;"/>

            <GridPane hgap="20"
                      vgap="10"
                      alignment="CENTER">

                <Label text="Engine:"
                       GridPane.columnIndex="0"
                       GridPane.rowIndex="0"
                       style="-fx-font-weight:bold;"/>

                <ComboBox fx:id="engineCombo"
                          prefWidth="200"
                          promptText="Select Status"
                          GridPane.columnIndex="1"
                          GridPane.rowIndex="0"/>

                <Label text="Body:"
                       GridPane.columnIndex="2"
                       GridPane.rowIndex="0"
                       style="-fx-font-weight:bold;"/>

                <ComboBox fx:id="bodyCombo"
                          prefWidth="200"
                          promptText="Select Status"
                          GridPane.columnIndex="3"
                          GridPane.rowIndex="0"/>

                <Label text="Paint:"
                       GridPane.columnIndex="0"
                       GridPane.rowIndex="1"
                       style="-fx-font-weight:bold;"/>

                <ComboBox fx:id="paintCombo"
                          prefWidth="200"
                          promptText="Select Status"
                          GridPane.columnIndex="1"
                          GridPane.rowIndex="1"/>

                <Label text="Brakes:"
                       GridPane.columnIndex="2"
                       GridPane.rowIndex="1"
                       style="-fx-font-weight:bold;"/>

                <ComboBox fx:id="brakesCombo"
                          prefWidth="200"
                          promptText="Select Status"
                          GridPane.columnIndex="3"
                          GridPane.rowIndex="1"/>

                <Label text="Safety Features:"
                       GridPane.columnIndex="0"
                       GridPane.rowIndex="2"
                       style="-fx-font-weight:bold;"/>

                <ComboBox fx:id="safetyCombo"
                          prefWidth="200"
                          promptText="Select Status"
                          GridPane.columnIndex="1"
                          GridPane.rowIndex="2"/>

                <Label text="Electrical:"
                       GridPane.columnIndex="2"
                       GridPane.rowIndex="2"
                       style="-fx-font-weight:bold;"/>

                <ComboBox fx:id="electricalCombo"
                          prefWidth="200"
                          promptText="Select Status"
                          GridPane.columnIndex="3"
                          GridPane.rowIndex="2"/>

            </GridPane>

            <Label text="Overall Quality Status:"
                   style="-fx-font-weight:bold;"/>

            <HBox spacing="20"
                  alignment="CENTER">
                <RadioButton fx:id="passRadio"
                             text="✓ Pass"
                             selected="true">
                    <toggleGroup>
                        <ToggleGroup fx:id="qualityStatusGroup"/>
                    </toggleGroup>
                </RadioButton>
                <RadioButton fx:id="failRadio"
                             text="✗ Fail"
                             toggleGroup="$qualityStatusGroup"/>
                <RadioButton fx:id="conditionalRadio"
                             text="⚠ Conditional Pass"
                             toggleGroup="$qualityStatusGroup"/>
            </HBox>

            <Label text="Inspection Notes:"
                   style="-fx-font-weight:bold;"/>

            <TextArea fx:id="notesArea"
                      prefWidth="800"
                      prefHeight="60"
                      promptText="Enter any inspection notes or comments..."/>

            <HBox spacing="20"
                  alignment="CENTER">
                <Button text="✅ Submit Quality Report"
                        onAction="#handleSubmitQualityReport"
                        prefWidth="250"
                        prefHeight="50"
                        style="-fx-background-color:#388E3C; -fx-text-fill:white; -fx-font-size:14px; -fx-font-weight:bold;"/>

                <Button text="🔄 Reset"
                        onAction="#handleReset"
                        prefWidth="150"
                        prefHeight="50"
                        style="-fx-background-color:#F57C00; -fx-text-fill:white; -fx-font-size:14px;"/>
            </HBox>

            <Label fx:id="statusLabel"
                   style="-fx-font-size:14px; -fx-font-weight:bold;"
                   text="Enter Car ID to begin quality inspection"/>

        </VBox>
    </center>

</BorderPane>