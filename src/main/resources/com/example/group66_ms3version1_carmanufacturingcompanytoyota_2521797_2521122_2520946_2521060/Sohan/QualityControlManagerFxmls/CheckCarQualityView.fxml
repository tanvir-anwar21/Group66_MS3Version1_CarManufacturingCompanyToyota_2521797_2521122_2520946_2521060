<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="Sohan.QualityControlManagerControllers.CheckCarQualityView_Controller"
            prefWidth="1000" prefHeight="650">

    <top>
        <HBox alignment="CENTER_LEFT" spacing="15" style="-fx-padding: 15 20; -fx-background-color: #2c3e50;">
            <Button text="← Back to Dashboard" onAction="#handleBack" style="-fx-background-color: #34495e; -fx-text-fill: white;"/>
            <Label text="🚗 Check Car Quality" style="-fx-text-fill: white; -fx-font-size: 20px; -fx-font-weight: bold;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="userLabel" text="QC Manager: " style="-fx-text-fill: #bdc3c7;"/>
        </HBox>
    </top>

    <center>
        <VBox spacing="15" style="-fx-padding: 20;">

            <GridPane hgap="15" vgap="10" style="-fx-padding: 15; -fx-background-color: #ecf0f1; -fx-border-color: #bdc3c7; -fx-border-radius: 5;">
                <Label text="Enter Car ID:" GridPane.columnIndex="0" GridPane.rowIndex="0" style="-fx-font-weight: bold;"/>
                <TextField fx:id="carIdField" GridPane.columnIndex="1" GridPane.rowIndex="0" promptText="e.g., CAR-2026-0045" prefWidth="200"/>
                <Button text="🔍 Search" onAction="#handleSearch" GridPane.columnIndex="2" GridPane.rowIndex="0" style="-fx-background-color: #3498db; -fx-text-fill: white;"/>

                <Label text="OR" GridPane.columnIndex="3" GridPane.rowIndex="0" style="-fx-font-weight: bold; -fx-text-fill: #7f8c8d;"/>

                <Label text="Select from List:" GridPane.columnIndex="4" GridPane.rowIndex="0" style="-fx-font-weight: bold;"/>
                <ComboBox fx:id="vehicleListCombo" GridPane.columnIndex="5" GridPane.rowIndex="0" prefWidth="200">
                </ComboBox>
                <Button text="Load" onAction="#handleLoadFromList" GridPane.columnIndex="6" GridPane.rowIndex="0" style="-fx-background-color: #2ecc71; -fx-text-fill: white;"/>
            </GridPane>

            <TitledPane text="Vehicle Information" expanded="true">
                <GridPane hgap="15" vgap="10" style="-fx-padding: 15;">
                    <Label text="Vehicle ID:" GridPane.columnIndex="0" GridPane.rowIndex="0" style="-fx-font-weight: bold;"/>
                    <Label fx:id="vehicleIdDisplay" text="CAR-2026-0045" GridPane.columnIndex="1" GridPane.rowIndex="0"/>

                    <Label text="Model:" GridPane.columnIndex="0" GridPane.rowIndex="1" style="-fx-font-weight: bold;"/>
                    <Label fx:id="modelDisplay" text="Camry 2026" GridPane.columnIndex="1" GridPane.rowIndex="1"/>

                    <Label text="VIN:" GridPane.columnIndex="0" GridPane.rowIndex="2" style="-fx-font-weight: bold;"/>
                    <Label fx:id="vinDisplay" text="4T1BF1FK9HU123456" GridPane.columnIndex="1" GridPane.rowIndex="2"/>

                    <Label text="Production Date:" GridPane.columnIndex="0" GridPane.rowIndex="3" style="-fx-font-weight: bold;"/>
                    <Label fx:id="productionDateDisplay" text="2026-08-01" GridPane.columnIndex="1" GridPane.rowIndex="3"/>

                    <Label text="Production Line:" GridPane.columnIndex="2" GridPane.rowIndex="0" style="-fx-font-weight: bold;"/>
                    <Label fx:id="lineDisplay" text="Line A-3" GridPane.columnIndex="3" GridPane.rowIndex="0"/>

                    <Label text="Current Status:" GridPane.columnIndex="2" GridPane.rowIndex="1" style="-fx-font-weight: bold;"/>
                    <Label fx:id="statusDisplay" text="Pending Inspection" GridPane.columnIndex="3" GridPane.rowIndex="1" style="-fx-text-fill: #f39c12;"/>
                </GridPane>
            </TitledPane>

            <TitledPane text="Inspection Criteria" expanded="true">
                <VBox spacing="10" style="-fx-padding: 15;">
                    <Label text="Select inspection parameters to check:" style="-fx-font-weight: bold;"/>

                    <CheckBox fx:id="engineCheck" text="Engine Performance" selected="true"/>
                    <CheckBox fx:id="bodyCheck" text="Body Condition (paint, dents)" selected="true"/>
                    <CheckBox fx:id="brakeCheck" text="Brake System" selected="true"/>
                    <CheckBox fx:id="safetyCheck" text="Safety Features (airbags, seatbelts)" selected="true"/>
                    <CheckBox fx:id="electricalCheck" text="Electrical System" selected="true"/>
                    <CheckBox fx:id="interiorCheck" text="Interior Quality" selected="true"/>
                    <CheckBox fx:id="exteriorCheck" text="Exterior Quality" selected="true"/>
                </VBox>
            </TitledPane>

            <TitledPane text="Inspection Result" expanded="true">
                <GridPane hgap="15" vgap="10" style="-fx-padding: 15;">
                    <Label text="Overall Status:" GridPane.columnIndex="0" GridPane.rowIndex="0" style="-fx-font-weight: bold;"/>
                    <RadioButton fx:id="passRadio" text="✅ Pass" GridPane.columnIndex="1" GridPane.rowIndex="0">
                        <toggleGroup><ToggleGroup fx:id="resultGroup"/></toggleGroup>
                    </RadioButton>
                    <RadioButton fx:id="failRadio" text="❌ Fail" GridPane.columnIndex="2" GridPane.rowIndex="0">
                        <toggleGroup><ToggleGroup fx:id="resultGroup"/></toggleGroup>
                    </RadioButton>
                    <RadioButton fx:id="pendingRadio" text="⏳ Pending Review" GridPane.columnIndex="3" GridPane.rowIndex="0">
                        <toggleGroup><ToggleGroup fx:id="resultGroup"/></toggleGroup>
                    </RadioButton>

                    <Label text="Comments:" GridPane.columnIndex="0" GridPane.rowIndex="1" style="-fx-font-weight: bold;"/>
                    <TextField fx:id="commentsField" GridPane.columnIndex="1" GridPane.rowIndex="1" GridPane.columnSpan="3" promptText="Enter inspection comments..." prefWidth="400"/>

                    <Label text="Inspector Name:" GridPane.columnIndex="0" GridPane.rowIndex="2" style="-fx-font-weight: bold;"/>
                    <TextField fx:id="inspectorNameField" GridPane.columnIndex="1" GridPane.rowIndex="2" promptText="Enter inspector name"/>
                </GridPane>
            </TitledPane>

            <HBox spacing="15" alignment="CENTER">
                <Button text="✅ Submit Inspection" onAction="#handleSubmit" style="-fx-background-color: #2ecc71; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 10 30;"/>
                <Button text="❌ Reset" onAction="#handleReset" style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-padding: 10 30;"/>
                <Button text="📋 View History" onAction="#handleViewHistory" style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-padding: 10 30;"/>
            </HBox>

            <Label fx:id="statusMessage" text="" style="-fx-text-fill: #2c3e50; -fx-font-weight: bold;"/>
        </VBox>
    </center>
</BorderPane>