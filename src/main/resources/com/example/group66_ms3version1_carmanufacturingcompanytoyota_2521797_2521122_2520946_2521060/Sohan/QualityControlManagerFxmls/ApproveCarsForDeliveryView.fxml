<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.control.cell.PropertyValueFactory?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="Sohan.QualityControlManagerControllers.ApproveCarsForDeliveryView_Controller"
            prefWidth="1000"
            prefHeight="650">

    <top>
        <HBox alignment="CENTER_LEFT"
              spacing="15"
              style="-fx-padding:15 20; -fx-background-color:#4A148C;">

            <Label text="✅ Approve Cars for Delivery"
                   style="-fx-text-fill:white; -fx-font-size:22px; -fx-font-weight:bold;"/>

            <Region HBox.hgrow="ALWAYS"/>

            <Button text="⬅ Back to Dashboard"
                    onAction="#handleBackToDashboard"
                    style="-fx-background-color:#e74c3c; -fx-text-fill:white;"/>

        </HBox>
    </top>

    <center>
        <VBox alignment="TOP_CENTER"
              spacing="15"
              style="-fx-padding:20;">

            <Label text="Vehicle Delivery Approval"
                   style="-fx-font-size:24px; -fx-font-weight:bold;"/>

            <HBox spacing="15"
                  alignment="CENTER_LEFT"
                  style="-fx-padding:10; -fx-background-color:#f5f5f5; -fx-border-color:#ddd;">

                <Label text="Batch ID:"
                       style="-fx-font-weight:bold;"/>

                <TextField fx:id="batchIdField"
                           prefWidth="150"
                           promptText="Enter Batch ID"/>

                <Label text="Model:"
                       style="-fx-font-weight:bold;"/>

                <ComboBox fx:id="modelFilterCombo"
                          prefWidth="150"
                          promptText="All Models"/>

                <Button text="🔍 Search"
                        onAction="#handleSearch"
                        style="-fx-background-color:#1976D2; -fx-text-fill:white;"/>

                <Separator orientation="VERTICAL"
                           prefHeight="30"/>

                <RadioButton fx:id="pendingApprovalRadio"
                             text="Pending Approval"
                             selected="true">
                    <toggleGroup>
                        <ToggleGroup fx:id="approvalFilterGroup"/>
                    </toggleGroup>
                </RadioButton>
                <RadioButton fx:id="approvedRadio"
                             text="Approved"
                             toggleGroup="$approvalFilterGroup"/>
                <RadioButton fx:id="allVehiclesRadio"
                             text="All"
                             toggleGroup="$approvalFilterGroup"/>

            </HBox>

            <TableView fx:id="vehicleTableView"
                       prefHeight="300"
                       prefWidth="960">

                <columns>
                    <TableColumn text="Vehicle ID"
                                 prefWidth="120">
                        <cellValueFactory>
                            <PropertyValueFactory property="vehicleID"/>
                        </cellValueFactory>
                    </TableColumn>
                    <TableColumn text="Model"
                                 prefWidth="140">
                        <cellValueFactory>
                            <PropertyValueFactory property="model"/>
                        </cellValueFactory>
                    </TableColumn>
                    <TableColumn text="VIN"
                                 prefWidth="160">
                        <cellValueFactory>
                            <PropertyValueFactory property="vin"/>
                        </cellValueFactory>
                    </TableColumn>
                    <TableColumn text="Batch ID"
                                 prefWidth="120">
                        <cellValueFactory>
                            <PropertyValueFactory property="batchID"/>
                        </cellValueFactory>
                    </TableColumn>
                    <TableColumn text="Quality Status"
                                 prefWidth="130">
                        <cellValueFactory>
                            <PropertyValueFactory property="qualityStatus"/>
                        </cellValueFactory>
                    </TableColumn>
                    <TableColumn text="Approval Status"
                                 prefWidth="130">
                        <cellValueFactory>
                            <PropertyValueFactory property="approvalStatus"/>
                        </cellValueFactory>
                    </TableColumn>
                    <TableColumn text="Inspection Date"
                                 prefWidth="160">
                        <cellValueFactory>
                            <PropertyValueFactory property="inspectionDate"/>
                        </cellValueFactory>
                    </TableColumn>
                </columns>

            </TableView>

            <GridPane hgap="15"
                      vgap="10"
                      style="-fx-padding:10; -fx-background-color:#f3e5f5; -fx-border-color:#ce93d8;">

                <Label text="Approval Action"
                       GridPane.columnIndex="0"
                       GridPane.rowIndex="0"
                       style="-fx-font-size:14px; -fx-font-weight:bold;"/>

                <Label text="Selected Vehicle:"
                       GridPane.columnIndex="0"
                       GridPane.rowIndex="1"
                       style="-fx-font-weight:bold;"/>

                <Label fx:id="selectedVehicleLabel"
                       text="No vehicle selected"
                       GridPane.columnIndex="1"
                       GridPane.rowIndex="1"/>

                <Label text="Approval Status:"
                       GridPane.columnIndex="0"
                       GridPane.rowIndex="2"
                       style="-fx-font-weight:bold;"/>

                <HBox spacing="15"
                      GridPane.columnIndex="1"
                      GridPane.rowIndex="2">
                    <RadioButton fx:id="approveRadio"
                                 text="✓ Approve"
                                 selected="true">
                        <toggleGroup>
                            <ToggleGroup fx:id="approvalActionGroup"/>
                        </toggleGroup>
                    </RadioButton>
                    <RadioButton fx:id="rejectRadio"
                                 text="✗ Reject"
                                 toggleGroup="$approvalActionGroup"/>
                    <RadioButton fx:id="holdRadio"
                                 text="⏸ Hold"
                                 toggleGroup="$approvalActionGroup"/>
                </HBox>

                <Label text="Comments:"
                       GridPane.columnIndex="0"
                       GridPane.rowIndex="3"
                       style="-fx-font-weight:bold;"/>

                <TextArea fx:id="commentsArea"
                          prefWidth="600"
                          prefHeight="50"
                          promptText="Enter approval comments..."
                          GridPane.columnIndex="1"
                          GridPane.rowIndex="3"/>

                <Button text="✅ Submit Approval"
                        onAction="#handleSubmitApproval"
                        prefWidth="200"
                        prefHeight="40"
                        style="-fx-background-color:#388E3C; -fx-text-fill:white; -fx-font-weight:bold;"
                        GridPane.columnIndex="1"
                        GridPane.rowIndex="4"/>

            </GridPane>

            <HBox spacing="15"
                  alignment="CENTER_LEFT"
                  style="-fx-padding:5 10;">

                <Label fx:id="recordCountLabel"
                       text="Total Vehicles: 0"/>

                <Region HBox.hgrow="ALWAYS"/>

                <Label fx:id="statusLabel"
                       text="Ready"/>

            </HBox>

        </VBox>
    </center>

</BorderPane>