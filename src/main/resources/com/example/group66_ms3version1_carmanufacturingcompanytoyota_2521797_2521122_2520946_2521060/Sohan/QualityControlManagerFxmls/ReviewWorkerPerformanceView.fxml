<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.control.cell.PropertyValueFactory?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="Sohan.QualityControlManagerControllers.ReviewWorkerPerformanceView_Controller"
            prefWidth="1000"
            prefHeight="700">

    <top>
        <HBox alignment="CENTER_LEFT"
              spacing="15"
              style="-fx-padding:15 20; -fx-background-color:#4A148C;">

            <Label text="👷 Review Worker Performance"
                   style="-fx-text-fill:white; -fx-font-size:22px; -fx-font-weight:bold;"/>

            <Region HBox.hgrow="ALWAYS"/>

            <Button text="⬅ Back to Dashboard"
                    onAction="#handleBackToDashboard"
                    style="-fx-background-color:#e74c3c; -fx-text-fill:white;"/>

        </HBox>
    </top>

    <center>
        <VBox alignment="TOP_CENTER"
              spacing="15"
              style="-fx-padding:20;">

            <Label text="Worker Performance Review"
                   style="-fx-font-size:24px; -fx-font-weight:bold;"/>

            <HBox spacing="15"
                  alignment="CENTER_LEFT"
                  style="-fx-padding:10; -fx-background-color:#f5f5f5; -fx-border-color:#ddd;">

                <Label text="Worker ID:"
                       style="-fx-font-weight:bold;"/>

                <TextField fx:id="workerIdField"
                           prefWidth="150"
                           promptText="Enter Worker ID"/>

                <Label text="Name:"
                       style="-fx-font-weight:bold;"/>

                <TextField fx:id="workerNameField"
                           prefWidth="200"
                           promptText="Enter Worker Name"/>

                <Button text="🔍 Search"
                        onAction="#handleSearch"
                        style="-fx-background-color:#1976D2; -fx-text-fill:white;"/>

                <Button text="📋 View All"
                        onAction="#handleViewAll"
                        style="-fx-background-color:#F57C00; -fx-text-fill:white;"/>

                <Separator orientation="VERTICAL"
                           prefHeight="30"/>

                <RadioButton fx:id="allWorkersRadio"
                             text="All Workers"
                             selected="true">
                    <toggleGroup>
                        <ToggleGroup fx:id="workerFilterGroup"/>
                    </toggleGroup>
                </RadioButton>
                <RadioButton fx:id="topPerformersRadio"
                             text="Top Performers"
                             toggleGroup="$workerFilterGroup"/>
                <RadioButton fx:id="needsImprovementRadio"
                             text="Needs Improvement"
                             toggleGroup="$workerFilterGroup"/>

            </HBox>

            <!-- Performance Table -->
            <TableView fx:id="performanceTableView"
                       prefHeight="300"
                       prefWidth="960">

                <columns>
                    <TableColumn text="Worker ID"
                                 prefWidth="100">
                        <cellValueFactory>
                            <PropertyValueFactory property="workerID"/>
                        </cellValueFactory>
                    </TableColumn>
                    <TableColumn text="Name"
                                 prefWidth="150">
                        <cellValueFactory>
                            <PropertyValueFactory property="name"/>
                        </cellValueFactory>
                    </TableColumn>
                    <TableColumn text="Department"
                                 prefWidth="130">
                        <cellValueFactory>
                            <PropertyValueFactory property="department"/>
                        </cellValueFactory>
                    </TableColumn>
                    <TableColumn text="Position"
                                 prefWidth="130">
                        <cellValueFactory>
                            <PropertyValueFactory property="position"/>
                        </cellValueFactory>
                    </TableColumn>
                    <TableColumn text="Quality Score"
                                 prefWidth="120">
                        <cellValueFactory>
                            <PropertyValueFactory property="qualityScore"/>
                        </cellValueFactory>
                    </TableColumn>
                    <TableColumn text="Products Checked"
                                 prefWidth="130">
                        <cellValueFactory>
                            <PropertyValueFactory property="productsChecked"/>
                        </cellValueFactory>
                    </TableColumn>
                    <TableColumn text="Defects Found"
                                 prefWidth="120">
                        <cellValueFactory>
                            <PropertyValueFactory property="defectsFound"/>
                        </cellValueFactory>
                    </TableColumn>
                    <TableColumn text="Performance"
                                 prefWidth="120">
                        <cellValueFactory>
                            <PropertyValueFactory property="performance"/>
                        </cellValueFactory>
                    </TableColumn>
                </columns>

            </TableView>

            <!-- Worker Details Section -->
            <GridPane hgap="15"
                      vgap="10"
                      style="-fx-padding:10; -fx-background-color:#f3e5f5; -fx-border-color:#ce93d8;">

                <Label text="Selected Worker Details:"
                       GridPane.columnIndex="0"
                       GridPane.rowIndex="0"
                       style="-fx-font-weight:bold;"/>

                <Label fx:id="selectedWorkerLabel"
                       text="No worker selected"
                       GridPane.columnIndex="0"
                       GridPane.rowIndex="1"
                       GridPane.columnSpan="3"/>

                <Label text="Performance Rating:"
                       GridPane.columnIndex="0"
                       GridPane.rowIndex="2"
                       style="-fx-font-weight:bold;"/>

                <Label fx:id="performanceRatingLabel"
                       text="N/A"
                       GridPane.columnIndex="1"
                       GridPane.rowIndex="2"
                       style="-fx-font-weight:bold;"/>

                <Button text="📊 View Full Report"
                        onAction="#handleViewFullReport"
                        GridPane.columnIndex="3"
                        GridPane.rowIndex="1"
                        style="-fx-background-color:#1976D2; -fx-text-fill:white;"/>

                <Button text="🖨️ Print Report"
                        onAction="#handlePrintReport"
                        GridPane.columnIndex="3"
                        GridPane.rowIndex="2"
                        style="-fx-background-color:#388E3C; -fx-text-fill:white;"/>

                <Button text="📝 Add Feedback"
                        onAction="#handleAddFeedback"
                        GridPane.columnIndex="3"
                        GridPane.rowIndex="3"
                        style="-fx-background-color:#FF9800; -fx-text-fill:white;"/>

            </GridPane>

            <!-- Feedback Section -->
            <GridPane hgap="15"
                      vgap="10"
                      style="-fx-padding:10; -fx-background-color:#fff3e0; -fx-border-color:#ffb74d;">

                <Label text="Performance Feedback"
                       GridPane.columnIndex="0"
                       GridPane.rowIndex="0"
                       style="-fx-font-weight:bold;"/>

                <TextArea fx:id="feedbackArea"
                          prefWidth="800"
                          prefHeight="50"
                          promptText="Enter performance feedback comments..."
                          GridPane.columnIndex="0"
                          GridPane.rowIndex="1"
                          GridPane.columnSpan="2"/>

                <Button text="💾 Save Feedback"
                        onAction="#handleSaveFeedback"
                        prefWidth="150"
                        prefHeight="35"
                        GridPane.columnIndex="2"
                        GridPane.rowIndex="1"
                        style="-fx-background-color:#388E3C; -fx-text-fill:white;"/>

            </GridPane>

            <HBox spacing="15"
                  alignment="CENTER_LEFT"
                  style="-fx-padding:5 10;">

                <Label fx:id="recordCountLabel"
                       text="Total Workers: 0"/>

                <Region HBox.hgrow="ALWAYS"/>

                <Label fx:id="statusLabel"
                       text="Ready"/>

            </HBox>

        </VBox>
    </center>

</BorderPane>