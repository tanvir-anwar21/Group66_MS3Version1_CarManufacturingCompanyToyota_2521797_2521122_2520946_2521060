<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="Sohan.QualityControlManagerControllers.PrintQualityReportView_Controller"
            prefWidth="1000" prefHeight="650">

    <top>
        <HBox alignment="CENTER_LEFT" spacing="15" style="-fx-padding: 15 20; -fx-background-color: #2c3e50;">
            <Button text="← Back to Dashboard" onAction="#handleBack" style="-fx-background-color: #34495e; -fx-text-fill: white;"/>
            <Label text="🖨️ Print Quality Report" style="-fx-text-fill: white; -fx-font-size: 20px; -fx-font-weight: bold;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="userLabel" text="QC Manager: " style="-fx-text-fill: #bdc3c7;"/>
        </HBox>
    </top>

    <center>
        <VBox spacing="15" style="-fx-padding: 20;">

            <GridPane hgap="15" vgap="10" style="-fx-padding: 20; -fx-background-color: #ecf0f1; -fx-border-color: #bdc3c7; -fx-border-radius: 5;">
                <Label text="Report Type:" GridPane.columnIndex="0" GridPane.rowIndex="0" style="-fx-font-weight: bold;"/>
                <ComboBox fx:id="reportTypeCombo" GridPane.columnIndex="1" GridPane.rowIndex="0" promptText="Select report type" prefWidth="250">
                </ComboBox>

                <Label text="Date Range:" GridPane.columnIndex="0" GridPane.rowIndex="1" style="-fx-font-weight: bold;"/>
                <DatePicker fx:id="startDatePicker" GridPane.columnIndex="1" GridPane.rowIndex="1" promptText="Start Date"/>
                <Label text="to" GridPane.columnIndex="2" GridPane.rowIndex="1"/>
                <DatePicker fx:id="endDatePicker" GridPane.columnIndex="3" GridPane.rowIndex="1" promptText="End Date"/>

                <Label text="Format:" GridPane.columnIndex="0" GridPane.rowIndex="2" style="-fx-font-weight: bold;"/>
                <RadioButton fx:id="pdfRadio" text="PDF" GridPane.columnIndex="1" GridPane.rowIndex="2" selected="true">
                    <toggleGroup><ToggleGroup fx:id="formatGroup"/></toggleGroup>
                </RadioButton>
                <RadioButton fx:id="excelRadio" text="Excel" GridPane.columnIndex="2" GridPane.rowIndex="2">
                    <toggleGroup><ToggleGroup fx:id="formatGroup"/></toggleGroup>
                </RadioButton>
                <RadioButton fx:id="htmlRadio" text="HTML" GridPane.columnIndex="3" GridPane.rowIndex="2">
                    <toggleGroup><ToggleGroup fx:id="formatGroup"/></toggleGroup>
                </RadioButton>

                <Label text="Include:" GridPane.columnIndex="0" GridPane.rowIndex="3" style="-fx-font-weight: bold;"/>
                <CheckBox fx:id="includeChartsCheck" text="Charts" GridPane.columnIndex="1" GridPane.rowIndex="3" selected="true"/>
                <CheckBox fx:id="includeDetailsCheck" text="Detailed Records" GridPane.columnIndex="2" GridPane.rowIndex="3" selected="true"/>
                <CheckBox fx:id="includeSummaryCheck" text="Executive Summary" GridPane.columnIndex="3" GridPane.rowIndex="3" selected="true"/>

                <Label text="Export Options:" GridPane.columnIndex="0" GridPane.rowIndex="4" style="-fx-font-weight: bold;"/>
                <CheckBox fx:id="sendEmailCheck" text="Send via Email" GridPane.columnIndex="1" GridPane.rowIndex="4"/>
                <TextField fx:id="emailField" GridPane.columnIndex="2" GridPane.rowIndex="4" GridPane.columnSpan="2" promptText="email@example.com" prefWidth="250"/>
            </GridPane>

            <TitledPane text="Report Preview" expanded="true">
                <VBox spacing="10" style="-fx-padding: 15;">
                    <Label fx:id="reportTitleLabel" text="[Report Title]" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
                    <Label fx:id="reportMetaLabel" text="[Date Range | Generated By: QC Manager]" style="-fx-text-fill: #7f8c8d;"/>

                    <GridPane hgap="20" vgap="5" style="-fx-padding: 10; -fx-background-color: #f8f9fa;">
                        <Label text="Total Records:" GridPane.columnIndex="0" GridPane.rowIndex="0" style="-fx-font-weight: bold;"/>
                        <Label fx:id="totalRecordsLabel" text="0" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
                        <Label text="Pass Rate:" GridPane.columnIndex="2" GridPane.rowIndex="0" style="-fx-font-weight: bold;"/>
                        <Label fx:id="previewPassRateLabel" text="0%" GridPane.columnIndex="3" GridPane.rowIndex="0"/>
                        <Label text="Defects Found:" GridPane.columnIndex="4" GridPane.rowIndex="0" style="-fx-font-weight: bold;"/>
                        <Label fx:id="previewDefectsLabel" text="0" GridPane.columnIndex="5" GridPane.rowIndex="0"/>
                    </GridPane>

                    <TableView fx:id="reportPreviewTable" style="-fx-pref-height: 150;">
                    </TableView>
                </VBox>
            </TitledPane>

            <HBox spacing="15" alignment="CENTER">
                <Button text="🖨️ Print Report" onAction="#handlePrint" style="-fx-background-color: #2ecc71; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 10 30;"/>
                <Button text="📄 Preview" onAction="#handlePreview" style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-padding: 10 30;"/>
                <Button text="📥 Download" onAction="#handleDownload" style="-fx-background-color: #9b59b6; -fx-text-fill: white; -fx-padding: 10 30;"/>
                <Button text="✉️ Send Email" onAction="#handleSendEmail" style="-fx-background-color: #1abc9c; -fx-text-fill: white; -fx-padding: 10 30;"/>
                <Button text="❌ Reset" onAction="#handleReset" style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-padding: 10 30;"/>
            </HBox>

            <Label fx:id="statusMessage" text="" style="-fx-text-fill: #2c3e50; -fx-font-weight: bold;"/>
        </VBox>
    </center>
</BorderPane>