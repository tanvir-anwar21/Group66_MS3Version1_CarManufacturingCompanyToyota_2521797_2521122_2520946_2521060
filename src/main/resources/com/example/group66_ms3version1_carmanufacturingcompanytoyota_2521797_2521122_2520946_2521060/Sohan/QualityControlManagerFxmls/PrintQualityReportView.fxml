<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="Sohan.QualityControlManagerControllers.PrintQualityReportView_Controller"
            prefWidth="900"
            prefHeight="600">

    <top>
        <HBox alignment="CENTER_LEFT"
              spacing="15"
              style="-fx-padding:15 20; -fx-background-color:#4A148C;">

            <Label text="🖨️ Print Quality Report"
                   style="-fx-text-fill:white; -fx-font-size:22px; -fx-font-weight:bold;"/>

            <Region HBox.hgrow="ALWAYS"/>

            <Button text="⬅ Back to Dashboard"
                    onAction="#handleBackToDashboard"
                    style="-fx-background-color:#e74c3c; -fx-text-fill:white;"/>

        </HBox>
    </top>

    <center>
        <VBox alignment="TOP_CENTER"
              spacing="20"
              style="-fx-padding:30;">

            <Label text="Print Quality Control Report"
                   style="-fx-font-size:24px; -fx-font-weight:bold;"/>

            <GridPane hgap="20"
                      vgap="15"
                      alignment="CENTER">

                <Label text="Report Type: *"
                       GridPane.columnIndex="0"
                       GridPane.rowIndex="0"
                       style="-fx-font-weight:bold;"/>

                <ComboBox fx:id="reportTypeCombo"
                          prefWidth="300"
                          promptText="Select Report Type"
                          GridPane.columnIndex="1"
                          GridPane.rowIndex="0"/>

                <Label text="Date Range:"
                       GridPane.columnIndex="0"
                       GridPane.rowIndex="1"
                       style="-fx-font-weight:bold;"/>

                <HBox spacing="10"
                      GridPane.columnIndex="1"
                      GridPane.rowIndex="1">
                    <DatePicker fx:id="startDatePicker"
                                prefWidth="140"
                                promptText="Start Date"/>
                    <Label text="to"/>
                    <DatePicker fx:id="endDatePicker"
                                prefWidth="140"
                                promptText="End Date"/>
                </HBox>

                <Label text="Vehicle Model:"
                       GridPane.columnIndex="0"
                       GridPane.rowIndex="2"
                       style="-fx-font-weight:bold;"/>

                <ComboBox fx:id="modelCombo"
                          prefWidth="300"
                          promptText="All Models"
                          GridPane.columnIndex="1"
                          GridPane.rowIndex="2"/>

                <Label text="Production Line:"
                       GridPane.columnIndex="0"
                       GridPane.rowIndex="3"
                       style="-fx-font-weight:bold;"/>

                <ComboBox fx:id="lineCombo"
                          prefWidth="300"
                          promptText="All Lines"
                          GridPane.columnIndex="1"
                          GridPane.rowIndex="3"/>

                <Label text="Output Format:"
                       GridPane.columnIndex="0"
                       GridPane.rowIndex="4"
                       style="-fx-font-weight:bold;"/>

                <HBox spacing="15"
                      GridPane.columnIndex="1"
                      GridPane.rowIndex="4">
                    <RadioButton fx:id="pdfRadio"
                                 text="PDF"
                                 selected="true">
                        <toggleGroup>
                            <ToggleGroup fx:id="formatGroup"/>
                        </toggleGroup>
                    </RadioButton>
                    <RadioButton fx:id="excelRadio"
                                 text="Excel"
                                 toggleGroup="$formatGroup"/>
                    <RadioButton fx:id="htmlRadio"
                                 text="HTML"
                                 toggleGroup="$formatGroup"/>
                    <RadioButton fx:id="csvRadio"
                                 text="CSV"
                                 toggleGroup="$formatGroup"/>
                </HBox>

                <Label text="Options:"
                       GridPane.columnIndex="0"
                       GridPane.rowIndex="5"
                       style="-fx-font-weight:bold;"/>

                <HBox spacing="15"
                      GridPane.columnIndex="1"
                      GridPane.rowIndex="5">
                    <CheckBox fx:id="includeChartsCheckBox"
                              text="Include Charts"
                              selected="true"/>
                    <CheckBox fx:id="includeDetailsCheckBox"
                              text="Include Details"
                              selected="true"/>
                    <CheckBox fx:id="summaryOnlyCheckBox"
                              text="Summary Only"/>
                </HBox>

            </GridPane>

            <HBox spacing="20"
                  alignment="CENTER">
                <Button text="🖨️ Generate &amp; Print"
                        onAction="#handleGenerateAndPrint"
                        prefWidth="250"
                        prefHeight="50"
                        style="-fx-background-color:#388E3C; -fx-text-fill:white; -fx-font-size:14px; -fx-font-weight:bold;"/>

                <Button text="📄 Preview Report"
                        onAction="#handlePreviewReport"
                        prefWidth="200"
                        prefHeight="50"
                        style="-fx-background-color:#1976D2; -fx-text-fill:white; -fx-font-size:14px;"/>

                <Button text="🔄 Reset"
                        onAction="#handleReset"
                        prefWidth="150"
                        prefHeight="50"
                        style="-fx-background-color:#F57C00; -fx-text-fill:white; -fx-font-size:14px;"/>
            </HBox>

            <Label fx:id="statusLabel"
                   style="-fx-font-size:14px; -fx-font-weight:bold;"
                   text="Select report type and options to generate quality report"/>

        </VBox>
    </center>

</BorderPane>